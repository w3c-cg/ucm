@prefix : <https://www.w3.org/ns/ucm#shapes-example#> .
@prefix ex: <http://example.org/ucm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ucm: <https://www.w3.org/ns/ucm#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix ucm-shapes-example: <https://www.w3.org/ns/ucm#shapes-example> .
@base <https://www.w3.org/ns/ucm#shapes-example#> .

<https://www.w3.org/ns/ucm#shapes-example> rdf:type owl:Ontology ;
                                            owl:versionIRI <https://www.w3.org/ns/ucm#shapes-example/0.0.1> .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2006/time#hasBeginning
time:hasBeginning rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2006/time#hasEnd
time:hasEnd rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2006/time#inXSDDateTimeStamp
time:inXSDDateTimeStamp rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#acceptsRequest
ucm:acceptsRequest rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#affiliatedWith
ucm:affiliatedWith rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#assumesRole
ucm:assumesRole rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#definedByArtifact
ucm:definedByArtifact rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#definedByCriteria
ucm:definedByCriteria rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#enactiveDuring
ucm:enactiveDuring rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#generatedByProcess
ucm:generatedByProcess rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#hasActivityFocus
ucm:hasActivityFocus rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#hasCareTrajectoryContext
ucm:hasCareTrajectoryContext rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#hasClosureReason
ucm:hasClosureReason rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#hasCommitmentStatus
ucm:hasCommitmentStatus rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#hasHandoffStatus
ucm:hasHandoffStatus rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#hasHandshakeFulfillment
ucm:hasHandshakeFulfillment rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#hasLifecycleState
ucm:hasLifecycleState rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#hasMembership
ucm:hasMembership rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#hasParticipant
ucm:hasParticipant rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#hasPatient
ucm:hasPatient rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#hasReferralDisposition
ucm:hasReferralDisposition rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#hasResident
ucm:hasResident rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#madeWithinContext
ucm:madeWithinContext rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#membershipIn
ucm:membershipIn rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#negotiates
ucm:negotiates rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#occursDuring
ucm:occursDuring rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#occursWithin
ucm:occursWithin rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#participatingEntity
ucm:participatingEntity rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#participationContext
ucm:participationContext rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#scopedBy
ucm:scopedBy rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#statementDate
ucm:statementDate rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#statementSubject
ucm:statementSubject rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#validFrom
ucm:validFrom rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#validTo
ucm:validTo rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2006/time#Instant
time:Instant rdf:type owl:Class .


###  http://www.w3.org/2006/time#ProperInterval
time:ProperInterval rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#ActivityFocus
ucm:ActivityFocus rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#CareCommitment
ucm:CareCommitment rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#CareTrajectoryContext
ucm:CareTrajectoryContext rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#ClinicalCareContext
ucm:ClinicalCareContext rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#ClinicalEncounter
ucm:ClinicalEncounter rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#CoordinationRequest
ucm:CoordinationRequest rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#CoordinatorRole
ucm:CoordinatorRole rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#EligibilityRuleset
ucm:EligibilityRuleset rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#Handshake
ucm:Handshake rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#Household
ucm:Household rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#HousingAssessment
ucm:HousingAssessment rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#HousingContext
ucm:HousingContext rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#HousingEligibilityContext
ucm:HousingEligibilityContext rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#HousingEligibilityStatement
ucm:HousingEligibilityStatement rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#MatchClaim
ucm:MatchClaim rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#Membership
ucm:Membership rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#MembershipCriteria
ucm:MembershipCriteria rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#Organization
ucm:Organization rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#Participation
ucm:Participation rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#PatientRole
ucm:PatientRole rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#Person
ucm:Person rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#ProgramDefinition
ucm:ProgramDefinition rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#ProviderRole
ucm:ProviderRole rdf:type owl:Class .


###  https://www.w3.org/ns/ucm#ResidentRole
ucm:ResidentRole rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/ucm/assess-1
ex:assess-1 rdf:type owl:NamedIndividual ,
                     ucm:HousingAssessment ;
            ucm:hasParticipant ex:p-res ;
            ucm:hasResident ex:person-a ;
            ucm:occursDuring ex:t-assess .


###  http://example.org/ucm/cm-1
ex:cm-1 rdf:type owl:NamedIndividual ,
                 ucm:Person ;
        ucm:affiliatedWith ex:org-ecm .


###  http://example.org/ucm/commit-1
ex:commit-1 rdf:type owl:NamedIndividual ,
                     ucm:CareCommitment ;
            ucm:hasCommitmentStatus ucm:CommitmentInForce .


###  http://example.org/ucm/ctx-clin
ex:ctx-clin rdf:type owl:NamedIndividual ,
                     ucm:ClinicalCareContext .


###  http://example.org/ucm/ctx-elig
ex:ctx-elig rdf:type owl:NamedIndividual ,
                     ucm:HousingEligibilityContext ;
            ucm:definedByArtifact ex:rules-1 .


###  http://example.org/ucm/ctx-housing
ex:ctx-housing rdf:type owl:NamedIndividual ,
                        ucm:HousingContext ;
               ucm:definedByArtifact ex:prog-1 .


###  http://example.org/ucm/enc-1
ex:enc-1 rdf:type owl:NamedIndividual ,
                  ucm:ClinicalEncounter ;
         ucm:hasParticipant ex:p-pat ;
         ucm:hasPatient ex:person-a .


###  http://example.org/ucm/focus-1
ex:focus-1 rdf:type owl:NamedIndividual ,
                    ucm:ActivityFocus ;
           rdfs:label "Tenancy preservation" .


###  http://example.org/ucm/hh-001
ex:hh-001 rdf:type owl:NamedIndividual ,
                   ucm:Household ;
          ucm:definedByCriteria ex:hh-criteria .


###  http://example.org/ucm/hh-criteria
ex:hh-criteria rdf:type owl:NamedIndividual ,
                        ucm:MembershipCriteria .


###  http://example.org/ucm/hs-1
ex:hs-1 rdf:type owl:NamedIndividual ,
                 ucm:Handshake ;
        ucm:hasHandoffStatus ucm:HandoffAssumed ;
        ucm:hasHandshakeFulfillment ucm:FulfillmentConfirmed ;
        ucm:negotiates ex:req-1 .


###  http://example.org/ucm/mc-1
ex:mc-1 rdf:type owl:NamedIndividual ,
                 ucm:MatchClaim ;
        ucm:madeWithinContext ex:ctx-housing ;
        ucm:statementDate "2026-09-03T12:00:00-07:00"^^xsd:dateTime .


###  http://example.org/ucm/mem-a
ex:mem-a rdf:type owl:NamedIndividual ,
                  ucm:Membership ;
         ucm:membershipIn ex:hh-001 .


###  http://example.org/ucm/org-ecm
ex:org-ecm rdf:type owl:NamedIndividual ,
                    ucm:Organization .


###  http://example.org/ucm/org-fund
ex:org-fund rdf:type owl:NamedIndividual ,
                     ucm:Organization ;
            ucm:acceptsRequest ex:p-fund .


###  http://example.org/ucm/p-cm
ex:p-cm rdf:type owl:NamedIndividual ,
                 ucm:Participation ;
        ucm:assumesRole ex:role-coord ;
        ucm:occursWithin ex:req-1 ;
        ucm:participatingEntity ex:cm-1 ;
        ucm:validFrom "2026-08-28T09:00:00-07:00"^^xsd:dateTime ;
        ucm:validTo "2026-10-31T17:00:00-07:00"^^xsd:dateTime .


###  http://example.org/ucm/p-fund
ex:p-fund rdf:type owl:NamedIndividual ,
                   ucm:Participation ;
          ucm:assumesRole ex:role-prov ;
          ucm:occursWithin ex:req-1 ;
          ucm:participatingEntity ex:org-fund .


###  http://example.org/ucm/p-pat
ex:p-pat rdf:type owl:NamedIndividual ,
                  ucm:Participation ;
         ucm:assumesRole ex:role-pat ;
         ucm:occursWithin ex:enc-1 ;
         ucm:participatingEntity ex:person-a ;
         ucm:scopedBy ex:ctx-clin .


###  http://example.org/ucm/p-res
ex:p-res rdf:type owl:NamedIndividual ,
                  ucm:Participation ;
         ucm:assumesRole ex:role-res ;
         ucm:enactiveDuring ex:t-assess ;
         ucm:occursWithin ex:assess-1 ;
         ucm:participatingEntity ex:person-a ;
         ucm:participationContext ex:ctx-housing .


###  http://example.org/ucm/person-a
ex:person-a rdf:type owl:NamedIndividual ,
                     ucm:Person ;
            ucm:hasMembership ex:mem-a .


###  http://example.org/ucm/prog-1
ex:prog-1 rdf:type owl:NamedIndividual ,
                   ucm:ProgramDefinition .


###  http://example.org/ucm/req-1
ex:req-1 rdf:type owl:NamedIndividual ,
                  ucm:CoordinationRequest ;
         ucm:hasActivityFocus ex:focus-1 ;
         ucm:hasClosureReason ucm:ClosedConnected ;
         ucm:hasLifecycleState ucm:Accepted ;
         ucm:hasReferralDisposition ucm:ReferralAccepted .


###  http://example.org/ucm/role-coord
ex:role-coord rdf:type owl:NamedIndividual ,
                       ucm:CoordinatorRole .


###  http://example.org/ucm/role-pat
ex:role-pat rdf:type owl:NamedIndividual ,
                     ucm:PatientRole .


###  http://example.org/ucm/role-prov
ex:role-prov rdf:type owl:NamedIndividual ,
                      ucm:ProviderRole .


###  http://example.org/ucm/role-res
ex:role-res rdf:type owl:NamedIndividual ,
                     ucm:ResidentRole .


###  http://example.org/ucm/rules-1
ex:rules-1 rdf:type owl:NamedIndividual ,
                    ucm:EligibilityRuleset .


###  http://example.org/ucm/stmt-1
ex:stmt-1 rdf:type owl:NamedIndividual ,
                   ucm:HousingEligibilityStatement ;
          ucm:generatedByProcess ex:assess-1 ;
          ucm:hasCareTrajectoryContext ex:traj-1 ;
          ucm:madeWithinContext ex:ctx-elig ;
          ucm:statementDate "2026-09-02T10:45:00-07:00"^^xsd:dateTimeStamp ;
          ucm:statementSubject ex:p-res .


###  http://example.org/ucm/t-assess
ex:t-assess rdf:type owl:NamedIndividual ,
                     time:ProperInterval ;
            time:hasBeginning [ rdf:type time:Instant ;
                                time:inXSDDateTimeStamp "2026-09-02T09:00:00-07:00"^^xsd:dateTimeStamp
                              ] ;
            time:hasEnd [ rdf:type time:Instant ;
                          time:inXSDDateTimeStamp "2026-09-02T10:30:00-07:00"^^xsd:dateTimeStamp
                        ] .


###  http://example.org/ucm/traj-1
ex:traj-1 rdf:type owl:NamedIndividual ,
                   ucm:CareTrajectoryContext ;
          rdfs:label "After assessment, before referral acceptance" .


#################################################################
#    Consent and identity examples (consent-concepts-plan, 2026-11-27)
#
#    DISCLAIMER. The self-consent rules below are drawn from real state,
#    CoC and federal rules as summarized in the sources cited on each
#    resource (dcterms:source), as of the dates shown. They illustrate the
#    model; they are not legal guidance. Actual state and CoC rules vary,
#    change over time, and have conditions and exceptions not shown here.
#    States and CoCs are deliberately not named. Anyone publishing real
#    rules must check them against the current statute, regulation or CoC
#    policy. People, families and organizations are fictitious.
#################################################################

# ---------------------------------------------------------------- jurisdictions

ex:jur-us a ucm:JurisdictionContext ;
    rdfs:label "United States" .

ex:ExampleStateA a ucm:JurisdictionContext ;
    rdfs:label "Example State A" ;
    ucm:withinJurisdiction ex:jur-us ;
    rdfs:comment "Anonymized US state. Actual state rules vary; not legal guidance." .

ex:ExampleStateB a ucm:JurisdictionContext ;
    rdfs:label "Example State B" ;
    ucm:withinJurisdiction ex:jur-us ;
    rdfs:comment "Anonymized US state. Actual state rules vary; not legal guidance." .

ex:ExampleStateC a ucm:JurisdictionContext ;
    rdfs:label "Example State C" ;
    ucm:withinJurisdiction ex:jur-us ;
    rdfs:comment "Anonymized US state. Actual state rules vary; not legal guidance." .

ex:ExampleStateD a ucm:JurisdictionContext ;
    rdfs:label "Example State D" ;
    ucm:withinJurisdiction ex:jur-us ;
    rdfs:comment "Anonymized US state. Actual state rules vary; not legal guidance." .

ex:ExampleCountyD a ucm:JurisdictionContext ;
    rdfs:label "Example County in State D" ;
    ucm:withinJurisdiction ex:ExampleStateD .

ex:ExampleStateE a ucm:JurisdictionContext ;
    rdfs:label "Example State E" ;
    ucm:withinJurisdiction ex:jur-us ;
    rdfs:comment "Anonymized US state. Actual state rules vary; not legal guidance." .

ex:ExampleCoCE a ucm:JurisdictionContext ;
    rdfs:label "Example CoC E" ;
    ucm:withinJurisdiction ex:ExampleStateE ;
    rdfs:comment "Anonymized HUD Continuum of Care. Actual CoC policies vary; not legal guidance." .

# ---------------------------------------------------------------- self-consent rules (anonymized, section 6.3)

ex:rule-ferpa a ucm:SelfConsentRule ;
    rdfs:label "Federal: education records" ;
    rdfs:comment "Rights over education records pass from parents to the student at 18, or at any age once the student attends a postsecondary institution. Illustration only; not legal guidance." ;
    dcterms:source "U.S. Department of Education, Student Privacy Policy Office, 'Eligible Student' (studentprivacy.ed.gov); 34 CFR 99.3; 20 U.S.C. 1232g(d)." ;
    ucm:inJurisdiction ex:jur-us ;
    ucm:hasRegulatoryBasis ucm:FERPA ;
    ucm:minimumSelfConsentAge "18"^^xsd:nonNegativeInteger ;
    ucm:selfConsentCondition ucm:AgeOfMajority , ucm:PostsecondaryEnrollment ;
    ucm:selfConsentScope ucm:EducationInformation .

ex:rule-state-a-sti a ucm:SelfConsentRule ;
    rdfs:label "Example State A: STI care from 12" ;
    rdfs:comment "Minors 12 and older may consent to STI testing and treatment. Illustration only; actual state rules vary; not legal guidance." ;
    dcterms:source "Guttmacher Institute, 'Minors' Access to STI Services', as of 2026-08-01." ;
    ucm:inJurisdiction ex:ExampleStateA ;
    ucm:hasRegulatoryBasis ucm:StateLaw ;
    ucm:minimumSelfConsentAge "12"^^xsd:nonNegativeInteger ;
    ucm:selfConsentCondition ucm:ServiceSpecificMinorConsent ;
    ucm:selfConsentScope ucm:SexuallyTransmittedDisease , ucm:Treatment .

ex:rule-state-b-sti a ucm:SelfConsentRule ;
    rdfs:label "Example State B: STI care from 14" ;
    rdfs:comment "Minors 14 and older may consent to STI testing and treatment. Illustration only; actual state rules vary; not legal guidance." ;
    dcterms:source "Guttmacher Institute, 'Minors' Access to STI Services', as of 2026-08-01." ;
    ucm:inJurisdiction ex:ExampleStateB ;
    ucm:hasRegulatoryBasis ucm:StateLaw ;
    ucm:minimumSelfConsentAge "14"^^xsd:nonNegativeInteger ;
    ucm:selfConsentCondition ucm:ServiceSpecificMinorConsent ;
    ucm:selfConsentScope ucm:SexuallyTransmittedDisease .

ex:rule-state-c-hiv a ucm:SelfConsentRule ;
    rdfs:label "Example State C: HIV care from 13" ;
    rdfs:comment "Minors 13 and older may consent to HIV testing and treatment. Illustration only; actual state rules vary; not legal guidance." ;
    dcterms:source "Guttmacher Institute, 'Minors' Access to STI Services', as of 2026-08-01." ;
    ucm:inJurisdiction ex:ExampleStateC ;
    ucm:hasRegulatoryBasis ucm:StateLaw ;
    ucm:minimumSelfConsentAge "13"^^xsd:nonNegativeInteger ;
    ucm:selfConsentCondition ucm:ServiceSpecificMinorConsent ;
    ucm:selfConsentScope ucm:HIV , ucm:Treatment .

ex:rule-state-d-housing a ucm:SelfConsentRule ;
    rdfs:label "Example State D: housing for homeless youth" ;
    rdfs:comment "A youth aged 16 or 17 who is homeless, or a victim of domestic violence, and is self-supporting may consent to housing, shelter, medical and mental health care and related services. A homeless service provider or school district homeless liaison verifies the status in a letter. Illustration only; actual state rules vary; not legal guidance." ;
    dcterms:source "SchoolHouse Connection, 'State Laws on Minor Consent for Housing and Related Services' (June 2026). Secondary summary; check the statute." ;
    ucm:inJurisdiction ex:ExampleStateD ;
    ucm:hasRegulatoryBasis ucm:StateLaw ;
    ucm:minimumSelfConsentAge "16"^^xsd:nonNegativeInteger ;
    ucm:selfConsentCondition ucm:UnaccompaniedYouthStatus , ucm:SelfSupporting ;
    ucm:selfConsentScope ucm:HousingPlacement , ucm:SocialCareCoordination , ucm:Treatment .

ex:rule-coc-e-roi a ucm:SelfConsentRule ;
    rdfs:label "Example CoC E: HMIS release of information" ;
    rdfs:comment "Clients 18 and over sign their own ROI. For each child under 18, a parent or legal guardian chooses the sharing option and signs a separate consent. Illustration only; actual CoC policies vary; not legal guidance." ;
    dcterms:source "All Chicago HMIS, 'Documenting Client Consent in HMIS (ROI)'." ;
    ucm:inJurisdiction ex:ExampleCoCE ;
    ucm:hasRegulatoryBasis ucm:HMISDataStandards ;
    ucm:minimumSelfConsentAge "18"^^xsd:nonNegativeInteger ;
    ucm:selfConsentCondition ucm:AgeOfMajority ;
    ucm:selfConsentScope ucm:ReleaseOfInformation .

# ---------------------------------------------------------------- policies, notice, trust frameworks

ex:policy-coc-e a ucm:ConsentPolicy ;
    rdfs:label "Example CoC E HMIS consent policy" ;
    ucm:inJurisdiction ex:ExampleCoCE ;
    ucm:hasConsentModel ucm:OptIn ;
    ucm:hasRegulatoryBasis ucm:HMISDataStandards ;
    ucm:requiresIAL ucm:IAL1 ;
    ucm:withdrawalMethod "Tell any participating agency in writing, or call the CoC HMIS help desk." .

ex:notice-coc-e a ucm:PrivacyNotice ;
    rdfs:label "Example CoC E posted HMIS privacy notice" ;
    ucm:forPurpose ucm:CoordinatedEntry , ucm:ProgramReporting ;
    ucm:hasConsentModel ucm:OptOutWithExceptions ;
    ucm:amendmentAppliesRetroactively false ;
    ucm:postedAt ex:loc-intake ;
    ucm:sourceDocument ex:doc-notice-text ;
    ucm:withdrawalMethod "https://example.org/coc-e/privacy" .

ex:loc-intake a ucm:Location ;
    rdfs:label "Intake desk" .

ex:doc-notice-text a ucm:InformationArtifact ;
    rdfs:label "Privacy notice text" .

ex:tf-nist a ucm:TrustFramework ;
    rdfs:label "NIST SP 800-63-4" ;
    ucm:trustFrameworkIdentifier "nist_800_63A"^^xsd:string .

ex:tf-tefca-ias a ucm:TrustFramework ;
    rdfs:label "TEFCA Individual Access Services SOP" ;
    ucm:requiresIAL ucm:IAL2 ;
    ucm:requiresAAL ucm:AAL2 .

ex:org-csp a ucm:Organization ; rdfs:label "Example credential service provider" .
ex:org-assessor a ucm:Organization ; rdfs:label "Example accredited assessor" .
ex:org-state-e a ucm:Organization ; rdfs:label "Example State E motor vehicles agency" .
ex:org-lead-agency a ucm:Organization ; rdfs:label "Example CoC E HMIS lead agency" .
ex:org-clinic a ucm:Organization ; rdfs:label "Example community clinic" .

ex:cert-csp a ucm:AssuranceCertification ;
    ucm:certifies ex:org-csp ;
    ucm:issuedBy ex:org-assessor ;
    ucm:underTrustFramework ex:tf-nist ;
    ucm:achievedIAL ucm:IAL2 ;
    ucm:validDuring ex:t-cert .

# ---------------------------------------------------------------- roles

ex:role-proxy a ucm:ConsentProxyRole .
ex:role-grantor a ucm:ConsentGrantorRole .
ex:role-csubject a ucm:ConsentSubjectRole .
ex:role-recipient a ucm:InformationRecipientRole .
ex:role-controller a ucm:DataControllerRole .
ex:role-verifier a ucm:ConsentVerifierRole .
ex:role-applicant a ucm:IdentityApplicantRole .
ex:role-reference a ucm:ApplicantReferenceRole .
ex:role-agent a ucm:ProofingAgentRole .

# ---------------------------------------------------------------- (a) the Thomson family
# Ruth signs as proxy for her children Jameson and Madison (one directive per
# member). Sarah, an adult in the household, signs for herself and denies
# disclosure of her 42 CFR Part 2 records, except to her clinic for treatment.

ex:hh-thomson a ucm:Household ; rdfs:label "Thomson household" .

ex:ruth a ucm:Person ;
    rdfs:label "Ruth Thomson" ;
    ucm:birthDate "1985-04-02"^^xsd:date ;
    ucm:birthDateQuality ucm:FullDateReported ;
    ucm:hasIdentity ex:id-ruth .
ex:jameson a ucm:Person ; rdfs:label "Jameson Thomson" ; ucm:birthDate "2014-06-10"^^xsd:date .
ex:madison a ucm:Person ; rdfs:label "Madison Thomson" ; ucm:birthDate "2017-02-20"^^xsd:date .
ex:sarah a ucm:Person ; rdfs:label "Sarah Thomson" ; ucm:birthDate "1996-09-15"^^xsd:date .

ex:id-ruth a ucm:Identity ;
    ucm:identityOf ex:ruth ;
    ucm:hasIdentifier ex:idf-ruth-dl ;
    ucm:achievedIAL ucm:IAL2 .
