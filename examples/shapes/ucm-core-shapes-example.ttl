#################################################################
#    Individuals
#################################################################

###  http://example.org/ucm/assess-1
ex:assess-1 rdf:type owl:NamedIndividual ,
                     ucm:HousingAssessment ;
            ucm:hasParticipant ex:p-res ;
            ucm:hasResident ex:person-a ;
            ucm:occursDuring ex:t-assess .


###  http://example.org/ucm/cm-1
ex:cm-1 rdf:type owl:NamedIndividual ,
                 ucm:Person ;
        ucm:affiliatedWith ex:org-ecm .


###  http://example.org/ucm/commit-1
ex:commit-1 rdf:type owl:NamedIndividual ,
                     ucm:CareCommitment ;
            ucm:hasCommitmentStatus ucm:CommitmentInForce .


###  http://example.org/ucm/ctx-clin
ex:ctx-clin rdf:type owl:NamedIndividual ,
                     ucm:ClinicalCareContext .


###  http://example.org/ucm/ctx-elig
ex:ctx-elig rdf:type owl:NamedIndividual ,
                     ucm:HousingEligibilityContext ;
            ucm:definedByArtifact ex:rules-1 .


###  http://example.org/ucm/ctx-housing
ex:ctx-housing rdf:type owl:NamedIndividual ,
                        ucm:HousingContext ;
               ucm:definedByArtifact ex:prog-1 .


###  http://example.org/ucm/enc-1
ex:enc-1 rdf:type owl:NamedIndividual ,
                  ucm:ClinicalEncounter ;
         ucm:hasParticipant ex:p-pat ;
         ucm:hasPatient ex:person-a .


###  http://example.org/ucm/focus-1
ex:focus-1 rdf:type owl:NamedIndividual ,
                    ucm:ActivityFocus ;
           rdfs:label "Tenancy preservation" .


###  http://example.org/ucm/hh-001
ex:hh-001 rdf:type owl:NamedIndividual ,
                   ucm:Household ;
          ucm:definedByCriteria ex:hh-criteria .


###  http://example.org/ucm/hh-criteria
ex:hh-criteria rdf:type owl:NamedIndividual ,
                        ucm:MembershipCriteria .


###  http://example.org/ucm/hs-1
ex:hs-1 rdf:type owl:NamedIndividual ,
                 ucm:Handshake ;
        ucm:hasHandoffStatus ucm:HandoffAssumed ;
        ucm:hasHandshakeFulfillment ucm:FulfillmentConfirmed ;
        ucm:negotiates ex:req-1 .


###  http://example.org/ucm/mc-1
ex:mc-1 rdf:type owl:NamedIndividual ,
                 ucm:MatchClaim ;
        ucm:madeWithinContext ex:ctx-housing ;
        ucm:statementDate "2026-09-03T12:00:00-07:00"^^xsd:dateTime .


###  http://example.org/ucm/mem-a
ex:mem-a rdf:type owl:NamedIndividual ,
                  ucm:Membership ;
         ucm:membershipIn ex:hh-001 .


###  http://example.org/ucm/org-ecm
ex:org-ecm rdf:type owl:NamedIndividual ,
                    ucm:Organization .


###  http://example.org/ucm/org-fund
ex:org-fund rdf:type owl:NamedIndividual ,
                     ucm:Organization ;
            ucm:acceptsRequest ex:p-fund .


###  http://example.org/ucm/p-cm
ex:p-cm rdf:type owl:NamedIndividual ,
                 ucm:Participation ;
        ucm:assumesRole ex:role-coord ;
        ucm:occursWithin ex:req-1 ;
        ucm:participatingEntity ex:cm-1 ;
        ucm:validFrom "2026-08-28T09:00:00-07:00"^^xsd:dateTime ;
        ucm:validTo "2026-10-31T17:00:00-07:00"^^xsd:dateTime .


###  http://example.org/ucm/p-fund
ex:p-fund rdf:type owl:NamedIndividual ,
                   ucm:Participation ;
          ucm:assumesRole ex:role-prov ;
          ucm:occursWithin ex:req-1 ;
          ucm:participatingEntity ex:org-fund .


###  http://example.org/ucm/p-pat
ex:p-pat rdf:type owl:NamedIndividual ,
                  ucm:Participation ;
         ucm:assumesRole ex:role-pat ;
         ucm:occursWithin ex:enc-1 ;
         ucm:participatingEntity ex:person-a ;
         ucm:scopedBy ex:ctx-clin .


###  http://example.org/ucm/p-res
ex:p-res rdf:type owl:NamedIndividual ,
                  ucm:Participation ;
         ucm:assumesRole ex:role-res ;
         ucm:enactiveDuring ex:t-assess ;
         ucm:occursWithin ex:assess-1 ;
         ucm:participatingEntity ex:person-a ;
         ucm:participationContext ex:ctx-housing .


###  http://example.org/ucm/person-a
ex:person-a rdf:type owl:NamedIndividual ,
                     ucm:Person ;
            ucm:hasMembership ex:mem-a .


###  http://example.org/ucm/prog-1
ex:prog-1 rdf:type owl:NamedIndividual ,
                   ucm:ProgramDefinition .


###  http://example.org/ucm/req-1
ex:req-1 rdf:type owl:NamedIndividual ,
                  ucm:CoordinationRequest ;
         ucm:hasActivityFocus ex:focus-1 ;
         ucm:hasClosureReason ucm:ClosedConnected ;
         ucm:hasLifecycleState ucm:Accepted ;
         ucm:hasReferralDisposition ucm:ReferralAccepted .


###  http://example.org/ucm/role-coord
ex:role-coord rdf:type owl:NamedIndividual ,
                       ucm:CoordinatorRole .


###  http://example.org/ucm/role-pat
ex:role-pat rdf:type owl:NamedIndividual ,
                     ucm:PatientRole .


###  http://example.org/ucm/role-prov
ex:role-prov rdf:type owl:NamedIndividual ,
                      ucm:ProviderRole .


###  http://example.org/ucm/role-res
ex:role-res rdf:type owl:NamedIndividual ,
                     ucm:ResidentRole .


###  http://example.org/ucm/rules-1
ex:rules-1 rdf:type owl:NamedIndividual ,
                    ucm:EligibilityRuleset .


###  http://example.org/ucm/stmt-1
ex:stmt-1 rdf:type owl:NamedIndividual ,
                   ucm:HousingEligibilityStatement ;
          ucm:generatedByProcess ex:assess-1 ;
          ucm:hasCareTrajectoryContext ex:traj-1 ;
          ucm:madeWithinContext ex:ctx-elig ;
          ucm:statementDate "2026-09-02T10:45:00-07:00"^^xsd:dateTimeStamp ;
          ucm:statementSubject ex:p-res .


###  http://example.org/ucm/t-assess
ex:t-assess rdf:type owl:NamedIndividual ,
                     time:ProperInterval ;
            time:hasBeginning [ rdf:type time:Instant ;
                                time:inXSDDateTimeStamp "2026-09-02T09:00:00-07:00"^^xsd:dateTimeStamp
                              ] ;
            time:hasEnd [ rdf:type time:Instant ;
                          time:inXSDDateTimeStamp "2026-09-02T10:30:00-07:00"^^xsd:dateTimeStamp
                        ] .


###  http://example.org/ucm/traj-1
ex:traj-1 rdf:type owl:NamedIndividual ,
                   ucm:CareTrajectoryContext ;
          rdfs:label "After assessment, before referral acceptance" .


