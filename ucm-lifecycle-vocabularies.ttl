###  https://www.w3.org/ns/ucm#BirthDateQuality
ucm:BirthDateQuality rdf:type owl:NamedIndividual ,
                              skos:ConceptScheme ;
                     dcterms:created "2026-11-27"^^xsd:date ;
                     dcterms:description "How reliable is the recorded birth date?"@en ;
                     dcterms:publisher "MDIX"@en ;
                     dcterms:title "UCM Birth Date Quality"@en ;
                     skos:definition "How reliable a person's recorded birth date is, mirroring HMIS element 3.03 DOB Data Quality (FY 2026 HMIS Data Dictionary, October 2025). skos:notation carries the HMIS response code."@en ;
                     skos:hasTopConcept ucm:FullDateReported ,
                                        ucm:ApproximateOrPartial ,
                                        ucm:ClientDoesNotKnow ,
                                        ucm:ClientPreferNotToAnswer ,
                                        ucm:DataNotCollected ;
                     skos:prefLabel "Birth Date Quality"@en .


###  https://www.w3.org/ns/ucm#FullDateReported
ucm:FullDateReported rdf:type owl:NamedIndividual ,
                              skos:Concept ;
                     skos:notation "1" ;
                     skos:definition "The full date of birth was reported (HMIS: Full DOB reported)."@en ;
                     skos:inScheme ucm:BirthDateQuality ;
                     skos:prefLabel "Full date reported"@en ;
                     skos:topConceptOf ucm:BirthDateQuality .


###  https://www.w3.org/ns/ucm#ApproximateOrPartial
ucm:ApproximateOrPartial rdf:type owl:NamedIndividual ,
                                  skos:Concept ;
                         skos:notation "2" ;
                         skos:definition "An approximate or partial date of birth was reported (HMIS: Approximate or partial DOB reported)."@en ;
                         skos:inScheme ucm:BirthDateQuality ;
                         skos:prefLabel "Approximate or partial"@en ;
                         skos:topConceptOf ucm:BirthDateQuality .


###  https://www.w3.org/ns/ucm#ClientDoesNotKnow
ucm:ClientDoesNotKnow rdf:type owl:NamedIndividual ,
                               skos:Concept ;
                      skos:notation "8" ;
                      skos:definition "The person does not know their date of birth. HMIS allows this only with no birth date recorded."@en ;
                      skos:inScheme ucm:BirthDateQuality ;
                      skos:prefLabel "Client doesn't know"@en ;
                      skos:topConceptOf ucm:BirthDateQuality .


###  https://www.w3.org/ns/ucm#ClientPreferNotToAnswer
ucm:ClientPreferNotToAnswer rdf:type owl:NamedIndividual ,
                                     skos:Concept ;
                            skos:notation "9" ;
                            skos:definition "The person declined to give their date of birth. HMIS allows this only with no birth date recorded."@en ;
                            skos:inScheme ucm:BirthDateQuality ;
                            skos:prefLabel "Client prefers not to answer"@en ;
                            skos:topConceptOf ucm:BirthDateQuality .


