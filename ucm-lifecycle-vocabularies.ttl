###  https://www.w3.org/ns/ucm#IdentityAssuranceLevel
ucm:IdentityAssuranceLevel rdf:type owl:NamedIndividual ,
                                    skos:ConceptScheme ;
                           dcterms:created "2026-11-27"^^xsd:date ;
                           dcterms:description "How strongly was this identity proofed?"@en ;
                           dcterms:publisher "MDIX"@en ;
                           dcterms:title "UCM Identity Assurance Level"@en ;
                           skos:definition "NIST SP 800-63-4 identity assurance levels. Each level carries ucm:assuranceRank so levels can be compared."@en ;
                           skos:editorialNote "NIST SP 800-63-4 names no IAL0; NoIdentityProofing covers the case it describes in words."@en ;
                           skos:hasTopConcept ucm:NoIdentityProofing ,
                                              ucm:IAL1 ,
                                              ucm:IAL2 ,
                                              ucm:IAL3 ;
                           skos:prefLabel "Identity Assurance Level"@en .


###  https://www.w3.org/ns/ucm#NoIdentityProofing
ucm:NoIdentityProofing rdf:type owl:NamedIndividual ,
                                skos:Concept ;
                       ucm:assuranceRank "0"^^xsd:integer ;
                       skos:definition "No identity proofing was performed; attributes are self-asserted."@en ;
                       skos:inScheme ucm:IdentityAssuranceLevel ;
                       skos:prefLabel "No identity proofing"@en ;
                       skos:topConceptOf ucm:IdentityAssuranceLevel .


###  https://www.w3.org/ns/ucm#IAL1
ucm:IAL1 rdf:type owl:NamedIndividual ,
                  skos:Concept ;
         ucm:assuranceRank "1"^^xsd:integer ;
         skos:definition "Identity proofing that confirms the claimed identity exists and is likely the applicant's (NIST IAL1)."@en ;
         skos:inScheme ucm:IdentityAssuranceLevel ;
         skos:prefLabel "IAL1"@en ;
         skos:topConceptOf ucm:IdentityAssuranceLevel .


###  https://www.w3.org/ns/ucm#IAL2
ucm:IAL2 rdf:type owl:NamedIndividual ,
                  skos:Concept ;
         ucm:assuranceRank "2"^^xsd:integer ;
         skos:definition "Identity proofing with stronger evidence and verification, remote or in person (NIST IAL2)."@en ;
         skos:inScheme ucm:IdentityAssuranceLevel ;
         skos:prefLabel "IAL2"@en ;
         skos:topConceptOf ucm:IdentityAssuranceLevel .


###  https://www.w3.org/ns/ucm#IAL3
ucm:IAL3 rdf:type owl:NamedIndividual ,
                  skos:Concept ;
         ucm:assuranceRank "3"^^xsd:integer ;
         skos:definition "Identity proofing in person or supervised remote, with the strongest evidence (NIST IAL3)."@en ;
         skos:inScheme ucm:IdentityAssuranceLevel ;
         skos:prefLabel "IAL3"@en ;
         skos:topConceptOf ucm:IdentityAssuranceLevel .


###  https://www.w3.org/ns/ucm#AuthenticatorAssuranceLevel
ucm:AuthenticatorAssuranceLevel rdf:type owl:NamedIndividual ,
                                         skos:ConceptScheme ;
                                dcterms:created "2026-11-27"^^xsd:date ;
                                dcterms:description "How strongly was the claimant authenticated?"@en ;
                                dcterms:publisher "MDIX"@en ;
                                dcterms:title "UCM Authenticator Assurance Level"@en ;
                                skos:definition "NIST SP 800-63B-4 authenticator assurance levels (section 2)."@en ;
                                skos:hasTopConcept ucm:AAL1 ,
                                                   ucm:AAL2 ,
                                                   ucm:AAL3 ;
                                skos:prefLabel "Authenticator Assurance Level"@en .


###  https://www.w3.org/ns/ucm#AAL1
ucm:AAL1 rdf:type owl:NamedIndividual ,
                  skos:Concept ;
         ucm:assuranceRank "1"^^xsd:integer ;
         skos:definition "Basic confidence that the claimant controls an authenticator bound to the subscriber account, using single-factor or multi-factor authentication (NIST AAL1)."@en ;
         skos:inScheme ucm:AuthenticatorAssuranceLevel ;
         skos:prefLabel "AAL1"@en ;
         skos:topConceptOf ucm:AuthenticatorAssuranceLevel .


###  https://www.w3.org/ns/ucm#AAL2
ucm:AAL2 rdf:type owl:NamedIndividual ,
                  skos:Concept ;
         ucm:assuranceRank "2"^^xsd:integer ;
         skos:definition "High confidence from proof of possession and control of two distinct authentication factors. Verifiers must offer at least one phishing-resistant option (NIST AAL2)."@en ;
         skos:inScheme ucm:AuthenticatorAssuranceLevel ;
         skos:prefLabel "AAL2"@en ;
         skos:topConceptOf ucm:AuthenticatorAssuranceLevel .


###  https://www.w3.org/ns/ucm#AAL3
ucm:AAL3 rdf:type owl:NamedIndividual ,
                  skos:Concept ;
         ucm:assuranceRank "3"^^xsd:integer ;
         skos:definition "Very high confidence from a phishing-resistant cryptographic authenticator with a non-exportable private key; syncable authenticators are not allowed (NIST AAL3)."@en ;
         skos:inScheme ucm:AuthenticatorAssuranceLevel ;
         skos:prefLabel "AAL3"@en ;
         skos:topConceptOf ucm:AuthenticatorAssuranceLevel .


###  https://www.w3.org/ns/ucm#FederationAssuranceLevel
ucm:FederationAssuranceLevel rdf:type owl:NamedIndividual ,
                                      skos:ConceptScheme ;
                             dcterms:created "2026-11-27"^^xsd:date ;
                             dcterms:description "How strongly was the identity assertion protected?"@en ;
                             dcterms:publisher "MDIX"@en ;
                             dcterms:title "UCM Federation Assurance Level"@en ;
                             skos:definition "NIST SP 800-63C-4 federation assurance levels (section 2)."@en ;
                             skos:hasTopConcept ucm:FAL1 ,
                                                ucm:FAL2 ,
                                                ucm:FAL3 ;
                             skos:prefLabel "Federation Assurance Level"@en .


###  https://www.w3.org/ns/ucm#FAL1
ucm:FAL1 rdf:type owl:NamedIndividual ,
                  skos:Concept ;
         ucm:assuranceRank "1"^^xsd:integer ;
         skos:definition "Basic protection: the identity provider signs the assertion with approved cryptography and restricts its audience to a specific relying party or set of relying parties (NIST FAL1)."@en ;
         skos:inScheme ucm:FederationAssuranceLevel ;
         skos:prefLabel "FAL1"@en ;
         skos:topConceptOf ucm:FederationAssuranceLevel .


###  https://www.w3.org/ns/ucm#FAL2
ucm:FAL2 rdf:type owl:NamedIndividual ,
                  skos:Concept ;
         ucm:assuranceRank "2"^^xsd:integer ;
         skos:definition "High protection: the assertion is strongly protected from injection attacks and audience-restricted to a single relying party, under a pre-established trust agreement (NIST FAL2)."@en ;
         skos:inScheme ucm:FederationAssuranceLevel ;
         skos:prefLabel "FAL2"@en ;
         skos:topConceptOf ucm:FederationAssuranceLevel .


###  https://www.w3.org/ns/ucm#FAL3
ucm:FAL3 rdf:type owl:NamedIndividual ,
                  skos:Concept ;
         ucm:assuranceRank "3"^^xsd:integer ;
         skos:definition "Very high protection: the relying party also verifies that the subscriber controls an authenticator, named in a holder-of-key assertion or bound to the account, which guards against a compromised identity provider (NIST FAL3)."@en ;
         skos:inScheme ucm:FederationAssuranceLevel ;
         skos:prefLabel "FAL3"@en ;
         skos:topConceptOf ucm:FederationAssuranceLevel .


