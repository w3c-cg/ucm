                                   sh:NodeShape ;
                          sh:severity sh:Warning ;
                          sh:sparql [ sh:message "Proofing type is neither in ucm:ProofingType nor SKOS-mapped to a concept that is." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
                $this ucm:hasProofingType ?value .
                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:ProofingType)) }
                FILTER NOT EXISTS {
                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .
                    FILTER (?m IN (ucm:ProofingType))
                }
            }"""
              ] ;
                          sh:targetSubjectsOf ucm:hasProofingType ;
                          ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#IdentifierType-anchored
ucm:IdentifierType-anchored rdf:type owl:NamedIndividual ,
