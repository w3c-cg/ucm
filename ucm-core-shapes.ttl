###  https://www.w3.org/ns/ucm#ConsentGrantorShape
ucm:ConsentGrantorShape rdf:type owl:NamedIndividual ,
                                 sh:NodeShape ;
                        sh:severity sh:Warning ;
                        sh:sparql [ sh:message "Consent directive has no grantor: its recording consent interaction has no participation in a ConsentGrantorRole." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this ucm:recordsConsentFrom ?ci .
                    ?gp ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentGrantorRole .
                    { ?gp ucm:occursWithin ?ci } UNION { ?ci ucm:hasParticipant ?gp }
                }
            }"""
              ] ;
                        sh:targetClass ucm:ConsentDirective ;
                        ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#ProxyGrantorShape
ucm:ProxyGrantorShape rdf:type owl:NamedIndividual ,
                               sh:NodeShape ;
                      sh:severity sh:Warning ;
                      sh:sparql [ sh:message "Grantor is not the subject, so the grantor's role should be ucm:ConsentProxyRole (or a subclass)." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this ?grantor WHERE {
                $this ucm:recordsConsentFrom ?ci .
                ?gp ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentGrantorRole .
                { ?gp ucm:occursWithin ?ci } UNION { ?ci ucm:hasParticipant ?gp }
                ?gp ucm:participatingEntity ?grantor .
                $this ucm:consentSubject/ucm:participatingEntity ?subject .
                FILTER (?grantor != ?subject)
                FILTER NOT EXISTS { ?gp ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentProxyRole }
            }"""
              ] ;
                      sh:targetClass ucm:ConsentDirective ;
                      ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#SelfConsentBasisShape
ucm:SelfConsentBasisShape rdf:type owl:NamedIndividual ,
                                   sh:NodeShape ;
                          sh:severity sh:Warning ;
                          sh:sparql [ sh:message "A minor (under 18 on the consent date, from ucm:birthDate) is their own grantor, but the directive is not governedByPolicy a ucm:SelfConsentRule in force in its jurisdiction whose minimum age the subject had reached." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX time: <http://www.w3.org/2006/time#>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?subject WHERE {
                $this ucm:consentSubject/ucm:participatingEntity ?subject .
                $this ucm:recordsConsentFrom ?ci .
                ?gp ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentGrantorRole .
                { ?gp ucm:occursWithin ?ci } UNION { ?ci ucm:hasParticipant ?gp }
                ?gp ucm:participatingEntity ?subject .
                ?subject ucm:birthDate ?bd .
                ?ci ucm:occursDuring ?when .
                ?when (time:hasBeginning/(time:inXSDDateTimeStamp|time:inXSDDateTime))|time:inXSDDateTimeStamp|time:inXSDDateTime ?at .
                # Latest possible birth date for a partial date: the conservative reading.
                BIND (STR(?bd) AS ?b)
                BIND (IF(STRLEN(?b) = 4, CONCAT(?b, "-12-31"), IF(STRLEN(?b) = 7, CONCAT(?b, "-31"), SUBSTR(?b, 1, 10))) AS ?latest)
                BIND (SUBSTR(STR(?at), 1, 10) AS ?on)
                BIND (xsd:integer(SUBSTR(?on, 1, 4)) - xsd:integer(SUBSTR(?latest, 1, 4))
                      - IF(SUBSTR(?on, 6, 5) < SUBSTR(?latest, 6, 5), 1, 0) AS ?age)
                FILTER (?age < 18)
                FILTER NOT EXISTS {
                    $this ucm:governedByPolicy ?rule .
                    ?rule a/rdfs:subClassOf* ucm:SelfConsentRule ;
                          ucm:inJurisdiction ?rj .
                    { $this ucm:inJurisdiction/ucm:withinJurisdiction* ?rj }
                    UNION
                    { ?ci ucm:inJurisdiction/ucm:withinJurisdiction* ?rj }
                    OPTIONAL { ?rule ucm:minimumSelfConsentAge ?min }
                    FILTER (!BOUND(?min) || ?age >= ?min)
                }
            }"""
              ] ;
                          sh:targetClass ucm:ConsentDirective ;
                          ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#RevokedHasRevocationShape
ucm:RevokedHasRevocationShape rdf:type owl:NamedIndividual ,
                                       sh:NodeShape ;
                              sh:severity sh:Warning ;
                              sh:sparql [ sh:message "Revocation is half-recorded: status is revoked with no revokedBy, or revokedBy is set while the status is still active." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this WHERE {
                {
                    $this ucm:hasConsentStatus/(skos:exactMatch|^skos:exactMatch)* ucm:ConsentRevoked .
                    FILTER NOT EXISTS { $this ucm:revokedBy ?r }
                } UNION {
                    $this ucm:revokedBy ?r ;
                          ucm:hasConsentStatus/(skos:exactMatch|^skos:exactMatch)* ucm:ConsentActive .
                }
            }"""
              ] ;
                              sh:targetClass ucm:ConsentDirective ;
                              ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#ActiveNotExpiredShape
ucm:ActiveNotExpiredShape rdf:type owl:NamedIndividual ,
                                   sh:NodeShape ;
                          sh:severity sh:Warning ;
                          sh:sparql [ sh:message "Consent directive is marked active but its period of validity has ended." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX time: <http://www.w3.org/2006/time#>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this ucm:hasConsentStatus/(skos:exactMatch|^skos:exactMatch)* ucm:ConsentActive ;
                      ucm:validDuring/time:hasEnd/(time:inXSDDateTimeStamp|time:inXSDDateTime) ?end .
                FILTER (xsd:dateTime(STR(?end)) < NOW())
            }"""
              ] ;
                          sh:targetClass ucm:ConsentDirective ;
                          ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#AuthorizedByActiveConsentShape
ucm:AuthorizedByActiveConsentShape rdf:type owl:NamedIndividual ,
                                            sh:NodeShape ;
                                   sh:severity sh:Warning ;
                                   sh:sparql [ sh:message "Process cites a consent directive whose status is not active." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
                $this ucm:authorizedByConsent ?value .
                ?value ucm:hasConsentStatus ?s .
                FILTER NOT EXISTS { ?s (skos:exactMatch|^skos:exactMatch)* ucm:ConsentActive }
            }"""
              ] ;
                                   sh:targetSubjectsOf ucm:authorizedByConsent ;
                                   ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#ConsentIdentityAssuranceShape
ucm:ConsentIdentityAssuranceShape rdf:type owl:NamedIndividual ,
                                           sh:NodeShape ;
                                  sh:severity sh:Warning ;
                                  sh:sparql [ sh:message "The governing consent policy requires an identity or authenticator assurance level that the grantor's recorded identity or authentication does not reach." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this ?value WHERE {
                $this ucm:recordsConsentFrom ?ci .
                ?gp ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentGrantorRole .
                { ?gp ucm:occursWithin ?ci } UNION { ?ci ucm:hasParticipant ?gp }
                $this ucm:governedByPolicy ?policy .
                {
                    ?policy ucm:requiresIAL ?value .
                    ?value ucm:assuranceRank ?need .
                    FILTER NOT EXISTS {
                        ?gp ucm:identifiedAs/ucm:achievedIAL/ucm:assuranceRank ?got .
                        FILTER (?got >= ?need)
                    }
                } UNION {
                    ?policy ucm:requiresAAL ?value .
                    ?value ucm:assuranceRank ?need .
                    FILTER NOT EXISTS {
                        ?ci ucm:authenticatedBy/ucm:achievedAAL/ucm:assuranceRank ?got .
                        FILTER (?got >= ?need)
                    }
                }
            }"""
              ] ;
                                  sh:targetClass ucm:ConsentDirective ;
                                  ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#ApplicantReferenceShape
ucm:ApplicantReferenceShape rdf:type owl:NamedIndividual ,
                                     sh:NodeShape ;
                            sh:severity sh:Warning ;
                            sh:sparql [ sh:message "An applicant reference does not act on the applicant's behalf (NIST SP 800-63A): the same entity is the applicant, or is the applicant's consent proxy." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this ?ref WHERE {
                ?rp ucm:assumesRole/a/rdfs:subClassOf* ucm:ApplicantReferenceRole ;
                    ucm:participatingEntity ?ref .
                { ?rp ucm:occursWithin $this } UNION { $this ucm:hasParticipant ?rp }
                ?ap ucm:assumesRole/a/rdfs:subClassOf* ucm:IdentityApplicantRole ;
                    ucm:participatingEntity ?applicant .
                { ?ap ucm:occursWithin $this } UNION { $this ucm:hasParticipant ?ap }
                FILTER (?ref = ?applicant || EXISTS {
                    ?cd ucm:consentSubject/ucm:participatingEntity ?applicant ;
                        ucm:recordsConsentFrom ?ci .
                    ?pp ucm:participatingEntity ?ref ;
                        ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentProxyRole .
                    { ?pp ucm:occursWithin ?ci } UNION { ?ci ucm:hasParticipant ?pp }
                })
            }"""
              ] ;
                            sh:targetClass ucm:IdentityProofing ;
                            ucm:tier ucm:Recommended .


