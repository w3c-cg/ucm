@prefix : <https://www.w3.org/ns/ucm#shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ucm: <https://www.w3.org/ns/ucm#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ucm-shapes: <https://www.w3.org/ns/ucm#shapes> .
@base <https://www.w3.org/ns/ucm#shapes#> .

<https://www.w3.org/ns/ucm#shapes> rdf:type owl:Ontology ;
                                    owl:imports ucm: ;
                                    rdfs:comment """Validation shapes for the Unified Care Model core.

CONVENTION
  Open by default. No shape uses sh:closed: adopters' own predicates and
  types (FHIR, HMIS, local data dictionaries, provenance) never produce results.

  Two tiers, tagged with ucmsh:tier and enforced by ucm-shapes-lint.ttl:
    ucmsh:Definitional  sh:Violation. The data is not a well-formed instance
                        of the UCM concept: identity-forming edges missing or
                        duplicated, literals where entities are required,
                        intervals that end before they begin, cycles with no
                        base case.
    ucmsh:Recommended   sh:Warning. Good practice the spec encourages but a
                        conformant adopter may not yet follow.

  sh:severity is set on every property shape individually. SHACL does not
  carry a node shape's severity down to its nested property shapes; an
  untagged property shape reports sh:Violation.

  Type constraints that mirror an rdfs:range (sh:class) are Recommended only.
  Under RDFS/OWL inference they are vacuous; without inference they reject
  data typed in a partner ontology. Structural kind (sh:nodeKind) is
  Definitional, because it is decidable from the data alone.

  Date and time values accept xsd:dateTime or xsd:dateTimeStamp. sh:datatype
  xsd:dateTime alone rejects xsd:dateTimeStamp, the form OWL-Time recommends.
  Ordering checks use SPARQL with explicit casts; sh:lessThanOrEquals crashes
  pySHACL on misordered xsd:dateTimeStamp values.""" ;
                                    rdfs:label "UCM Core Shapes (draft)" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#alternativePath
sh:alternativePath rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#class
sh:class rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#datatype
sh:datatype rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#inversePath
sh:inversePath rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#maxCount
sh:maxCount rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#message
sh:message rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#minCount
sh:minCount rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#nodeKind
sh:nodeKind rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#or
sh:or rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#path
sh:path rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#property
sh:property rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#select
sh:select rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#severity
sh:severity rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#sparql
sh:sparql rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#targetClass
sh:targetClass rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#targetObjectsOf
sh:targetObjectsOf rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#targetSubjectsOf
sh:targetSubjectsOf rdf:type owl:AnnotationProperty .


###  https://www.w3.org/ns/ucm#tier
ucm:tier rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


###  http://www.w3.org/ns/shacl#NodeShape
sh:NodeShape rdf:type owl:Class .


###  http://www.w3.org/ns/shacl#PropertyShape
sh:PropertyShape rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  https://www.w3.org/ns/ucm#AcceptsRequestShape
ucm:AcceptsRequestShape rdf:type owl:NamedIndividual ,
                                 sh:NodeShape ;
                        sh:property [ sh:class ucm:Participation ;
                                      sh:message "acceptsRequest target is not typed as ucm:Participation." ;
                                      sh:path ucm:acceptsRequest ;
                                      sh:severity sh:Warning ;
                                      ucm:tier ucm:Recommended
                                    ] ;
                        sh:targetSubjectsOf ucm:acceptsRequest .


###  https://www.w3.org/ns/ucm#ActivityFocusTypeShape
ucm:ActivityFocusTypeShape rdf:type owl:NamedIndividual ,
                                    sh:NodeShape ;
                           sh:property [ sh:class ucm:ActivityFocus ;
                                         sh:message "Activity focus is not typed as ucm:ActivityFocus." ;
                                         sh:path ucm:hasActivityFocus ;
                                         sh:severity sh:Warning ;
                                         ucm:tier ucm:Recommended
                                       ] ;
                           sh:targetSubjectsOf ucm:hasActivityFocus .


###  https://www.w3.org/ns/ucm#AffiliationShape
ucm:AffiliationShape rdf:type owl:NamedIndividual ,
                              sh:NodeShape ;
                     sh:property [ sh:class ucm:Organization ;
                                   sh:message "Affiliation target is not typed as ucm:Organization." ;
                                   sh:path ucm:affiliatedWith ;
                                   sh:severity sh:Warning ;
                                   ucm:tier ucm:Recommended
                                 ] ;
                     sh:targetSubjectsOf ucm:affiliatedWith .


###  https://www.w3.org/ns/ucm#CareTrajectoryShape
ucm:CareTrajectoryShape rdf:type owl:NamedIndividual ,
                                 sh:NodeShape ;
                        sh:property [ sh:class ucm:CareTrajectoryContext ;
                                      sh:message "Care trajectory context is not typed as ucm:CareTrajectoryContext." ;
                                      sh:path ucm:hasCareTrajectoryContext ;
                                      sh:severity sh:Warning ;
                                      ucm:tier ucm:Recommended
                                    ] ;
                        sh:targetSubjectsOf ucm:hasCareTrajectoryContext .


###  https://www.w3.org/ns/ucm#ClosedWhilePendingShape
ucm:ClosedWhilePendingShape rdf:type owl:NamedIndividual ,
                                     sh:NodeShape ;
                            sh:severity sh:Warning ;
                            sh:sparql [ sh:message "Closure reason recorded on a request that is still pending a decision." ;
                                        sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
                $this ucm:hasReferralDisposition|ucm:hasLifecycleState ?value .
                ?value (skos:exactMatch|^skos:exactMatch)* ucm:ReferralPending .
            }"""
                                      ] ;
                            sh:targetSubjectsOf ucm:hasClosureReason ;
                            ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#ClosureReason-anchored
ucm:ClosureReason-anchored rdf:type owl:NamedIndividual ,
                                    sh:NodeShape ;
                           sh:severity sh:Warning ;
                           sh:sparql [ sh:message "Closure reason is neither in ucm:ClosureReason nor SKOS-mapped to a concept that is." ;
                                       sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
                $this ucm:hasClosureReason ?value .
                FILTER NOT EXISTS { ?value skos:inScheme ucm:ClosureReason }
                FILTER NOT EXISTS {
                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme
                           ucm:ClosureReason
                }
            }"""
                                     ] ;
                           sh:targetSubjectsOf ucm:hasClosureReason ;
                           ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#ClosureReason-single
ucm:ClosureReason-single rdf:type owl:NamedIndividual ,
                                  sh:PropertyShape ;
                         sh:maxCount 1 ;
                         sh:message "A coordination request holds at most one closure reason, identified by IRI." ;
                         sh:nodeKind sh:IRI ;
                         sh:path ucm:hasClosureReason ;
                         sh:severity sh:Violation ;
                         ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ClosureReasonShape
ucm:ClosureReasonShape rdf:type owl:NamedIndividual ,
                                sh:NodeShape ;
                       sh:property ucm:ClosureReason-single ;
                       sh:targetSubjectsOf ucm:hasClosureReason .


###  https://www.w3.org/ns/ucm#CommitmentStatus-anchored
ucm:CommitmentStatus-anchored rdf:type owl:NamedIndividual ,
                                       sh:NodeShape ;
                              sh:severity sh:Warning ;
                              sh:sparql [ sh:message "Commitment status is neither in ucm:CommitmentStatus nor SKOS-mapped to a concept that is." ;
                                          sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
                $this ucm:hasCommitmentStatus ?value .
                FILTER NOT EXISTS { ?value skos:inScheme ucm:CommitmentStatus }
                FILTER NOT EXISTS {
                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme
                           ucm:CommitmentStatus
                }
            }"""
                                        ] ;
                              sh:targetSubjectsOf ucm:hasCommitmentStatus ;
                              ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#CommitmentStatus-single
ucm:CommitmentStatus-single rdf:type owl:NamedIndividual ,
                                     sh:PropertyShape ;
                            sh:maxCount 1 ;
                            sh:message "A care commitment holds at most one commitment status, identified by IRI." ;
                            sh:nodeKind sh:IRI ;
                            sh:path ucm:hasCommitmentStatus ;
                            sh:severity sh:Violation ;
                            ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#CommitmentStatusShape
ucm:CommitmentStatusShape rdf:type owl:NamedIndividual ,
                                   sh:NodeShape ;
                          sh:property ucm:CommitmentStatus-single ;
                          sh:targetSubjectsOf ucm:hasCommitmentStatus .


###  https://www.w3.org/ns/ucm#ContextArtifactShape
ucm:ContextArtifactShape rdf:type owl:NamedIndividual ,
                                  sh:NodeShape ;
                         sh:property [ sh:class ucm:DefinitionArtifact ;
                                       sh:message "definedByArtifact target is not typed as ucm:DefinitionArtifact." ;
                                       sh:path ucm:definedByArtifact ;
                                       sh:severity sh:Warning ;
                                       ucm:tier ucm:Recommended
                                     ] ;
                         sh:targetSubjectsOf ucm:definedByArtifact .


###  https://www.w3.org/ns/ucm#CoordinativeActivityShape
ucm:CoordinativeActivityShape rdf:type owl:NamedIndividual ,
                                       sh:NodeShape ;
                              sh:severity sh:Warning ;
                              sh:sparql [ sh:message "Coordination process declares no activity focus, directly or through a process it negotiates." ;
                                          sh:select """
            PREFIX ucm: <https://www.w3.org/ns/ucm#>
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this ucm:negotiates*/ucm:hasActivityFocus ?f }
            }"""
                                        ] ;
                              sh:targetClass ucm:CoordinationRequest ,
                                             ucm:CoordinativeActivity ;
                              ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#Definitional
ucm:Definitional rdf:type owl:NamedIndividual ,
                          skos:Concept ;
                 skos:definition "Failing data is not a well-formed instance of the concept. Reported as sh:Violation."@en ;
                 skos:prefLabel "Definitional"@en .


###  https://www.w3.org/ns/ucm#DualTemporalEncodingShape
ucm:DualTemporalEncodingShape rdf:type owl:NamedIndividual ,
                                       sh:NodeShape ;
                              sh:severity sh:Warning ;
                              sh:sparql [ sh:message "Participation uses both validFrom/validTo and enactiveDuring. The two encodings can diverge; prefer enactiveDuring." ;
                                          sh:select """
            PREFIX ucm: <https://www.w3.org/ns/ucm#>
            SELECT $this WHERE {
                $this ucm:enactiveDuring ?iv .
                FILTER EXISTS { $this ucm:validFrom|ucm:validTo ?x }
            }"""
                                        ] ;
                              sh:targetClass ucm:Participation ;
                              ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#FulfillmentAfterDeclineShape
ucm:FulfillmentAfterDeclineShape rdf:type owl:NamedIndividual ,
                                          sh:NodeShape ;
                                 sh:severity sh:Warning ;
                                 sh:sparql [ sh:message "Handshake reports services delivered for a request that was declined, withdrawn or expired." ;
                                             sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
                $this ucm:hasHandshakeFulfillment ?value .
                FILTER NOT EXISTS { ?value (skos:exactMatch|^skos:exactMatch)* ucm:FulfillmentNotStarted }
                $this ucm:negotiates+ ?request .
                ?request ucm:hasReferralDisposition|ucm:hasLifecycleState ?state .
                ?state (skos:exactMatch|^skos:exactMatch)* ?ended .
                FILTER (?ended IN (ucm:ReferralDeclined, ucm:ReferralWithdrawn, ucm:ReferralExpired))
            }"""
                                           ] ;
                                 sh:targetSubjectsOf ucm:hasHandshakeFulfillment ;
                                 ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#HandoffStatus-anchored
ucm:HandoffStatus-anchored rdf:type owl:NamedIndividual ,
                                    sh:NodeShape ;
                           sh:severity sh:Warning ;
                           sh:sparql [ sh:message "Handoff status is neither in ucm:HandoffStatus nor SKOS-mapped to a concept that is." ;
                                       sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
                $this ucm:hasHandoffStatus ?value .
                FILTER NOT EXISTS { ?value skos:inScheme ucm:HandoffStatus }
                FILTER NOT EXISTS {
                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme
                           ucm:HandoffStatus
                }
            }"""
                                     ] ;
                           sh:targetSubjectsOf ucm:hasHandoffStatus ;
                           ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#HandoffStatus-single
ucm:HandoffStatus-single rdf:type owl:NamedIndividual ,
                                  sh:PropertyShape ;
                         sh:maxCount 1 ;
                         sh:message "A handshake holds at most one handoff status, identified by IRI." ;
                         sh:nodeKind sh:IRI ;
                         sh:path ucm:hasHandoffStatus ;
                         sh:severity sh:Violation ;
                         ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#HandoffStatusShape
ucm:HandoffStatusShape rdf:type owl:NamedIndividual ,
                                sh:NodeShape ;
                       sh:property ucm:HandoffStatus-single ;
                       sh:targetSubjectsOf ucm:hasHandoffStatus .


###  https://www.w3.org/ns/ucm#Handshake-negotiates
ucm:Handshake-negotiates rdf:type owl:NamedIndividual ,
                                  sh:PropertyShape ;
                         sh:message "A handshake negotiates participation in at least one process." ;
                         sh:minCount 1 ;
                         sh:nodeKind sh:BlankNodeOrIRI ;
                         sh:path ucm:negotiates ;
                         sh:severity sh:Violation ;
                         ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#HandshakeAcyclicShape
ucm:HandshakeAcyclicShape rdf:type owl:NamedIndividual ,
                                   sh:NodeShape ;
                          sh:severity sh:Violation ;
                          sh:sparql [ sh:message "Handshake negotiates itself, directly or through a chain: the negotiation has no base case." ;
                                      sh:select """
            PREFIX ucm: <https://www.w3.org/ns/ucm#>
            SELECT $this WHERE { $this ucm:negotiates+ $this }"""
                                    ] ;
                          sh:targetClass ucm:Handshake ;
                          ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#HandshakeFulfillment-anchored
ucm:HandshakeFulfillment-anchored rdf:type owl:NamedIndividual ,
                                           sh:NodeShape ;
                                  sh:severity sh:Warning ;
                                  sh:sparql [ sh:message "Handshake fulfillment is neither in ucm:HandshakeFulfillment nor SKOS-mapped to a concept that is." ;
                                              sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
                $this ucm:hasHandshakeFulfillment ?value .
                FILTER NOT EXISTS { ?value skos:inScheme ucm:HandshakeFulfillment }
                FILTER NOT EXISTS {
                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme
                           ucm:HandshakeFulfillment
                }
            }"""
                                            ] ;
                                  sh:targetSubjectsOf ucm:hasHandshakeFulfillment ;
                                  ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#HandshakeFulfillment-single
ucm:HandshakeFulfillment-single rdf:type owl:NamedIndividual ,
                                         sh:PropertyShape ;
                                sh:maxCount 1 ;
                                sh:message "A handshake holds at most one fulfillment state, identified by IRI." ;
                                sh:nodeKind sh:IRI ;
                                sh:path ucm:hasHandshakeFulfillment ;
                                sh:severity sh:Violation ;
                                ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#HandshakeFulfillmentShape
ucm:HandshakeFulfillmentShape rdf:type owl:NamedIndividual ,
                                       sh:NodeShape ;
                              sh:property ucm:HandshakeFulfillment-single ;
                              sh:targetSubjectsOf ucm:hasHandshakeFulfillment .


###  https://www.w3.org/ns/ucm#HandshakeShape
ucm:HandshakeShape rdf:type owl:NamedIndividual ,
                            sh:NodeShape ;
                   sh:property ucm:Handshake-negotiates ;
                   sh:targetClass ucm:Handshake .


###  https://www.w3.org/ns/ucm#LifecycleState-anchored
ucm:LifecycleState-anchored rdf:type owl:NamedIndividual ,
                                     sh:NodeShape ;
                            sh:severity sh:Warning ;
                            sh:sparql [ sh:message "Lifecycle state is neither in ucm:LifecycleState nor SKOS-mapped to a concept that is." ;
                                        sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
                $this ucm:hasLifecycleState ?value .
                FILTER NOT EXISTS { ?value skos:inScheme ucm:LifecycleState }
                FILTER NOT EXISTS {
                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme
                           ucm:LifecycleState
                }
            }"""
                                      ] ;
                            sh:targetSubjectsOf ucm:hasLifecycleState ;
                            ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#LifecycleState-single
ucm:LifecycleState-single rdf:type owl:NamedIndividual ,
                                   sh:PropertyShape ;
                          sh:maxCount 1 ;
                          sh:message "A process holds at most one lifecycle state, identified by IRI. (Relax to temporalized state assertions once those exist.)" ;
                          sh:nodeKind sh:IRI ;
                          sh:path ucm:hasLifecycleState ;
                          sh:severity sh:Violation ;
                          ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#LifecycleStateShape
ucm:LifecycleStateShape rdf:type owl:NamedIndividual ,
                                 sh:NodeShape ;
                        sh:property ucm:LifecycleState-single ;
                        sh:targetSubjectsOf ucm:hasLifecycleState .


###  https://www.w3.org/ns/ucm#Membership-group
ucm:Membership-group rdf:type owl:NamedIndividual ,
                              sh:PropertyShape ;
                     sh:maxCount 1 ;
                     sh:message "A membership is in exactly one social group." ;
                     sh:minCount 1 ;
                     sh:nodeKind sh:BlankNodeOrIRI ;
                     sh:path ucm:membershipIn ;
                     sh:severity sh:Violation ;
                     ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#Membership-groupType
ucm:Membership-groupType rdf:type owl:NamedIndividual ,
                                  sh:PropertyShape ;
                         sh:class ucm:SocialGroupEntity ;
                         sh:message "Membership target is not typed as ucm:SocialGroupEntity." ;
                         sh:path ucm:membershipIn ;
                         sh:severity sh:Warning ;
                         ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#Membership-member
ucm:Membership-member rdf:type owl:NamedIndividual ,
                               sh:PropertyShape ;
                      sh:maxCount 1 ;
                      sh:message "A membership belongs to exactly one member entity (via hasMembership)." ;
                      sh:minCount 1 ;
                      sh:path [ sh:inversePath ucm:hasMembership
                              ] ;
                      sh:severity sh:Violation ;
                      ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#MembershipShape
ucm:MembershipShape rdf:type owl:NamedIndividual ,
                             sh:NodeShape ;
                    sh:property ucm:Membership-group ,
                                ucm:Membership-groupType ,
                                ucm:Membership-member ;
                    sh:targetClass ucm:Membership .


###  https://www.w3.org/ns/ucm#Participation-context
ucm:Participation-context rdf:type owl:NamedIndividual ,
                                   sh:PropertyShape ;
                          sh:class ucm:SemanticContext ;
                          sh:message "Participation context is not typed as ucm:SemanticContext." ;
                          sh:path [ sh:alternativePath ( ucm:participationContext ucm:scopedBy )
                          ] ;
sh:severity sh:Warning ;
ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#Participation-entity
ucm:Participation-entity rdf:type owl:NamedIndividual ,
                                  sh:PropertyShape ;
                         sh:maxCount 1 ;
                         sh:message "A participation has exactly one participating entity, which must be a node, not a literal." ;
                         sh:minCount 1 ;
                         sh:nodeKind sh:BlankNodeOrIRI ;
                         sh:path ucm:participatingEntity ;
                         sh:severity sh:Violation ;
                         ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#Participation-entityType
ucm:Participation-entityType rdf:type owl:NamedIndividual ,
                                      sh:PropertyShape ;
                             sh:class ucm:Entity ;
                             sh:message "Participating entity is not typed as ucm:Entity or a subclass. Assert a UCM type, or validate with OWL RL inference if it is typed in a mapped ontology." ;
                             sh:path ucm:participatingEntity ;
                             sh:severity sh:Warning ;
                             ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#Participation-process
ucm:Participation-process rdf:type owl:NamedIndividual ,
                                   sh:PropertyShape ;
                          sh:maxCount 1 ;
                          sh:message "A participation occurs within exactly one process." ;
                          sh:minCount 1 ;
                          sh:nodeKind sh:BlankNodeOrIRI ;
                          sh:path ucm:occursWithin ;
                          sh:severity sh:Violation ;
                          ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#Participation-processType
ucm:Participation-processType rdf:type owl:NamedIndividual ,
                                       sh:PropertyShape ;
                              sh:class ucm:Process ;
                              sh:message "The process a participation occurs within is not typed as ucm:Process." ;
                              sh:path ucm:occursWithin ;
                              sh:severity sh:Warning ;
                              ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#Participation-role
ucm:Participation-role rdf:type owl:NamedIndividual ,
                                sh:PropertyShape ;
                       sh:class ucm:Role ;
                       sh:message "Assumed role is not typed as ucm:Role." ;
                       sh:path ucm:assumesRole ;
                       sh:severity sh:Warning ;
                       ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#Participation-validFrom
ucm:Participation-validFrom rdf:type owl:NamedIndividual ,
                                     sh:PropertyShape ;
                            sh:maxCount 1 ;
                            sh:message "validFrom is single-valued and must be xsd:dateTime or xsd:dateTimeStamp." ;
                            sh:or ( [ sh:datatype xsd:dateTime ] [ sh:datatype xsd:dateTimeStamp ] ) ;
sh:path ucm:validFrom ;
sh:severity sh:Violation ;
ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#Participation-validTo
ucm:Participation-validTo rdf:type owl:NamedIndividual ,
                                   sh:PropertyShape ;
                          sh:maxCount 1 ;
                          sh:message "validTo is single-valued and must be xsd:dateTime or xsd:dateTimeStamp." ;
                          sh:or ( [ sh:datatype xsd:dateTime ] [ sh:datatype xsd:dateTimeStamp ] ) ;
sh:path ucm:validTo ;
sh:severity sh:Violation ;
ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ParticipationEntityConsistencyShape
ucm:ParticipationEntityConsistencyShape rdf:type owl:NamedIndividual ,
                                                 sh:NodeShape ;
                                        sh:severity sh:Violation ;
                                        sh:sparql [ sh:message "An entity participates through this participation via participatesThrough, but the participation names a different participating entity." ;
                                                    sh:select """
            PREFIX ucm: <https://www.w3.org/ns/ucm#>
            SELECT $this WHERE {
                ?claimant ucm:participatesThrough $this .
                $this ucm:participatingEntity ?actual .
                FILTER (?claimant != ?actual)
            }"""
                                                  ] ;
                                        sh:targetClass ucm:Participation ;
                                        ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ParticipationProcessConsistencyShape
ucm:ParticipationProcessConsistencyShape rdf:type owl:NamedIndividual ,
                                                  sh:NodeShape ;
                                         sh:severity sh:Violation ;
                                         sh:sparql [ sh:message "A process lists this participation via hasParticipant, but the participation occurs within a different process." ;
                                                     sh:select """
            PREFIX ucm: <https://www.w3.org/ns/ucm#>
            SELECT $this WHERE {
                ?claimant ucm:hasParticipant $this .
                $this ucm:occursWithin ?actual .
                FILTER (?claimant != ?actual)
            }"""
                                                   ] ;
                                         sh:targetClass ucm:Participation ;
                                         ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ParticipationShape
ucm:ParticipationShape rdf:type owl:NamedIndividual ,
                                sh:NodeShape ;
                       sh:property ucm:Participation-context ,
                                   ucm:Participation-entity ,
                                   ucm:Participation-entityType ,
                                   ucm:Participation-process ,
                                   ucm:Participation-processType ,
                                   ucm:Participation-role ,
                                   ucm:Participation-validFrom ,
                                   ucm:Participation-validTo ;
                       sh:targetClass ucm:Participation .


###  https://www.w3.org/ns/ucm#ParticipationValidityShape
ucm:ParticipationValidityShape rdf:type owl:NamedIndividual ,
                                        sh:NodeShape ;
                               sh:severity sh:Violation ;
                               sh:sparql [ sh:message "Participation validTo precedes validFrom." ;
                                           sh:select """
            PREFIX ucm: <https://www.w3.org/ns/ucm#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this ucm:validFrom ?f ; ucm:validTo ?t .
                FILTER (xsd:dateTime(STR(?t)) < xsd:dateTime(STR(?f)))
            }"""
                                         ] ;
                               sh:targetClass ucm:Participation ;
                               ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ProjectionBackingShape
ucm:ProjectionBackingShape rdf:type owl:NamedIndividual ,
                                    sh:NodeShape ;
                           sh:severity sh:Warning ;
                           sh:sparql [ sh:message "Convenience projection (hasClient/hasPatient/hasResident) has no backing participation with the matching role." ;
                                       sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this WHERE {
                # UNION, not VALUES: SHACL forbids VALUES in SPARQL constraints.
                { $this ucm:hasClient   ?person . BIND (ucm:ClientRole   AS ?roleClass) }
                UNION
                { $this ucm:hasPatient  ?person . BIND (ucm:PatientRole  AS ?roleClass) }
                UNION
                { $this ucm:hasResident ?person . BIND (ucm:ResidentRole AS ?roleClass) }
                FILTER NOT EXISTS {
                    ?p ucm:participatingEntity ?person ;
                       ucm:assumesRole/a/rdfs:subClassOf* ?roleClass .
                    { ?p ucm:occursWithin $this } UNION { $this ucm:hasParticipant ?p }
                }
            }"""
                                     ] ;
                           sh:targetSubjectsOf ucm:hasClient ,
                                               ucm:hasPatient ,
                                               ucm:hasResident ;
                           ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#Recommended
ucm:Recommended rdf:type owl:NamedIndividual ,
                         skos:Concept ;
                skos:definition "Failing data is conformant but omits encouraged practice. Reported as sh:Warning."@en ;
                skos:prefLabel "Recommended"@en .


###  https://www.w3.org/ns/ucm#ReferralDisposition-anchored
ucm:ReferralDisposition-anchored rdf:type owl:NamedIndividual ,
                                          sh:NodeShape ;
                                 sh:severity sh:Warning ;
                                 sh:sparql [ sh:message "Referral disposition is neither in ucm:ReferralDisposition nor SKOS-mapped to a concept that is." ;
                                             sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
                $this ucm:hasReferralDisposition ?value .
                FILTER NOT EXISTS { ?value skos:inScheme ucm:ReferralDisposition }
                FILTER NOT EXISTS {
                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme
                           ucm:ReferralDisposition
                }
            }"""
                                           ] ;
                                 sh:targetSubjectsOf ucm:hasReferralDisposition ;
                                 ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#ReferralDisposition-single
ucm:ReferralDisposition-single rdf:type owl:NamedIndividual ,
                                        sh:PropertyShape ;
                               sh:maxCount 1 ;
                               sh:message "A coordination request holds at most one referral disposition, identified by IRI." ;
                               sh:nodeKind sh:IRI ;
                               sh:path ucm:hasReferralDisposition ;
                               sh:severity sh:Violation ;
                               ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ReferralDispositionShape
ucm:ReferralDispositionShape rdf:type owl:NamedIndividual ,
                                      sh:NodeShape ;
                             sh:property ucm:ReferralDisposition-single ;
                             sh:targetSubjectsOf ucm:hasReferralDisposition .


###  https://www.w3.org/ns/ucm#Statement-context
ucm:Statement-context rdf:type owl:NamedIndividual ,
                               sh:PropertyShape ;
                      sh:message "Statement declares no semantic context; its interpretation depends on one." ;
                      sh:minCount 1 ;
                      sh:path ucm:madeWithinContext ;
                      sh:severity sh:Warning ;
                      ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#Statement-date
ucm:Statement-date rdf:type owl:NamedIndividual ,
                            sh:PropertyShape ;
                   sh:maxCount 1 ;
                   sh:message "A statement is made once: statementDate is single-valued and must be xsd:dateTime or xsd:dateTimeStamp." ;
                   sh:or ( [ sh:datatype xsd:dateTime ] [ sh:datatype xsd:dateTimeStamp ] ) ;
sh:path ucm:statementDate ;
sh:severity sh:Violation ;
ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#Statement-processType
ucm:Statement-processType rdf:type owl:NamedIndividual ,
                                   sh:PropertyShape ;
                          sh:class ucm:Process ;
                          sh:message "Generating process is not typed as ucm:Process." ;
                          sh:path ucm:generatedByProcess ;
                          sh:severity sh:Warning ;
                          ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#Statement-subjectType
ucm:Statement-subjectType rdf:type owl:NamedIndividual ,
                                   sh:PropertyShape ;
                          sh:class ucm:Participation ;
                          sh:message "Statement subject is not typed as ucm:Participation." ;
                          sh:path ucm:statementSubject ;
                          sh:severity sh:Warning ;
                          ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#StatementShape
ucm:StatementShape rdf:type owl:NamedIndividual ,
                            sh:NodeShape ;
                   sh:property ucm:Statement-context ,
                               ucm:Statement-date ,
                               ucm:Statement-processType ,
                               ucm:Statement-subjectType ;
                   sh:targetClass ucm:Statement .


###  https://www.w3.org/ns/ucm#TemporalEntityShape
ucm:TemporalEntityShape rdf:type owl:NamedIndividual ,
                                 sh:NodeShape ;
                        sh:message "Temporal context must be an OWL-Time entity, not a literal. Wrap a bare timestamp in a time:Instant." ;
                        sh:nodeKind sh:BlankNodeOrIRI ;
                        sh:severity sh:Violation ;
                        sh:targetObjectsOf ucm:dataPeriod ,
                                           ucm:enactiveDuring ,
                                           ucm:hasTemporalContext ,
                                           ucm:occursDuring ,
                                           ucm:validDuring ;
                        ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#TemporalOrderShape
ucm:TemporalOrderShape rdf:type owl:NamedIndividual ,
                                sh:NodeShape ;
                       sh:severity sh:Violation ;
                       sh:sparql [ sh:message "Interval ends before it begins." ;
                                   sh:select """
            PREFIX time: <http://www.w3.org/2006/time#>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this time:hasBeginning/(time:inXSDDateTimeStamp|time:inXSDDateTime) ?b ;
                      time:hasEnd/(time:inXSDDateTimeStamp|time:inXSDDateTime) ?e .
                FILTER (xsd:dateTime(STR(?e)) < xsd:dateTime(STR(?b)))
            }"""
                                 ] ;
                       sh:targetObjectsOf ucm:dataPeriod ,
                                          ucm:enactiveDuring ,
                                          ucm:hasTemporalContext ,
                                          ucm:occursDuring ,
                                          ucm:validDuring ;
                       ucm:tier ucm:Definitional .


#################################################################
#    Consent and identity shapes (consent-concepts-plan, 2026-11-27)
#################################################################

###  https://www.w3.org/ns/ucm#ConsentDirective-decision
ucm:ConsentDirective-decision rdf:type owl:NamedIndividual ,
                                       sh:PropertyShape ;
                              sh:maxCount 1 ;
                              sh:minCount 1 ;
                              sh:nodeKind sh:IRI ;
                              sh:message "A consent directive has exactly one decision, permit or deny, identified by IRI." ;
                              sh:path ucm:hasConsentDecision ;
                              sh:severity sh:Violation ;
                              ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ConsentDirective-subject
ucm:ConsentDirective-subject rdf:type owl:NamedIndividual ,
                                      sh:PropertyShape ;
                             sh:minCount 1 ;
                             sh:nodeKind sh:BlankNodeOrIRI ;
                             sh:message "A consent directive names at least one subject participation, which must be a node, not a literal." ;
                             sh:path ucm:consentSubject ;
                             sh:severity sh:Violation ;
                             ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ConsentDirective-validity
ucm:ConsentDirective-validity rdf:type owl:NamedIndividual ,
                                       sh:PropertyShape ;
                              sh:minCount 1 ;
                              sh:message "Consent directive states no period of validity. Open-ended consent is allowed but should be deliberate." ;
                              sh:path ucm:validDuring ;
                              sh:severity sh:Warning ;
                              ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#ConsentDirectiveShape
ucm:ConsentDirectiveShape rdf:type owl:NamedIndividual ,
                                   sh:NodeShape ;
                          sh:property ucm:ConsentDirective-decision ,
                                      ucm:ConsentDirective-subject ,
                                      ucm:ConsentDirective-validity ;
                          sh:targetClass ucm:ConsentDirective .


###  https://www.w3.org/ns/ucm#ConsentProvision-decision
ucm:ConsentProvision-decision rdf:type owl:NamedIndividual ,
                                       sh:PropertyShape ;
                              sh:maxCount 1 ;
                              sh:minCount 1 ;
                              sh:nodeKind sh:IRI ;
                              sh:message "Every consent provision states exactly one decision, permit or deny, identified by IRI." ;
                              sh:path ucm:hasConsentDecision ;
                              sh:severity sh:Violation ;
                              ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ConsentProvisionShape
ucm:ConsentProvisionShape rdf:type owl:NamedIndividual ,
                                   sh:NodeShape ;
                          sh:property ucm:ConsentProvision-decision ;
                          sh:targetClass ucm:ConsentProvision .


###  https://www.w3.org/ns/ucm#ConsentStatus-single
ucm:ConsentStatus-single rdf:type owl:NamedIndividual ,
                                  sh:PropertyShape ;
                         sh:maxCount 1 ;
                         sh:nodeKind sh:IRI ;
                         sh:message "A consent directive holds at most one consent status, identified by IRI." ;
                         sh:path ucm:hasConsentStatus ;
                         sh:severity sh:Violation ;
                         ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ConsentStatusShape
ucm:ConsentStatusShape rdf:type owl:NamedIndividual ,
                                sh:NodeShape ;
                       sh:property ucm:ConsentStatus-single ;
                       sh:targetSubjectsOf ucm:hasConsentStatus .


###  https://www.w3.org/ns/ucm#ConsentCategory-single
ucm:ConsentCategory-single rdf:type owl:NamedIndividual ,
                                    sh:PropertyShape ;
                           sh:maxCount 1 ;
                           sh:nodeKind sh:IRI ;
                           sh:message "A consent directive holds at most one consent category, identified by IRI." ;
                           sh:path ucm:hasConsentCategory ;
                           sh:severity sh:Violation ;
                           ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ConsentCategoryShape
ucm:ConsentCategoryShape rdf:type owl:NamedIndividual ,
                                  sh:NodeShape ;
                         sh:property ucm:ConsentCategory-single ;
                         sh:targetSubjectsOf ucm:hasConsentCategory .


###  https://www.w3.org/ns/ucm#ConsentModality-single
ucm:ConsentModality-single rdf:type owl:NamedIndividual ,
                                    sh:PropertyShape ;
                           sh:maxCount 1 ;
                           sh:nodeKind sh:IRI ;
                           sh:message "A consent interaction holds at most one modality, identified by IRI." ;
                           sh:path ucm:hasConsentModality ;
                           sh:severity sh:Violation ;
                           ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ConsentModalityShape
ucm:ConsentModalityShape rdf:type owl:NamedIndividual ,
                                  sh:NodeShape ;
                         sh:property ucm:ConsentModality-single ;
                         sh:targetSubjectsOf ucm:hasConsentModality .


###  https://www.w3.org/ns/ucm#ConsentInteractionType-single
ucm:ConsentInteractionType-single rdf:type owl:NamedIndividual ,
                                           sh:PropertyShape ;
                                  sh:maxCount 1 ;
                                  sh:nodeKind sh:IRI ;
                                  sh:message "A consent interaction holds at most one interaction type, identified by IRI." ;
                                  sh:path ucm:hasConsentInteractionType ;
                                  sh:severity sh:Violation ;
                                  ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ConsentInteractionTypeShape
ucm:ConsentInteractionTypeShape rdf:type owl:NamedIndividual ,
                                         sh:NodeShape ;
                                sh:property ucm:ConsentInteractionType-single ;
                                sh:targetSubjectsOf ucm:hasConsentInteractionType .


###  https://www.w3.org/ns/ucm#RetentionDisposition-single
ucm:RetentionDisposition-single rdf:type owl:NamedIndividual ,
                                         sh:PropertyShape ;
                                sh:maxCount 1 ;
                                sh:nodeKind sh:IRI ;
                                sh:message "A consent directive or provision holds at most one retention disposition, identified by IRI." ;
                                sh:path ucm:hasRetentionDisposition ;
                                sh:severity sh:Violation ;
                                ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#RetentionDispositionShape
ucm:RetentionDispositionShape rdf:type owl:NamedIndividual ,
                                       sh:NodeShape ;
                              sh:property ucm:RetentionDisposition-single ;
                              sh:targetSubjectsOf ucm:hasRetentionDisposition .


###  https://www.w3.org/ns/ucm#BirthDateQuality-single
ucm:BirthDateQuality-single rdf:type owl:NamedIndividual ,
                                     sh:PropertyShape ;
                            sh:maxCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:message "A person holds at most one birth date quality, identified by IRI." ;
                            sh:path ucm:birthDateQuality ;
                            sh:severity sh:Violation ;
                            ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#BirthDateQualityShape
ucm:BirthDateQualityShape rdf:type owl:NamedIndividual ,
                                   sh:NodeShape ;
                          sh:property ucm:BirthDateQuality-single ;
                          sh:targetSubjectsOf ucm:birthDateQuality .


###  https://www.w3.org/ns/ucm#AchievedAAL-single
ucm:AchievedAAL-single rdf:type owl:NamedIndividual ,
                                sh:PropertyShape ;
                       sh:maxCount 1 ;
                       sh:nodeKind sh:IRI ;
                       sh:message "An authentication reaches at most one authenticator assurance level, identified by IRI." ;
                       sh:path ucm:achievedAAL ;
                       sh:severity sh:Violation ;
                       ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#AchievedAALShape
ucm:AchievedAALShape rdf:type owl:NamedIndividual ,
                              sh:NodeShape ;
                     sh:property ucm:AchievedAAL-single ;
                     sh:targetSubjectsOf ucm:achievedAAL .


###  https://www.w3.org/ns/ucm#AchievedFAL-single
ucm:AchievedFAL-single rdf:type owl:NamedIndividual ,
                                sh:PropertyShape ;
                       sh:maxCount 1 ;
                       sh:nodeKind sh:IRI ;
                       sh:message "An identity assertion reaches at most one federation assurance level, identified by IRI." ;
                       sh:path ucm:achievedFAL ;
                       sh:severity sh:Violation ;
                       ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#AchievedFALShape
ucm:AchievedFALShape rdf:type owl:NamedIndividual ,
                              sh:NodeShape ;
                     sh:property ucm:AchievedFAL-single ;
                     sh:targetSubjectsOf ucm:achievedFAL .


###  https://www.w3.org/ns/ucm#ProofingType-single
ucm:ProofingType-single rdf:type owl:NamedIndividual ,
                                 sh:PropertyShape ;
                        sh:maxCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:message "An identity proofing has at most one proofing type, identified by IRI." ;
                        sh:path ucm:hasProofingType ;
                        sh:severity sh:Violation ;
                        ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ProofingTypeShape
ucm:ProofingTypeShape rdf:type owl:NamedIndividual ,
                               sh:NodeShape ;
                      sh:property ucm:ProofingType-single ;
                      sh:targetSubjectsOf ucm:hasProofingType .


###  https://www.w3.org/ns/ucm#IdentifierType-single
ucm:IdentifierType-single rdf:type owl:NamedIndividual ,
                                   sh:PropertyShape ;
                          sh:maxCount 1 ;
                          sh:nodeKind sh:IRI ;
                          sh:message "An identifier has at most one identifier type, identified by IRI." ;
                          sh:path ucm:hasIdentifierType ;
                          sh:severity sh:Violation ;
                          ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#IdentifierTypeShape
ucm:IdentifierTypeShape rdf:type owl:NamedIndividual ,
                                 sh:NodeShape ;
                        sh:property ucm:IdentifierType-single ;
                        sh:targetSubjectsOf ucm:hasIdentifierType .


###  https://www.w3.org/ns/ucm#ConfidentialityLevel-single
ucm:ConfidentialityLevel-single rdf:type owl:NamedIndividual ,
                                         sh:PropertyShape ;
                                sh:maxCount 1 ;
                                sh:nodeKind sh:IRI ;
                                sh:message "Information holds at most one confidentiality level, identified by IRI." ;
                                sh:path ucm:hasConfidentialityLevel ;
                                sh:severity sh:Violation ;
                                ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ConfidentialityLevelShape
ucm:ConfidentialityLevelShape rdf:type owl:NamedIndividual ,
                                       sh:NodeShape ;
                              sh:property ucm:ConfidentialityLevel-single ;
                              sh:targetSubjectsOf ucm:hasConfidentialityLevel .


###  https://www.w3.org/ns/ucm#Person-birthDate
ucm:Person-birthDate rdf:type owl:NamedIndividual ,
                              sh:PropertyShape ;
                     sh:maxCount 1 ;
                     sh:message "A person has at most one birth date, typed xsd:date, xsd:gYearMonth or xsd:gYear." ;
                     sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:gYearMonth ] [ sh:datatype xsd:gYear ] ) ;
                     sh:path ucm:birthDate ;
                     sh:severity sh:Violation ;
                     ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#PersonBirthDateShape
ucm:PersonBirthDateShape rdf:type owl:NamedIndividual ,
                                  sh:NodeShape ;
                         sh:property ucm:Person-birthDate ;
                         sh:targetSubjectsOf ucm:birthDate .


###  https://www.w3.org/ns/ucm#SelfConsentRule-age
ucm:SelfConsentRule-age rdf:type owl:NamedIndividual ,
                                 sh:PropertyShape ;
                        sh:datatype xsd:nonNegativeInteger ;
                        sh:maxCount 1 ;
                        sh:message "A self-consent rule states at most one minimum age, a non-negative integer." ;
                        sh:path ucm:minimumSelfConsentAge ;
                        sh:severity sh:Violation ;
                        ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#SelfConsentRuleAgeShape
ucm:SelfConsentRuleAgeShape rdf:type owl:NamedIndividual ,
                                     sh:NodeShape ;
                            sh:property ucm:SelfConsentRule-age ;
                            sh:targetSubjectsOf ucm:minimumSelfConsentAge .


###  https://www.w3.org/ns/ucm#RetentionPeriod-value
ucm:RetentionPeriod-value rdf:type owl:NamedIndividual ,
                                   sh:PropertyShape ;
                          sh:datatype xsd:duration ;
                          sh:maxCount 1 ;
                          sh:message "Retention period is single-valued and must be an xsd:duration, such as P7Y." ;
                          sh:path ucm:retentionPeriod ;
                          sh:severity sh:Violation ;
                          ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#RetentionPeriodShape
ucm:RetentionPeriodShape rdf:type owl:NamedIndividual ,
                                  sh:NodeShape ;
                         sh:property ucm:RetentionPeriod-value ;
                         sh:targetSubjectsOf ucm:retentionPeriod .


###  https://www.w3.org/ns/ucm#WithdrawalMethod-value
ucm:WithdrawalMethod-value rdf:type owl:NamedIndividual ,
                                    sh:PropertyShape ;
                           sh:datatype xsd:string ;
                           sh:message "Withdrawal method must be text (xsd:string); a link is written as text." ;
                           sh:path ucm:withdrawalMethod ;
                           sh:severity sh:Violation ;
                           ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#WithdrawalMethodShape
ucm:WithdrawalMethodShape rdf:type owl:NamedIndividual ,
                                   sh:NodeShape ;
                          sh:property ucm:WithdrawalMethod-value ;
                          sh:targetSubjectsOf ucm:withdrawalMethod .


###  https://www.w3.org/ns/ucm#Identifier-value
ucm:Identifier-value rdf:type owl:NamedIndividual ,
                              sh:PropertyShape ;
                     sh:datatype xsd:string ;
                     sh:maxCount 1 ;
                     sh:minCount 1 ;
                     sh:message "An identifier has exactly one value, an xsd:string." ;
                     sh:path ucm:identifierValue ;
                     sh:severity sh:Violation ;
                     ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#Identifier-system
ucm:Identifier-system rdf:type owl:NamedIndividual ,
                               sh:PropertyShape ;
                      sh:datatype xsd:anyURI ;
                      sh:maxCount 1 ;
                      sh:message "An identifier has at most one system, an xsd:anyURI." ;
                      sh:path ucm:identifierSystem ;
                      sh:severity sh:Violation ;
                      ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#IdentifierShape
ucm:IdentifierShape rdf:type owl:NamedIndividual ,
                             sh:NodeShape ;
                    sh:property ucm:Identifier-system ,
                                ucm:Identifier-value ;
                    sh:targetClass ucm:Identifier .


###  https://www.w3.org/ns/ucm#Credential-validity
ucm:Credential-validity rdf:type owl:NamedIndividual ,
                                 sh:PropertyShape ;
                        sh:minCount 1 ;
                        sh:message "Credential states no period of validity (W3C VC validFrom and validUntil)." ;
                        sh:path ucm:validDuring ;
                        sh:severity sh:Warning ;
                        ucm:tier ucm:Recommended .


###  https://www.w3.org/ns/ucm#CredentialShape
ucm:CredentialShape rdf:type owl:NamedIndividual ,
                             sh:NodeShape ;
                    sh:property ucm:Credential-validity ;
                    sh:targetClass ucm:Credential .


###  https://www.w3.org/ns/ucm#ProvisionAlternationShape
ucm:ProvisionAlternationShape rdf:type owl:NamedIndividual ,
                                       sh:NodeShape ;
                              sh:severity sh:Violation ;
                              sh:sparql [ sh:message "A provision's decision must be the opposite of its parent's (the directive for a top-level provision, or the enclosing provision)." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
                ?parent ucm:hasProvision $this ;
                        ucm:hasConsentDecision ?pd .
                $this ucm:hasConsentDecision ?value .
                ?pd    (skos:exactMatch|^skos:exactMatch)* ?pn .
                ?value (skos:exactMatch|^skos:exactMatch)* ?vn .
                FILTER (?pn IN (ucm:Permit, ucm:Deny) && ?pn = ?vn)
            }"""
              ] ;
                              sh:targetObjectsOf ucm:hasProvision ;
                              ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#ProvisionAcyclicShape
ucm:ProvisionAcyclicShape rdf:type owl:NamedIndividual ,
                                   sh:NodeShape ;
                          sh:severity sh:Violation ;
                          sh:sparql [ sh:message "Provision contains itself, directly or through nested provisions." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            SELECT $this WHERE { $this ucm:hasProvision+ $this }"""
              ] ;
                          sh:targetObjectsOf ucm:hasProvision ;
                          ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#SupersedesAcyclicShape
ucm:SupersedesAcyclicShape rdf:type owl:NamedIndividual ,
                                    sh:NodeShape ;
                           sh:severity sh:Violation ;
                           sh:sparql [ sh:message "Consent directive supersedes itself, directly or through a chain." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            SELECT $this WHERE { $this ucm:supersedes+ $this }"""
              ] ;
                           sh:targetSubjectsOf ucm:supersedes ;
                           ucm:tier ucm:Definitional .


###  https://www.w3.org/ns/ucm#JurisdictionAcyclicShape
ucm:JurisdictionAcyclicShape rdf:type owl:NamedIndividual ,
                                      sh:NodeShape ;
