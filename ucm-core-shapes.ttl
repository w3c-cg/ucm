###  https://www.w3.org/ns/ucm#ConsentStatus-anchored
ucm:ConsentStatus-anchored rdf:type owl:NamedIndividual ,
                                    sh:NodeShape ;
                           sh:severity sh:Warning ;
                           sh:sparql [ sh:message "Consent status is neither in ucm:ConsentStatus nor SKOS-mapped to a concept that is." ;
                sh:select """
            PREFIX ucm:  <https://www.w3.org/ns/ucm#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?value WHERE {
                $this ucm:hasConsentStatus ?value .
                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:ConsentStatus)) }
                FILTER NOT EXISTS {
                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .
                    FILTER (?m IN (ucm:ConsentStatus))
                }
            }"""
              ] ;
                           sh:targetSubjectsOf ucm:hasConsentStatus ;
                           ucm:tier ucm:Recommended .


