            SELECT $this ?value WHERE {
                $this ucm:hasIdentifierType ?value .
                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:IdentifierType)) }
                FILTER NOT EXISTS {
                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .
                    FILTER (?m IN (ucm:IdentifierType))
                }
            }"""
              ] ;
                            sh:targetSubjectsOf ucm:hasIdentifierType ;
