###  https://www.w3.org/ns/ucm#TemporalEntityShape
ucmsh:TemporalEntityShape rdf:type owl:NamedIndividual ,
                                   sh:NodeShape ;
                          sh:message "Temporal context must be an OWL-Time entity, not a literal. Wrap a bare timestamp in a time:Instant." ;
                          sh:nodeKind sh:BlankNodeOrIRI ;
                          sh:severity sh:Violation ;
                          sh:targetObjectsOf ucmsh:enactiveDuring ,
                                             ucmsh:hasTemporalContext ,
                                             ucmsh:occursDuring ,
                                             ucmsh:validDuring ;
                          ucmsh:tier ucmsh:Definitional .


###  https://www.w3.org/ns/ucm#TemporalOrderShape
ucmsh:TemporalOrderShape rdf:type owl:NamedIndividual ,
                                  sh:NodeShape ;
                         sh:severity sh:Violation ;
                         sh:sparql [ sh:message "Interval ends before it begins." ;
                                     sh:select """
            PREFIX time: <http://www.w3.org/2006/time#>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this time:hasBeginning/(time:inXSDDateTimeStamp|time:inXSDDateTime) ?b ;
                      time:hasEnd/(time:inXSDDateTimeStamp|time:inXSDDateTime) ?e .
                FILTER (xsd:dateTime(STR(?e)) < xsd:dateTime(STR(?b)))
            }"""
                                   ] ;
                         sh:targetObjectsOf ucmsh:enactiveDuring ,
                                            ucmsh:hasTemporalContext ,
                                            ucmsh:occursDuring ,
                                            ucmsh:validDuring ;
                         ucmsh:tier ucmsh:Definitional .


