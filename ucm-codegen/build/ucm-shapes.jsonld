        "@id": "sh:Violation"
      },
      "ucm:tier": {
        "@id": "ucm:Definitional"
      }
    },
    {
      "@id": "ucm:ReferralDispositionShape",
      "@type": "sh:NodeShape",
      "sh:property": {
        "@id": "ucm:ReferralDisposition-single"
      },
      "sh:targetSubjectsOf": {
        "@id": "ucm:hasReferralDisposition"
      }
    },
    {
      "@id": "ucm:Statement-context",
      "@type": "sh:PropertyShape",
      "sh:message": "Statement declares no semantic context; its interpretation depends on one.",
      "sh:minCount": {
        "@type": "xsd:integer",
        "@value": "1"
      },
      "sh:path": {
        "@id": "ucm:madeWithinContext"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "ucm:Statement-date",
      "@type": "sh:PropertyShape",
      "sh:maxCount": {
        "@type": "xsd:integer",
        "@value": "1"
      },
      "sh:message": "A statement is made once: statementDate is single-valued and must be xsd:dateTime or xsd:dateTimeStamp.",
      "sh:or": {
        "@list": [
          {
            "@id": "_:c14n28"
          },
          {
            "@id": "_:c14n36"
          }
        ]
      },
      "sh:path": {
        "@id": "ucm:statementDate"
      },
      "sh:severity": {
        "@id": "sh:Violation"
      },
      "ucm:tier": {
        "@id": "ucm:Definitional"
      }
    },
    {
      "@id": "ucm:Statement-processType",
      "@type": "sh:PropertyShape",
      "sh:class": {
        "@id": "ucm:Process"
      },
      "sh:message": "Generating process is not typed as ucm:Process.",
      "sh:path": {
        "@id": "ucm:generatedByProcess"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "ucm:Statement-subjectType",
      "@type": "sh:PropertyShape",
      "sh:class": {
        "@id": "ucm:Participation"
      },
      "sh:message": "Statement subject is not typed as ucm:Participation.",
      "sh:path": {
        "@id": "ucm:statementSubject"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "ucm:StatementShape",
      "@type": "sh:NodeShape",
      "sh:property": [
        {
          "@id": "ucm:Statement-context"
        },
        {
          "@id": "ucm:Statement-date"
        },
        {
          "@id": "ucm:Statement-processType"
        },
        {
          "@id": "ucm:Statement-subjectType"
        }
      ],
      "sh:targetClass": {
        "@id": "ucm:Statement"
      }
    },
    {
      "@id": "ucm:TemporalEntityShape",
      "@type": "sh:NodeShape",
      "sh:message": "Temporal context must be an OWL-Time entity, not a literal. Wrap a bare timestamp in a time:Instant.",
      "sh:nodeKind": {
        "@id": "sh:BlankNodeOrIRI"
      },
      "sh:severity": {
        "@id": "sh:Violation"
      },
      "sh:targetObjectsOf": [
        {
          "@id": "ucm:enactiveDuring"
        },
        {
          "@id": "ucm:hasTemporalContext"
        },
        {
          "@id": "ucm:occursDuring"
        },
        {
          "@id": "ucm:validDuring"
        }
      ],
      "ucm:tier": {
        "@id": "ucm:Definitional"
      }
    },
    {
      "@id": "ucm:TemporalOrderShape",
      "@type": "sh:NodeShape",
      "sh:severity": {
        "@id": "sh:Violation"
      },
      "sh:sparql": {
        "@id": "_:c14n14"
      },
      "sh:targetObjectsOf": [
        {
          "@id": "ucm:enactiveDuring"
        },
        {
          "@id": "ucm:hasTemporalContext"
        },
        {
          "@id": "ucm:occursDuring"
        },
        {
          "@id": "ucm:validDuring"
        }
      ],
      "ucm:tier": {
        "@id": "ucm:Definitional"
      }
    },
    {
      "@id": "ucm:shapes",
      "@type": "owl:Ontology",
      "rdfs:comment": "Validation shapes for the Unified Care Model core.\n\nCONVENTION\n  Open by default. No shape uses sh:closed: adopters' own predicates and\n  types (FHIR, HMIS, local data dictionaries, provenance) never produce results.\n\n  Two tiers, tagged with ucmsh:tier and enforced by ucm-shapes-lint.ttl:\n    ucmsh:Definitional  sh:Violation. The data is not a well-formed instance\n                        of the UCM concept: identity-forming edges missing or\n                        duplicated, literals where entities are required,\n                        intervals that end before they begin, cycles with no\n                        base case.\n    ucmsh:Recommended   sh:Warning. Good practice the spec encourages but a\n                        conformant adopter may not yet follow.\n\n  sh:severity is set on every property shape individually. SHACL does not\n  carry a node shape's severity down to its nested property shapes; an\n  untagged property shape reports sh:Violation.\n\n  Type constraints that mirror an rdfs:range (sh:class) are Recommended only.\n  Under RDFS/OWL inference they are vacuous; without inference they reject\n  data typed in a partner ontology. Structural kind (sh:nodeKind) is\n  Definitional, because it is decidable from the data alone.\n\n  Date and time values accept xsd:dateTime or xsd:dateTimeStamp. sh:datatype\n  xsd:dateTime alone rejects xsd:dateTimeStamp, the form OWL-Time recommends.\n  Ordering checks use SPARQL with explicit casts; sh:lessThanOrEquals crashes\n  pySHACL on misordered xsd:dateTimeStamp values.",
      "rdfs:label": "UCM Core Shapes (draft)",
      "owl:imports": {
        "@id": "https://www.w3.org/ns/ucm#"
      }
    },
    {
      "@id": "_:c14n0",
      "sh:class": {
        "@id": "ucm:CareTrajectoryContext"
      },
      "sh:message": "Care trajectory context is not typed as ucm:CareTrajectoryContext.",
      "sh:path": {
        "@id": "ucm:hasCareTrajectoryContext"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n1",
      "sh:class": {
        "@id": "ucm:ActivityFocus"
      },
      "sh:message": "Activity focus is not typed as ucm:ActivityFocus.",
      "sh:path": {
        "@id": "ucm:hasActivityFocus"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n10",
      "sh:message": "Participation uses both validFrom/validTo and enactiveDuring. The two encodings can diverge; prefer enactiveDuring.",
      "sh:select": "\n            PREFIX ucm: <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE {\n                $this ucm:enactiveDuring ?iv .\n                FILTER EXISTS { $this ucm:validFrom|ucm:validTo ?x }\n            }"
    },
    {
      "@id": "_:c14n11",
      "sh:message": "Handshake fulfillment is neither in ucm:HandshakeFulfillment nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasHandshakeFulfillment ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ucm:HandshakeFulfillment }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme\n                           ucm:HandshakeFulfillment\n                }\n            }"
    },
    {
      "@id": "_:c14n13",
      "sh:class": {
        "@id": "ucm:Participation"
      },
      "sh:message": "acceptsRequest target is not typed as ucm:Participation.",
      "sh:path": {
        "@id": "ucm:acceptsRequest"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n14",
      "sh:message": "Interval ends before it begins.",
      "sh:select": "\n            PREFIX time: <http://www.w3.org/2006/time#>\n            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>\n            SELECT $this WHERE {\n                $this time:hasBeginning/(time:inXSDDateTimeStamp|time:inXSDDateTime) ?b ;\n                      time:hasEnd/(time:inXSDDateTimeStamp|time:inXSDDateTime) ?e .\n                FILTER (xsd:dateTime(STR(?e)) < xsd:dateTime(STR(?b)))\n            }"
    },
    {
      "@id": "_:c14n15",
      "sh:alternativePath": {
        "@list": [
          {
            "@id": "ucm:participationContext"
          },
          {
            "@id": "ucm:scopedBy"
          }
        ]
      }
    },
    {
      "@id": "_:c14n16",
      "sh:message": "Commitment status is neither in ucm:CommitmentStatus nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasCommitmentStatus ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ucm:CommitmentStatus }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme\n                           ucm:CommitmentStatus\n                }\n            }"
    },
    {
      "@id": "_:c14n17",
      "sh:class": {
        "@id": "ucm:Organization"
      },
      "sh:message": "Affiliation target is not typed as ucm:Organization.",
      "sh:path": {
        "@id": "ucm:affiliatedWith"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n2",
      "sh:message": "Handshake reports services delivered for a request that was declined, withdrawn or expired.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasHandshakeFulfillment ?value .\n                FILTER NOT EXISTS { ?value (skos:exactMatch|^skos:exactMatch)* ucm:FulfillmentNotStarted }\n                $this ucm:negotiates+ ?request .\n                ?request ucm:hasReferralDisposition|ucm:hasLifecycleState ?state .\n                ?state (skos:exactMatch|^skos:exactMatch)* ?ended .\n                FILTER (?ended IN (ucm:ReferralDeclined, ucm:ReferralWithdrawn, ucm:ReferralExpired))\n            }"
    },
    {
      "@id": "_:c14n20",
      "sh:message": "Closure reason is neither in ucm:ClosureReason nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasClosureReason ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ucm:ClosureReason }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme\n                           ucm:ClosureReason\n                }\n            }"
    },
    {
      "@id": "_:c14n21",
      "sh:class": {
        "@id": "ucm:DefinitionArtifact"
      },
      "sh:message": "definedByArtifact target is not typed as ucm:DefinitionArtifact.",
      "sh:path": {
        "@id": "ucm:definedByArtifact"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n22",
      "sh:message": "Closure reason recorded on a request that is still pending a decision.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasReferralDisposition|ucm:hasLifecycleState ?value .\n                ?value (skos:exactMatch|^skos:exactMatch)* ucm:ReferralPending .\n            }"
    },
    {
      "@id": "_:c14n23",
      "sh:message": "Coordination process declares no activity focus, directly or through a process it negotiates.",
      "sh:select": "\n            PREFIX ucm: <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE {\n                FILTER NOT EXISTS { $this ucm:negotiates*/ucm:hasActivityFocus ?f }\n            }"
    },
    {
      "@id": "_:c14n24",
      "sh:message": "An entity participates through this participation via participatesThrough, but the participation names a different participating entity.",
      "sh:select": "\n            PREFIX ucm: <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE {\n                ?claimant ucm:participatesThrough $this .\n                $this ucm:participatingEntity ?actual .\n                FILTER (?claimant != ?actual)\n            }"
    },
    {
      "@id": "_:c14n25",
      "sh:message": "Handoff status is neither in ucm:HandoffStatus nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasHandoffStatus ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ucm:HandoffStatus }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme\n                           ucm:HandoffStatus\n                }\n            }"
    },
    {
      "@id": "_:c14n26",
      "sh:inversePath": {
        "@id": "ucm:hasMembership"
      }
    },
    {
      "@id": "_:c14n27",
      "sh:message": "Lifecycle state is neither in ucm:LifecycleState nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasLifecycleState ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ucm:LifecycleState }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme\n                           ucm:LifecycleState\n                }\n            }"
    },
    {
      "@id": "_:c14n28",
      "sh:datatype": {
        "@id": "xsd:dateTime"
      }
    },
    {
      "@id": "_:c14n29",
      "sh:datatype": {
        "@id": "xsd:dateTime"
      }
    },
    {
      "@id": "_:c14n3",
      "sh:message": "Handshake negotiates itself, directly or through a chain: the negotiation has no base case.",
      "sh:select": "\n            PREFIX ucm: <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE { $this ucm:negotiates+ $this }"
    },
    {
      "@id": "_:c14n30",
      "sh:datatype": {
        "@id": "xsd:dateTime"
      }
    },
    {
      "@id": "_:c14n32",
      "sh:datatype": {
        "@id": "xsd:dateTimeStamp"
      }
    },
    {
      "@id": "_:c14n34",
      "sh:datatype": {
        "@id": "xsd:dateTimeStamp"
      }
    },
    {
      "@id": "_:c14n36",
      "sh:datatype": {
        "@id": "xsd:dateTimeStamp"
      }
    },
    {
      "@id": "_:c14n4",
      "sh:message": "Referral disposition is neither in ucm:ReferralDisposition nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasReferralDisposition ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ucm:ReferralDisposition }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme\n                           ucm:ReferralDisposition\n                }\n            }"
    },
    {
      "@id": "_:c14n5",
      "sh:message": "Convenience projection (hasClient/hasPatient/hasResident) has no backing participation with the matching role.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n            SELECT $this WHERE {\n                # UNION, not VALUES: SHACL forbids VALUES in SPARQL constraints.\n                { $this ucm:hasClient   ?person . BIND (ucm:ClientRole   AS ?roleClass) }\n                UNION\n                { $this ucm:hasPatient  ?person . BIND (ucm:PatientRole  AS ?roleClass) }\n                UNION\n                { $this ucm:hasResident ?person . BIND (ucm:ResidentRole AS ?roleClass) }\n                FILTER NOT EXISTS {\n                    ?p ucm:participatingEntity ?person ;\n                       ucm:assumesRole/a/rdfs:subClassOf* ?roleClass .\n                    { ?p ucm:occursWithin $this } UNION { $this ucm:hasParticipant ?p }\n                }\n            }"
    },
    {
      "@id": "_:c14n8",
      "sh:message": "A process lists this participation via hasParticipant, but the participation occurs within a different process.",
      "sh:select": "\n            PREFIX ucm: <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE {\n                ?claimant ucm:hasParticipant $this .\n                $this ucm:occursWithin ?actual .\n                FILTER (?claimant != ?actual)\n            }"
    },
    {
      "@id": "_:c14n9",
      "sh:message": "Participation validTo precedes validFrom.",
      "sh:select": "\n            PREFIX ucm: <https://www.w3.org/ns/ucm#>\n            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n            SELECT $this WHERE {\n                $this ucm:validFrom ?f ; ucm:validTo ?t .\n                FILTER (xsd:dateTime(STR(?t)) < xsd:dateTime(STR(?f)))\n            }"
    }
  ]
}
