      "@id": "ucm:hasClosureReason",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": "Relates a closed care coordination request to the reason it was closed.",
      "rdfs:domain": {
        "@id": "ucm:CoordinationRequest"
      },
      "rdfs:label": "has closure reason",
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
