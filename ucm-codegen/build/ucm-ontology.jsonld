    "time": "http://www.w3.org/2006/time#",
    "dcterms": "http://purl.org/dc/terms/"
  },
  "@graph": [
    {
      "@id": "http://purl.bioontology.org/ontology/SNOMEDCT#337915000",
      "@type": "owl:Class",
      "rdfs:label": "Homo sapiens",
      "owl:equivalentClass": {
        "@id": "ucm:Person"
      }
    },
    {
      "@id": "http://purl.obolibrary.org/obo/NCBITaxon#9606",
      "@type": "owl:Class",
      "rdfs:label": "Homo sapiens",
      "owl:equivalentClass": {
        "@id": "ucm:Person"
      }
    },
    {
      "@id": "https://www.commoncoreontologies.org/AgentOntology#ont00001262",
      "@type": "owl:Class",
      "rdfs:label": "Person",
      "owl:equivalentClass": {
        "@id": "ucm:Person"
      },
      "skos:altLabel": "Human"
    },
    {
      "@id": "https://www.w3.org/ns/ucm#",
      "@type": "owl:Ontology",
      "rdfs:comment": "Complete UCM model including Core, Participation, and Domain semantic layers.",
      "rdfs:label": "Unified Care Model",
      "owl:versionIRI": {
        "@id": "ucm:0.0.1"
      },
      "owl:versionInfo": "v0.0.1"
    },
    {
      "@id": "skos:altLabel",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "ucm:Accepted",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Accepted"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A care coordination request that has been accepted for ongoing care."
      },
      "skos:inScheme": {
        "@id": "ucm:LifecycleState"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Accepted Care Coordination Lifecycle"
      },
      "skos:topConceptOf": {
        "@id": "ucm:LifecycleState"
      }
    },
    {
      "@id": "ucm:ActivityFocus",
      "@type": "owl:Class",
      "rdfs:comment": "The matter, condition, or situation toward which a coordinated activity is orchestrated and which the activity seeks to jointly maintain, update, resolve, or bring about.",
      "rdfs:label": "Activity Focus"
    },
    {
      "@id": "ucm:BehavioralHealthContext",
      "@type": "owl:Class",
      "rdfs:label": "Behavioral Health Context",
      "rdfs:subClassOf": {
        "@id": "ucm:SemanticContext"
      }
    },
    {
      "@id": "ucm:BehavioralHealthDomain",
      "@type": "owl:Class",
      "rdfs:label": "Behavioral Health Domain"
    },
    {
      "@id": "ucm:BeneficiaryRole",
      "@type": "owl:Class",
      "rdfs:label": "Beneficiary Role",
      "rdfs:subClassOf": {
        "@id": "ucm:SubjectRole"
      }
    },
    {
      "@id": "ucm:CareCommitment",
      "@type": "owl:Class",
      "rdfs:comment": "A continuing agreement among participants to coordinate care toward a joint purpose, according to terms or conditions that may evolve.",
      "rdfs:label": "Care Commitment"
    },
    {
      "@id": "ucm:CareCoordinationInteraction",
      "@type": "owl:Class",
      "rdfs:label": "Care Coordination Interaction",
      "rdfs:subClassOf": {
        "@id": "ucm:Process"
      }
    },
    {
      "@id": "ucm:CareCoordinationStatement",
      "@type": "owl:Class",
      "rdfs:label": "Care Coordination Statement",
      "rdfs:subClassOf": {
        "@id": "ucm:Statement"
      }
    },
    {
      "@id": "ucm:CareCoverageGap",
      "@type": "owl:Class",
      "rdfs:comment": "A condition in which a care coverage requirement is in force but is not satisfied by any applicable in-force care commitment during a specified interval.",
      "rdfs:label": "Care Coverage Gap"
    },
    {
      "@id": "ucm:CareCoverageRequirement",
      "@type": "owl:Class",
      "rdfs:comment": "A requirement that some participation in care coordination concerns an activity focus, in a given role, over a defined context or interval.",
      "rdfs:label": "Care Coverage Requirement"
    },
    {
      "@id": "ucm:CareTeam",
      "@type": "owl:Class",
      "rdfs:label": "Care Team",
      "rdfs:subClassOf": {
        "@id": "ucm:SocialGroupEntity"
      }
    },
    {
      "@id": "ucm:CareTrajectoryContext",
      "@type": "owl:Class",
      "rdfs:comment": "A position or extent defined relative to the progression of a care process, state trajectory, or coordinated activity, which does not require anchoring to clock or calendar time.",
      "rdfs:label": "Care Trajectory Context"
    },
    {
      "@id": "ucm:CaregiverRole",
      "@type": "owl:Class",
      "rdfs:label": "Caregiver Role",
      "rdfs:subClassOf": {
        "@id": "ucm:Role"
      }
    },
    {
      "@id": "ucm:ClientDeclined",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "ucm:ClosedNotConnected"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The person chose not to receive the requested services."
      },
      "skos:inScheme": {
        "@id": "ucm:ClosureReason"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Declined by the person"
      }
    },
    {
      "@id": "ucm:ClientRole",
      "@type": "owl:Class",
      "rdfs:label": "Client Role",
      "rdfs:subClassOf": {
        "@id": "ucm:SubjectRole"
      }
    },
    {
      "@id": "ucm:ClientUnreachable",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "ucm:ClosedNotConnected"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The receiving party could not reach the person."
      },
      "skos:inScheme": {
        "@id": "ucm:ClosureReason"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Person unreachable"
      }
    },
    {
      "@id": "ucm:ClinicalCareContext",
      "@type": "owl:Class",
      "rdfs:label": "Clinical Care Context",
      "rdfs:subClassOf": {
        "@id": "ucm:SemanticContext"
      }
    },
    {
      "@id": "ucm:ClinicalDomain",
      "@type": "owl:Class",
      "rdfs:label": "Clinical Domain"
    },
    {
      "@id": "ucm:ClinicalEncounter",
      "@type": "owl:Class",
      "rdfs:label": "Clinical Encounter",
      "rdfs:subClassOf": {
        "@id": "ucm:Encounter"
      }
    },
    {
      "@id": "ucm:ClinicalStatement",
      "@type": "owl:Class",
      "rdfs:label": "Clinical Statement",
      "rdfs:subClassOf": {
        "@id": "ucm:Statement"
      }
    },
    {
      "@id": "ucm:ClosedConnected",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The person was connected to the requested services."
      },
      "skos:inScheme": {
        "@id": "ucm:ClosureReason"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Connected"
      },
      "skos:topConceptOf": {
        "@id": "ucm:ClosureReason"
      }
    },
    {
      "@id": "ucm:ClosedNoLongerNeeded",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The need was resolved, or stopped applying, without the requested services."
      },
      "skos:inScheme": {
        "@id": "ucm:ClosureReason"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "No longer needed"
      },
      "skos:topConceptOf": {
        "@id": "ucm:ClosureReason"
      }
    },
    {
      "@id": "ucm:ClosedNotConnected",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The episode ended without connecting the person to the requested services. Record a narrower concept when the reason is known."
      },
      "skos:inScheme": {
        "@id": "ucm:ClosureReason"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Not connected"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "This concept may be selected directly when a more specific closure reason is not available. Queries and reporting that aggregate closure reasons under this concept may use reflexive-transitive traversal of skos:broader (SPARQL property path skos:broader*). This includes the concept itself and all narrower closure reasons at any depth. "
      },
      "skos:topConceptOf": {
        "@id": "ucm:ClosureReason"
      }
    },
    {
      "@id": "ucm:ClosureReason",
      "@type": "skos:ConceptScheme",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-11-07"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "Why did the care coordination episode end?"
      },
      "dcterms:publisher": {
        "@language": "en",
        "@value": "MDIX"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "UCM Closure Reason"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The reason a care coordination episode was closed, grouped by whether the person was connected to the requested services."
      },
      "skos:hasTopConcept": [
        {
          "@id": "ucm:ClosedConnected"
        },
        {
          "@id": "ucm:ClosedNoLongerNeeded"
        },
        {
          "@id": "ucm:ClosedNotConnected"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Closure Reason"
      }
    },
    {
      "@id": "ucm:CommitmentInForce",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The commitment is agreed and binding on its participants."
      },
      "skos:inScheme": {
        "@id": "ucm:CommitmentStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "In force"
      },
      "skos:topConceptOf": {
        "@id": "ucm:CommitmentStatus"
      }
    },
    {
      "@id": "ucm:CommitmentLapsed",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The commitment ended without being released, for example by expiry or abandonment."
      },
      "skos:inScheme": {
        "@id": "ucm:CommitmentStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lapsed"
      },
      "skos:topConceptOf": {
        "@id": "ucm:CommitmentStatus"
      }
    },
    {
      "@id": "ucm:CommitmentProposed",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The commitment has been offered but not yet agreed."
      },
      "skos:inScheme": {
        "@id": "ucm:CommitmentStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Proposed"
      },
      "skos:topConceptOf": {
        "@id": "ucm:CommitmentStatus"
      }
    },
    {
      "@id": "ucm:CommitmentReleased",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The commitment ended deliberately: completed, handed over or ended by agreement."
      },
      "skos:inScheme": {
        "@id": "ucm:CommitmentStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Released"
      },
      "skos:topConceptOf": {
        "@id": "ucm:CommitmentStatus"
      }
    },
    {
      "@id": "ucm:CommitmentStatus",
      "@type": "skos:ConceptScheme",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-11-07"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "Is a care commitment binding on its participants?"
      },
      "dcterms:publisher": {
        "@language": "en",
        "@value": "MDIX"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "UCM Commitment Status"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The standing of a ucm:CareCommitment over time."
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Durability axis for a service handoff: a handoff held when the receiving party's commitment was in force before the sending party's was released, with no ucm:CareCoverageGap between them."
      },
      "skos:hasTopConcept": [
        {
          "@id": "ucm:CommitmentInForce"
        },
        {
          "@id": "ucm:CommitmentLapsed"
        },
        {
          "@id": "ucm:CommitmentProposed"
        },
        {
          "@id": "ucm:CommitmentReleased"
        },
        {
          "@id": "ucm:CommitmentSuspended"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Commitment Status"
      }
    },
    {
      "@id": "ucm:CommitmentSuspended",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The commitment is agreed but temporarily not binding."
      },
      "skos:inScheme": {
        "@id": "ucm:CommitmentStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Suspended"
      },
      "skos:topConceptOf": {
        "@id": "ucm:CommitmentStatus"
      }
    },
    {
      "@id": "ucm:CommunityGroup",
      "@type": "owl:Class",
      "rdfs:label": "Community Group",
      "rdfs:subClassOf": {
        "@id": "ucm:SocialGroupEntity"
      }
    },
    {
      "@id": "ucm:CoordinationRequest",
      "@type": "owl:Class",
      "rdfs:comment": "A process in which coordination is requested between participating entities.",
      "rdfs:label": "Care Coordination Request",
      "rdfs:subClassOf": {
        "@id": "ucm:Process"
      }
    },
    {
      "@id": "ucm:CoordinativeActivity",
      "@type": "owl:Class",
      "rdfs:comment": "A situated activity whose process is shared by participating entities in its care coordination lifecycle.",
      "rdfs:label": "Coordinative Care Activity",
      "rdfs:subClassOf": {
        "@id": "ucm:Process"
      }
    },
    {
      "@id": "ucm:CoordinatorRole",
      "@type": "owl:Class",
      "rdfs:label": "Coordinator Role",
      "rdfs:subClassOf": {
        "@id": "ucm:Role"
      }
    },
    {
      "@id": "ucm:Declined",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Declined"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "This care request was denied."
      },
      "skos:inScheme": {
        "@id": "ucm:LifecycleState"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Declined Care Coordination Lifecycle"
      },
      "skos:topConceptOf": {
        "@id": "ucm:LifecycleState"
      }
    },
    {
      "@id": "ucm:DefinitionArtifact",
      "@type": "owl:Class",
      "rdfs:comment": "A ruleset, policy definition, constraint, or governance artifact.",
      "rdfs:label": "Definition Artifact"
    },
    {
      "@id": "ucm:Device",
      "@type": "owl:Class",
      "rdfs:label": "Device",
      "rdfs:subClassOf": {
        "@id": "ucm:Entity"
      }
    },
    {
      "@id": "ucm:DiagnosisStatement",
      "@type": "owl:Class",
      "rdfs:label": "Diagnosis Statement",
      "rdfs:subClassOf": {
        "@id": "ucm:ClinicalStatement"
      }
    },
    {
      "@id": "ucm:EligibilityDetermination",
      "@type": "owl:Class",
      "rdfs:label": "Eligibility Determination",
      "rdfs:subClassOf": {
        "@id": "ucm:Process"
      }
    },
    {
      "@id": "ucm:EligibilityRuleset",
      "@type": "owl:Class",
      "rdfs:label": "Eligibility Ruleset",
      "rdfs:subClassOf": {
        "@id": "ucm:DefinitionArtifact"
      }
    },
    {
      "@id": "ucm:Encounter",
      "@type": "owl:Class",
      "rdfs:comment": "A bounded contextual interaction process.",
      "rdfs:label": "Encounter",
      "rdfs:subClassOf": {
        "@id": "ucm:Process"
      }
    },
    {
      "@id": "ucm:Entity",
      "@type": "owl:Class",
      "rdfs:comment": "A stable independently identifiable semantic thing.",
      "rdfs:label": "Entity"
    },
    {
      "@id": "ucm:FulfillmentConfirmed",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Completed"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The requesting party has confirmed that the negotiated services were delivered."
      },
      "skos:inScheme": {
        "@id": "ucm:HandshakeFulfillment"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Confirmed delivered"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandshakeFulfillment"
      }
    },
    {
      "@id": "ucm:FulfillmentNotStarted",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "None of the negotiated services has been delivered yet."
      },
      "skos:inScheme": {
        "@id": "ucm:HandshakeFulfillment"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Not started"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandshakeFulfillment"
      }
    },
    {
      "@id": "ucm:FulfillmentPartial",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Partially executed"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Some, but not all, of the negotiated services have been delivered."
      },
      "skos:inScheme": {
        "@id": "ucm:HandshakeFulfillment"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Partially delivered"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandshakeFulfillment"
      }
    },
    {
      "@id": "ucm:FulfillmentReported",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Pending confirmation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The delivering party reports the negotiated services delivered; the requesting party has not confirmed it."
      },
      "skos:inScheme": {
        "@id": "ucm:HandshakeFulfillment"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Reported delivered"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandshakeFulfillment"
      }
    },
    {
      "@id": "ucm:HandoffAcknowledged",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Received"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The receiving party has acknowledged the handoff but has not yet assumed responsibility."
      },
      "skos:inScheme": {
        "@id": "ucm:HandoffStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Acknowledged"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandoffStatus"
      }
    },
    {
      "@id": "ucm:HandoffAssumed",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The receiving party has assumed responsibility for the agreed services, and the sending party has released it."
      },
      "skos:inScheme": {
        "@id": "ucm:HandoffStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Assumed"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandoffStatus"
      }
    },
    {
      "@id": "ucm:HandoffDropped",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The sending party released responsibility before the receiving party assumed it, leaving no one responsible for the agreed services."
      },
      "skos:inScheme": {
        "@id": "ucm:HandoffStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Dropped"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandoffStatus"
      }
    },
    {
      "@id": "ucm:HandoffOffered",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The sending party has offered responsibility for the agreed services; the receiving party has not acknowledged it."
      },
      "skos:inScheme": {
        "@id": "ucm:HandoffStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Offered"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandoffStatus"
      }
    },
    {
      "@id": "ucm:HandoffReturned",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The receiving party handed responsibility back to the sending party."
      },
      "skos:inScheme": {
        "@id": "ucm:HandoffStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Returned"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandoffStatus"
      }
    },
    {
      "@id": "ucm:HandoffShared",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The sending and receiving parties hold responsibility for the agreed services jointly."
      },
      "skos:inScheme": {
        "@id": "ucm:HandoffStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Shared"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandoffStatus"
      }
    },
    {
      "@id": "ucm:HandoffStatus",
      "@type": "skos:ConceptScheme",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-11-07"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "Where does responsibility for the agreed services stand between the sending and receiving parties?"
      },
      "dcterms:publisher": {
        "@language": "en",
        "@value": "MDIX"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "UCM Handoff Status"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The state of a care coordination handoff: whether responsibility for jointly agreed services has moved to the receiving party."
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "This axis tracks responsibility rather than the referral decision. "
      },
      "skos:hasTopConcept": [
        {
          "@id": "ucm:HandoffAcknowledged"
        },
        {
          "@id": "ucm:HandoffAssumed"
        },
        {
          "@id": "ucm:HandoffDropped"
        },
        {
          "@id": "ucm:HandoffOffered"
        },
        {
          "@id": "ucm:HandoffReturned"
        },
        {
          "@id": "ucm:HandoffShared"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Handoff Status"
      }
    },
    {
      "@id": "ucm:Handshake",
