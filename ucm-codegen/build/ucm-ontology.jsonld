      "rdfs:label": "Public Health Domain"
    },
    {
      "@id": "ucm:ReferralAccepted",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The receiving party agreed to take part in the requested coordination."
      },
      "skos:exactMatch": {
        "@id": "ucm:Accepted"
      },
      "skos:inScheme": {
        "@id": "ucm:ReferralDisposition"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Accepted"
      },
      "skos:topConceptOf": {
        "@id": "ucm:ReferralDisposition"
      }
    },
    {
      "@id": "ucm:ReferralDeclined",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The receiving party declined the request. The reason is recorded with a ucm:ClosureReason concept."
      },
      "skos:exactMatch": {
        "@id": "ucm:Declined"
      },
      "skos:inScheme": {
        "@id": "ucm:ReferralDisposition"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Declined"
      },
      "skos:topConceptOf": {
        "@id": "ucm:ReferralDisposition"
      }
    },
    {
      "@id": "ucm:ReferralDisposition",
      "@type": "skos:ConceptScheme",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-11-07"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "What has the receiving party decided about a care coordination request?"
      },
      "dcterms:publisher": {
        "@language": "en",
        "@value": "MDIX"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "UCM Referral Disposition"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The receiving party's decision on a care coordination request."
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Overlaps ucm:LifecycleState, whose concepts are defined in terms of care coordination requests. The three shared states are mapped with skos:exactMatch so either validates; the group should decide which scheme a request carries."
      },
      "skos:hasTopConcept": [
        {
          "@id": "ucm:ReferralAccepted"
        },
        {
          "@id": "ucm:ReferralDeclined"
        },
        {
          "@id": "ucm:ReferralExpired"
        },
        {
          "@id": "ucm:ReferralPending"
        },
        {
          "@id": "ucm:ReferralWithdrawn"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Referral Disposition"
      }
    },
    {
      "@id": "ucm:ReferralExpired",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The receiving party made no decision within the time allowed for a response."
      },
      "skos:inScheme": {
        "@id": "ucm:ReferralDisposition"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Expired"
      },
      "skos:topConceptOf": {
        "@id": "ucm:ReferralDisposition"
      }
    },
    {
      "@id": "ucm:ReferralPending",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The request has been sent and the receiving party has not yet decided."
      },
      "skos:exactMatch": {
        "@id": "ucm:Pending"
      },
      "skos:inScheme": {
        "@id": "ucm:ReferralDisposition"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Pending"
      },
      "skos:topConceptOf": {
        "@id": "ucm:ReferralDisposition"
      }
    },
    {
      "@id": "ucm:ReferralWithdrawn",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The requesting party withdrew the request before the receiving party decided."
      },
      "skos:inScheme": {
        "@id": "ucm:ReferralDisposition"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Withdrawn"
      },
      "skos:topConceptOf": {
        "@id": "ucm:ReferralDisposition"
      }
    },
