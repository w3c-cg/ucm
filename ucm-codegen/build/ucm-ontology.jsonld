          "@id": "ucm:FulfillmentConfirmed"
        },
        {
          "@id": "ucm:FulfillmentNotStarted"
        },
        {
          "@id": "ucm:FulfillmentPartial"
        },
        {
          "@id": "ucm:FulfillmentReported"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Handshake Fulfillment"
      }
    },
