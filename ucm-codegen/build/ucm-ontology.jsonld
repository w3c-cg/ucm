        "@type": "xsd:date",
        "@value": "2026-11-07"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "How much of the service negotiated in a handshake has been delivered?"
      },
      "dcterms:publisher": {
        "@language": "en",
        "@value": "MDIX"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "UCM Handshake Fulfillment"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The degree to which the services negotiated in a handshake have been rendered."
