    },
    {
      "@id": "ucm:hasCareTrajectoryContext",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": "Relates a UCM semantic subject to a temporal position or extent defined relative to the internal progression of a process, state trajectory, or coordinated activity rather than directly relative to an external clock or calendar.",
      "rdfs:label": "has care trajectory context"
