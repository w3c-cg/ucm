KEYWORDS = {"@id", "@type", "@context"}


def _to_python(value: Any, kind: str) -> Any:
    if kind == "reference":
        if isinstance(value, dict) and set(value) == {"@id"}:
            return value["@id"]
        if not isinstance(value, str):
            raise TypeError("embedded node")
        return value
    if isinstance(value, dict):
        raise TypeError("value object")  # datatype differs from the term's coercion
    if kind == "datetime":
        return datetime.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    if kind == "date":
        return datetime.date.fromisoformat(str(value))
    if kind == "time":
        return datetime.time.fromisoformat(str(value))
    if kind == "int":
        return int(value)
    if kind == "float":
        return float(value)
    if kind == "decimal":
        return decimal.Decimal(str(value))
    if kind == "bool":
        return value if isinstance(value, bool) else str(value).lower() == "true"
    return str(value)


def _to_json(value: Any, kind: str) -> Any:
    if isinstance(value, (datetime.datetime, datetime.date, datetime.time)):
        return value.isoformat()
    if isinstance(value, decimal.Decimal):
        return str(value)
    return value


def to_rows(node: Dict[str, Any]) -> Tuple[Base, List[Tuple[sa.Table, Dict[str, Any]]]]:
    """One ORM row plus association rows for a compacted JSON-LD node"""
    cls = CLASSES[node["@type"]]
    table = cls.__tablename__
    row = cls(iri=node["@id"])
    extra: Dict[str, Any] = {}
    links: List[Tuple[sa.Table, Dict[str, Any]]] = []

    for key, value in node.items():
        if key in KEYWORDS:
            continue
        if key in COLUMNS and COLUMNS[key][0] == table:
            _, attribute, kind = COLUMNS[key]
            try:
                setattr(row, attribute, _to_python(value, kind))
                continue
            except TypeError:
                pass  # not representable in the column: keep it verbatim
        elif key in ASSOCIATIONS and ASSOCIATIONS[key][1] in (None, table):
            assoc, _, kind = ASSOCIATIONS[key]
            for item in value if isinstance(value, list) else [value]:
                # Omit the unused column: a JSON column stores Python None as JSON null
                if kind == "reference":
                    if isinstance(item, str) or (isinstance(item, dict) and set(item) == {"@id"}):
                        values = {"object_iri": _to_python(item, kind)}
                    else:
                        values = {"object_node": item}
                else:
                    values = {"value": _to_python(item, kind)}
                links.append((assoc, {"subject_iri": node["@id"], **values}))
            continue
        extra[key] = value

    row.extra = extra
    return row, links


def load(session: Session, nodes: Iterable[Dict[str, Any]]) -> int:
    """Insert JSON-LD nodes; returns the number of nodes stored"""
    pending = []
    count = 0
    for node in nodes:
        row, links = to_rows(node)
        session.add(row)
        pending.extend(links)
        count += 1
    session.flush()  # owner rows first: association rows reference them
    for assoc, values in pending:
        session.execute(assoc.insert().values(**values))
    return count


def get(session: Session, iri: str) -> Optional[Base]:
    for root in ROOT_CLASSES:
        found = session.get(root, iri)
        if found is not None:
            return found
    return None


def dump(session: Session, iri: str) -> Optional[Dict[str, Any]]:
    """Rebuild the compacted JSON-LD node for an IRI"""
    row = get(session, iri)
    if row is None:
        return None
    table = row.__tablename__
    node: Dict[str, Any] = {"@id": row.iri, "@type": row.type}
    for term, (owner, attribute, kind) in COLUMNS.items():
        if owner == table and getattr(row, attribute) is not None:
            node[term] = _to_json(getattr(row, attribute), kind)
    for term, (assoc, owner, kind) in ASSOCIATIONS.items():
        if owner not in (None, table):
            continue
        rows = session.execute(
            sa.select(assoc).where(assoc.c.subject_iri == iri).order_by(assoc.c.id)
        ).mappings().all()
        if rows:
            if kind == "reference":
                node[term] = [r["object_iri"] if r["object_iri"] is not None else r["object_node"] for r in rows]
            else:
                node[term] = [_to_json(r["value"], kind) for r in rows]
    node.update(row.extra or {})
    return node
