"""
UCM ⇄ FHIR R{{ adapter.fhir_version.split(".")[0] }} adapter

Generated by ucm-codegen from {{ adapter.ontology_iri }} {{ adapter.ontology_version or "" }}
and the FHIR mapping overlay. DO NOT EDIT - regenerate with: ucm-codegen generate -f fhir

to_fhir_bundle(nodes)   UCM JSON-LD nodes (compacted with the generated context)
                        → FHIR collection Bundle, plus warnings
from_fhir_bundle(b)     Bundle produced by to_fhir_bundle → UCM JSON-LD nodes

Identity: every resource carries its UCM IRI as identifier (system
urn:ietf:rfc:3986) and its UCM class as meta.tag; fullUrl and id are
UUIDv5 of the IRI, so output is deterministic. Nodes folded into a resource
(e.g., participations in Encounter.participant) carry their IRI in the
node-iri extension. Multi-hop paths (statementSubject/participatingEntity)
are one-way: the reverse direction cannot recover the intermediate node.
Standard library only.
"""

from __future__ import annotations

import copy
import uuid
from typing import Any, Dict, Iterable, List, Optional, Tuple

FHIR_VERSION = {{ adapter.fhir_version | pyrepr }}
CODE_SYSTEM = {{ adapter.code_system | pyrepr }}
NODE_IRI_EXTENSION = {{ adapter.node_iri_extension | pyrepr }}
URI_SYSTEM = "urn:ietf:rfc:3986"

# Compiled mapping: UCM class term → resource spec
MAPPINGS: Dict[str, Dict[str, Any]] = {{ adapter.resources | pyrepr }}

# Ontology tables: class ancestry, JSON-LD key aliases, @set terms, concepts
ANCESTORS: Dict[str, List[str]] = {{ adapter.ancestors | pyrepr }}
KEYS: Dict[str, List[str]] = {{ adapter["keys"] | pyrepr }}
SETS: Dict[str, bool] = {{ adapter.sets | pyrepr }}
CONCEPTS: Dict[str, str] = {{ adapter.concepts | pyrepr }}
CONCEPT_TERMS: Dict[str, str] = {{ adapter.concept_terms | pyrepr }}
PREFIXES: Dict[str, str] = {{ adapter.prefixes | pyrepr }}


# ============================================================================
# Helpers
# ============================================================================

def full_url(iri: str) -> str:
    return f"urn:uuid:{uuid.uuid5(uuid.NAMESPACE_URL, iri)}"


def resource_id(iri: str) -> str:
    return str(uuid.uuid5(uuid.NAMESPACE_URL, iri))


def _unwrap(value: Any) -> Any:
    return value["@value"] if isinstance(value, dict) and "@value" in value else value


def _iri(value: Any) -> Optional[str]:
    if isinstance(value, str):
        return value
    if isinstance(value, dict) and isinstance(value.get("@id"), str):
        return value["@id"]
    return None


def _values(node: Dict[str, Any], key: str) -> List[Any]:
    """Values under a term, its compact IRI or its full IRI"""
    for alias in KEYS.get(key, [key]):
        if alias in node:
            value = node[alias]
            return [_unwrap(v) for v in (value if isinstance(value, list) else [value])]
    return []


def _is_a(term: Optional[str], ancestor: str) -> bool:
    return term == ancestor or ancestor in ANCESTORS.get(term or "", [])


def _expand(value: str) -> str:
    if value in CONCEPTS:
        return CONCEPTS[value]
    prefix, _, local = value.partition(":")
    if local and prefix in PREFIXES and not local.startswith("//"):
        return PREFIXES[prefix] + local
    return value


def _set(target: Dict[str, Any], path: str, value: Any) -> None:
    *parents, last = path.split(".")
    for part in parents:
        target = target.setdefault(part, {})
    target[last] = value


def _get(source: Dict[str, Any], path: str) -> Any:
    for part in path.split("."):
        if not isinstance(source, dict):
            return None
        source = source.get(part)
    return source


def _node_iri_extension(element: Any) -> Optional[str]:
    if isinstance(element, dict):
        for ext in element.get("extension", []):
            if ext.get("url") == NODE_IRI_EXTENSION:
                return ext.get("valueUri")
    return None


class _Graph:
    def __init__(self, nodes: Iterable[Dict[str, Any]]):
        self.nodes = {n["@id"]: n for n in nodes if isinstance(n.get("@id"), str)}

    def node(self, item: Any) -> Optional[Dict[str, Any]]:
        if isinstance(item, dict) and set(item) - {"@id"}:
            return item
        iri = _iri(item)
        return self.nodes.get(iri) if iri else None

    def inverse(self, prop: str, iri: str) -> List[Dict[str, Any]]:
        return [n for _, n in sorted(self.nodes.items()) if iri in (_iri(v) for v in _values(n, prop))]

    def mapping_for(self, node: Dict[str, Any]) -> Optional[Dict[str, Any]]:
        term = node.get("@type")
        for candidate in [term] + ANCESTORS.get(term or "", []):
            if candidate in MAPPINGS:
                return MAPPINGS[candidate]
        return None

    def role_terms(self, participation: Dict[str, Any]) -> List[str]:
        roles = (self.node(r) for r in _values(participation, "assumesRole"))
        return [r["@type"] for r in roles if r and "@type" in r]


# ============================================================================
# UCM → FHIR
# ============================================================================

def _items(g: _Graph, node: Any, field: Dict[str, Any]) -> List[Tuple[Optional[Dict[str, Any]], Any]]:
    """(collected node, value) pairs for a field, relative to node"""
    start = g.node(node)
    if field["inverse"]:
        if start is None:
            return []
        collected = g.inverse(field["inverse"], start["@id"])
        if field["class"]:
            collected = [n for n in collected if _is_a(n.get("@type"), field["class"])]
        if field["roles"]:
            collected = [n for n in collected
                         if any(_is_a(r, role) for r in g.role_terms(n) for role in field["roles"])]
        if field["exclude_roles"]:
            collected = [n for n in collected
                         if not any(_is_a(r, role) for r in g.role_terms(n) for role in field["exclude_roles"])]
        pairs: List[Tuple[Optional[Dict[str, Any]], Any]] = [(n, n) for n in collected]
    else:
        pairs = [(None, node)]

    for hop in field["property"]:
        hopped = []
        for origin, value in pairs:
            current = g.node(value)
            if current is not None:
                hopped.extend((origin, v) for v in _values(current, hop))
        pairs = hopped
    return pairs


def _transform(g: _Graph, value: Any, field: Dict[str, Any]) -> Any:
    kind = field["transform"]
    if kind == "reference":
        iri = _iri(value)
        if iri is None:
            return None
        target = g.node(iri)
        if target is not None and g.mapping_for(target) is not None:
            return {"reference": full_url(iri)}
        return {"identifier": {"system": URI_SYSTEM, "value": iri}}
    if kind == "code":
        return field["map"].get(_expand(str(_iri(value) or value)))
    if kind == "class-coding":
        target = g.node(value)
        if target is None or "@type" not in target:
            return None
        return {"coding": [{"system": CODE_SYSTEM, "code": target["@type"]}]}
    if kind == "role-coding":
        iri = _iri(value)
        role = g.node(iri)
        concept: Dict[str, Any] = (
            {"coding": [{"system": CODE_SYSTEM, "code": role["@type"]}]} if role and "@type" in role
            else {"text": iri}
        )
        concept["extension"] = [{"url": NODE_IRI_EXTENSION, "valueUri": iri}]
        return concept
    if isinstance(value, dict):
        return None  # a node where a value was expected
    return value


def _tag(element: Any, origin: Optional[Dict[str, Any]]) -> Any:
    if origin is not None and isinstance(element, dict):
        element.setdefault("extension", []).append({"url": NODE_IRI_EXTENSION, "valueUri": origin["@id"]})
    return element


def _field(g: _Graph, node: Any, field: Dict[str, Any], warnings: List[str], where: str) -> Any:
    outputs = []
    for origin, value in _items(g, node, field):
        if "each" in field:
            element: Dict[str, Any] = {}
            for path, sub in field["each"].items():
                result = _field(g, value, sub, warnings, f"{where}.{path}")
                if result is not None:
                    _set(element, path, result)
            if element:
                outputs.append(_tag(element, origin if origin is not None else g.node(value)))
            continue
        result = _transform(g, value, field)
        if result is None:
            if field["transform"] == "code":
                warnings.append(f"{where}: {value!r} has no FHIR code in the mapping")
            continue
        outputs.append(_tag(result, origin))

    if not outputs and field.get("default") is not None:
        outputs = [field["default"]]
    if not outputs:
        return None
    return outputs[0] if field["single"] else outputs


def _resource_type(g: _Graph, node: Dict[str, Any], spec: Dict[str, Any]) -> str:
    participations = g.inverse("participatingEntity", node["@id"])
    for role, resource in spec["by_role"]:
        if any(_is_a(r, role) for p in participations for r in g.role_terms(p)):
            return resource
    return spec["resource"]


def to_fhir_bundle(nodes: Iterable[Dict[str, Any]]) -> Tuple[Dict[str, Any], List[str]]:
    """UCM nodes → FHIR collection Bundle; nodes of unmapped classes inform but are not emitted"""
    g = _Graph(nodes)
    warnings: List[str] = []
    entries = []
    for iri, node in sorted(g.nodes.items()):
        spec = g.mapping_for(node)
        if spec is None:
            continue
        meta: Dict[str, Any] = {"tag": [{"system": CODE_SYSTEM, "code": node["@type"]}]}
        if spec["profile"]:
            meta["profile"] = [spec["profile"]]
        resource: Dict[str, Any] = {
            "resourceType": _resource_type(g, node, spec),
            "id": resource_id(iri),
            "meta": meta,
            "identifier": [{"system": URI_SYSTEM, "value": iri}],
        }
        resource.update(copy.deepcopy(spec["constants"]))
        for path, field in spec["fields"].items():
            value = _field(g, node, field, warnings, f"{iri} {resource['resourceType']}.{path}")
            if value is not None:
                _set(resource, path, value)
        entries.append({"fullUrl": full_url(iri), "resource": resource})
    return {"resourceType": "Bundle", "type": "collection", "entry": entries}, warnings


# ============================================================================
# FHIR → UCM
# ============================================================================

class _Nodes:
    def __init__(self) -> None:
        self.nodes: Dict[str, Dict[str, Any]] = {}

    def get(self, iri: str, type_: Optional[str] = None) -> Dict[str, Any]:
        node = self.nodes.setdefault(iri, {"@id": iri})
        if type_ and "@type" not in node:
            node["@type"] = type_
        return node

    @staticmethod
    def add(node: Dict[str, Any], term: str, value: Any) -> None:
        if SETS.get(term, True):
            values = node.setdefault(term, [])
            if value not in values:
                values.append(value)
        else:
            node[term] = value


def _reverse_value(field: Dict[str, Any], value: Any, urls: Dict[str, str], out: _Nodes) -> Any:
    kind = field["transform"]
    if kind == "reference":
        if not isinstance(value, dict):
            return None
        if value.get("reference") in urls:
            return urls[value["reference"]]
        identifier = value.get("identifier") or {}
        return identifier.get("value") if identifier.get("system") == URI_SYSTEM else None
    if kind == "code":
        return field["reverse"].get(value)
    if kind == "role-coding":
        iri = _node_iri_extension(value)
        codes = [c.get("code") for c in (value.get("coding") or [])] if isinstance(value, dict) else []
        if iri:
            out.get(iri, codes[0] if codes else None)
        return iri
    if kind == "class-coding":
        return None
    return value


def _reverse(field: Dict[str, Any], found: Any, current: Dict[str, Any], urls: Dict[str, str], out: _Nodes) -> None:
    if found is None or len(field["property"]) > 1:
        return  # absent, or a multi-hop path (one-way)
    prop = field["property"][0] if field["property"] else None
    for element in found if isinstance(found, list) else [found]:
        if "each" in field:
            child_iri = _node_iri_extension(element)
            if field["inverse"]:
                if child_iri is None:
                    continue
                child = out.get(child_iri, field["class"])
                out.add(child, field["inverse"], current["@id"])
                for path, sub in field["each"].items():
                    _reverse(sub, _get(element, path), child, urls, out)
            elif prop:
                for path, sub in field["each"].items():
                    if not sub["property"] and not sub["inverse"]:
                        value = _reverse_value(sub, _get(element, path), urls, out)
                        if value is not None:
                            out.add(current, prop, value)
            continue

        value = _reverse_value(field, element, urls, out)
        if value is None:
            continue
        if field["inverse"] and prop:
            child_iri = _node_iri_extension(element)
            if child_iri is not None:
                child = out.get(child_iri, field["class"])
                out.add(child, field["inverse"], current["@id"])
                out.add(child, prop, value)
        elif field["inverse"]:
            out.add(out.get(value), field["inverse"], current["@id"])
        elif prop:
            out.add(current, prop, value)


def from_fhir_bundle(bundle: Dict[str, Any]) -> List[Dict[str, Any]]:
    """FHIR Bundle (as produced by to_fhir_bundle) → UCM JSON-LD nodes"""
    urls: Dict[str, str] = {}
    for entry in bundle.get("entry", []):
        for identifier in entry["resource"].get("identifier", []):
            if identifier.get("system") == URI_SYSTEM:
                urls[entry["fullUrl"]] = identifier["value"]

    out = _Nodes()
    for entry in bundle.get("entry", []):
        resource = entry["resource"]
        iri = urls.get(entry.get("fullUrl", ""))
        tags = [t["code"] for t in resource.get("meta", {}).get("tag", []) if t.get("system") == CODE_SYSTEM]
        if iri is None or not tags:
            continue
        current = out.get(iri, tags[0])
        spec = next((MAPPINGS[c] for c in [tags[0]] + ANCESTORS.get(tags[0], []) if c in MAPPINGS), None)
        if spec is None:
            continue
        for path, field in spec["fields"].items():
            _reverse(field, _get(resource, path), current, urls, out)
    return [out.nodes[k] for k in sorted(out.nodes)]
