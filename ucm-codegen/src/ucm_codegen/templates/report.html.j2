<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>UCM Build Report</title>
<meta name="description" content="Lint, validation and target mapping report for {{ r.ontology.label }} {{ r.ontology.version or '' }}, generated by ucm-codegen.">
<style>
:root {
  --font: "Lucida Grande", "Lucida Sans Unicode", "Lucida Sans", Geneva, Verdana, sans-serif;
  --mono: Monaco, "Lucida Console", Menlo, Consolas, monospace;
  --ink: #1c1f23;
  --ink-soft: #545b64;
  --ink-faint: #8b929b;
  --rule: #dfe3e8;
  --rule-strong: #c9cfd6;
  --surface: #ffffff;
  --surface-2: #f6f7f9;
  --rail: #f0f3f7;
  --zebra: #f4f7fc;
  --accent: #1d5bd6;
  --accent-ink: #123e94;
  --accent-tone: #dde8fc;
  /* tonal pairs: background / ink */
  --red-bg: #fde8e6;   --red-ink: #a8231a;
  --amber-bg: #fff1d6; --amber-ink: #7d5200;
  --green-bg: #e2f3df; --green-ink: #22661b;
  --grey-bg: #eceff3;  --grey-ink: #475260;
  --radius: 10px;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  padding: 32px 16px 44px;
  font: 12px/1.5 var(--font);
  color: var(--ink);
  min-height: 100vh;
  /* the backdrop the glass rim refracts */
  background-color: #dfe6ef;
  background-image:
    radial-gradient(60% 50% at 12% 8%, rgba(120, 166, 236, .55), transparent 70%),
    radial-gradient(50% 45% at 92% 18%, rgba(196, 168, 236, .45), transparent 70%),
    radial-gradient(55% 50% at 78% 96%, rgba(120, 206, 196, .40), transparent 70%),
    radial-gradient(45% 40% at 6% 88%, rgba(246, 196, 150, .40), transparent 70%);
  background-attachment: fixed;
}
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
code, .mono { font-family: var(--mono); font-size: 11px; }

/* ---------- Window: flat body inside a liquid-glass rim ---------- */
.glass {
  position: relative;
  max-width: 1220px;
  margin: 0 auto;
  padding: 9px;
  border-radius: 22px;
}
/* The glass is its own layer behind the window, so only the rim is blurred
   and page content never repaints through a backdrop filter */
.glass::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  border-radius: inherit;
  background: linear-gradient(145deg, rgba(255, 255, 255, .55), rgba(255, 255, 255, .18) 45%, rgba(255, 255, 255, .34));
  -webkit-backdrop-filter: blur(22px) saturate(170%);
  backdrop-filter: blur(22px) saturate(170%);
  border: 1px solid rgba(255, 255, 255, .7);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, .9),
    inset 0 -1px 0 rgba(255, 255, 255, .35),
    inset 1px 0 0 rgba(255, 255, 255, .45),
    0 24px 60px rgba(30, 50, 90, .22),
    0 4px 14px rgba(30, 50, 90, .12);
}
.window {
  position: relative;
  z-index: 1;
  border-radius: 14px;
  background: var(--surface);
  overflow: hidden;
  box-shadow: 0 0 0 1px rgba(20, 35, 60, .14);
}
.chrome {
  background: var(--surface-2);
  border-bottom: 1px solid var(--rule);
}
.titlebar {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8px;
  padding: 10px 16px 0;
  font-size: 13px;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
}
.titlebar .name { font-weight: bold; }
.titlebar .sub { color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; }
.toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 16px 12px;
  flex-wrap: wrap;
}
.status-lamp { display: flex; align-items: center; gap: 10px; min-width: 0; flex-wrap: wrap; }
.status-lamp .facts { display: inline-flex; flex-wrap: wrap; color: var(--ink-soft); }
.status-lamp .facts span + span::before { content: "·"; margin: 0 6px; color: var(--ink-faint); }
.spacer { flex: 1; }
.search {
  display: flex; align-items: center; gap: 6px;
  height: 30px; padding: 0 12px;
  border: 1px solid var(--rule-strong); border-radius: 15px;
  background: var(--surface);
  transition: border-color .15s, box-shadow .15s;
}
.search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(29, 91, 214, .15); }
.search svg { flex: none; }
.search input {
  border: 0; outline: 0; background: transparent;
  font: 12px var(--font); width: 180px; color: var(--ink);
}

/* ---------- Layout ---------- */
.main { display: grid; grid-template-columns: 200px minmax(0, 1fr); min-height: 580px; }
.sidebar { background: var(--rail); border-right: 1px solid var(--rule); padding: 10px 8px 18px; }
.sidebar h2 {
  margin: 14px 10px 4px;
  font-size: 10px; font-weight: bold; letter-spacing: .08em;
  color: var(--ink-faint); text-transform: uppercase;
}
.sidebar h2:first-child { margin-top: 4px; }
.sidebar a {
  display: flex; align-items: center; gap: 6px;
  margin: 1px 0;
  padding: 5px 10px;
  border-radius: 8px;
  color: var(--ink-soft);
  font-size: 12px;
  text-decoration: none;
}
.sidebar a:hover { background: rgba(29, 91, 214, .07); text-decoration: none; }
.sidebar a.is-selected { background: var(--accent-tone); color: var(--accent-ink); font-weight: bold; }
.sidebar .label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.badge {
  flex: none;
  min-width: 22px; padding: 0 7px; border-radius: 10px;
  font-size: 10px; font-weight: bold; line-height: 17px; text-align: center;
  color: var(--grey-ink); background: var(--grey-bg);
}
.sidebar a.is-selected .badge { background: #fff; color: var(--accent-ink); }
.badge.red { background: var(--red-bg); color: var(--red-ink); }
.badge.amber { background: var(--amber-bg); color: var(--amber-ink); }
.content { background: var(--surface); padding: 20px 24px 32px; min-width: 0; }
.pane + .pane { margin-top: 32px; }
.js .pane + .pane { margin-top: 0; }
.pane > h1 { margin: 0 0 4px; font-size: 17px; font-weight: bold; }
.pane > .lede { margin: 0 0 16px; color: var(--ink-soft); max-width: 74ch; }
h3 { font-size: 12px; }

/* ---------- Controls ---------- */
.segmented { display: inline-flex; margin: 0 0 12px; flex-wrap: wrap; }
.segmented button {
  font: 11px var(--font);
  height: 28px; padding: 0 14px;
  color: var(--ink-soft);
  border: 1px solid var(--rule-strong);
  background: var(--surface);
  margin-left: -1px;
  cursor: pointer;
  transition: background .12s, color .12s;
}
.segmented button:first-child { border-radius: 14px 0 0 14px; margin-left: 0; }
.segmented button:last-child { border-radius: 0 14px 14px 0; }
.segmented button:hover { background: var(--surface-2); }
.segmented button.is-selected {
  background: var(--accent-tone); color: var(--accent-ink); font-weight: bold;
  border-color: #a9c2f2; position: relative; z-index: 1;
}

/* ---------- Cards and info grids ---------- */
.group {
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  background: var(--surface);
  padding: 14px 16px;
  margin: 0 0 16px;
  box-shadow: 0 1px 2px rgba(20, 35, 60, .05);
}
.group > h3 { margin: 0 0 10px; color: var(--ink); }
.hero h2 { margin: 0; font-size: 16px; }
.hero p { margin: 3px 0 0; color: var(--ink-soft); }
.lozenges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
.cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0 16px; }
.info { width: 100%; border-collapse: collapse; }
.info th { text-align: right; font-weight: normal; color: var(--ink-soft); padding: 3px 10px 3px 0; width: 46%; white-space: nowrap; }
.info td { padding: 3px 0; font-weight: bold; font-variant-numeric: tabular-nums; }

/* ---------- Chips ---------- */
.pill {
  display: inline-block;
  padding: 0 9px; border-radius: 10px;
  font-size: 10px; font-weight: bold; line-height: 19px; white-space: nowrap;
}
.pill.Violation, .pill.red { background: var(--red-bg); color: var(--red-ink); }
.pill.Warning, .pill.amber { background: var(--amber-bg); color: var(--amber-ink); }
.pill.Info, .pill.graphite { background: var(--grey-bg); color: var(--grey-ink); }
.pill.green { background: var(--green-bg); color: var(--green-ink); }
.pill.blue { background: var(--accent-tone); color: var(--accent-ink); }
.state { font-size: 11px; line-height: 22px; padding: 0 11px; border-radius: 11px; }
.state.passed { background: var(--green-bg); color: var(--green-ink); }
.state.warnings { background: var(--amber-bg); color: var(--amber-ink); }
.state.failed { background: var(--red-bg); color: var(--red-ink); }
.method { font-family: var(--mono); font-size: 10px; padding: 0 7px; border-radius: 5px; }
.method.GET { background: var(--accent-tone); color: var(--accent-ink); }
.method.POST { background: var(--green-bg); color: var(--green-ink); }
.method.PUT { background: var(--amber-bg); color: var(--amber-ink); }
.method.DELETE { background: var(--red-bg); color: var(--red-ink); }

/* ---------- List views ---------- */
.scroll { overflow-x: auto; margin: 0 0 16px; border: 1px solid var(--rule); border-radius: var(--radius); }
.list { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--surface); }
.list th {
  position: sticky; top: 0;
  text-align: left; font-weight: bold; font-size: 10px; letter-spacing: .05em;
  text-transform: uppercase; color: var(--ink-faint); white-space: nowrap;
  padding: 7px 10px;
  background: var(--surface-2);
  border-bottom: 1px solid var(--rule);
}
.list td { padding: 6px 10px; vertical-align: top; border-bottom: 1px solid #eef1f4; }
.list tbody tr:last-child td { border-bottom: 0; }
.list tbody tr:nth-child(even) td { background: var(--zebra); }
.list .num { text-align: right; font-variant-numeric: tabular-nums; }
.list .wide { min-width: 280px; }
.list .break { min-width: 180px; overflow-wrap: anywhere; }
.muted { color: var(--ink-faint); }
.soft { color: var(--ink-soft); }
.nowrap { white-space: nowrap; }

/* ---------- Class browser ---------- */
.classes { border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; margin: 0 0 16px; }
.class { border-bottom: 1px solid #eef1f4; }
.class:last-child { border-bottom: 0; }
.class > summary {
  list-style: none;
  display: flex; align-items: center; gap: 8px;
  padding: 7px 10px;
  cursor: pointer;
}
.class > summary::-webkit-details-marker { display: none; }
.class > summary::before {
  content: "";
  flex: none;
  width: 6px; height: 6px;
  border-right: 1.5px solid var(--ink-faint); border-bottom: 1.5px solid var(--ink-faint);
  transform: rotate(-45deg);
  transition: transform .15s ease;
  margin-right: 2px;
}
.class[open] > summary::before { transform: rotate(45deg); }
.class > summary:hover { background: var(--surface-2); }
.class[open] > summary { background: var(--surface-2); }
.class > summary .term { flex: none; font-weight: bold; }
.class > summary .mono { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.class .tags { flex: none; display: flex; gap: 4px; flex-wrap: wrap; margin-left: auto; }
.class-body { padding: 6px 12px 16px 28px; }
.class-body p { margin: 2px 0 10px; color: var(--ink-soft); max-width: 80ch; }
.meta { display: flex; flex-wrap: wrap; gap: 4px 18px; margin: 0 0 10px; font-size: 11px; color: var(--ink-soft); }
.meta b { color: var(--ink); font-weight: normal; }
.constraints { margin: 0 0 4px; padding: 0; list-style: none; }
.constraints li { display: flex; gap: 8px; align-items: baseline; padding: 2px 0; font-size: 11px; }
.empty { padding: 16px; text-align: center; color: var(--ink-soft); }
.notice {
  margin: 0 0 18px;
  padding: 12px 16px;
  border-radius: var(--radius);
  background: var(--red-bg);
  color: var(--red-ink);
  line-height: 1.55;
}
.notice strong { display: block; margin-bottom: 2px; }
.conforms strong { display: block; font-size: 13px; }

/* ---------- Status bar ---------- */
.statusbar {
  display: flex; flex-wrap: wrap; gap: 4px 18px;
  padding: 7px 16px;
  font-size: 11px; color: var(--ink-faint);
  background: var(--surface-2);
  border-top: 1px solid var(--rule);
}

@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .glass::before { background: rgba(255, 255, 255, .62); }
}

@media (max-width: 760px) {
  body { padding: 12px 16px 24px; }
  .glass { padding: 6px; border-radius: 16px; }
  .window { border-radius: 11px; }
  .main { grid-template-columns: minmax(0, 1fr); }
  .sidebar { display: flex; flex-wrap: wrap; gap: 2px; padding: 8px; border-right: 0; border-bottom: 1px solid var(--rule); }
  .sidebar h2 { display: none; }
  .sidebar a { padding: 4px 10px; }
  .content { padding: 16px 14px 24px; }
  .titlebar { justify-content: flex-start; }
  .search { width: 100%; }
  .search input { width: 100%; }
  .class > summary { flex-wrap: wrap; }
  .class .tags { margin-left: 0; }
}
</style>
</head>
<body>
{% set s = r.status %}
<div class="glass">
<div class="window">
  <div class="chrome">
    <div class="titlebar">
      <span class="name">UCM Build Report</span>
      <span class="sub">{{ r.ontology.label }} {{ r.ontology.version or "" }}</span>
    </div>
    <div class="toolbar">
      <div class="status-lamp">
        <span class="pill state {{ s.state }}">{{ {"passed": "Build passed", "warnings": "Passed with warnings", "failed": "Build failed"}[s.state] }}</span>
        <span class="facts">
          <span>{{ s.violations }} violations</span><span>{{ s.warnings }} warnings</span><span>{{ s.infos }} info</span>
          {% if s.validated %}<span>Example {{ "conforms" if s.conforms else (s.validation_violations ~ " violations, " ~ s.validation_warnings ~ " warnings") }}</span>{% endif %}
        </span>
      </div>
      <div class="spacer"></div>
      <label class="search">
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><circle cx="5" cy="5" r="3.6" fill="none" stroke="#6b6b6b" stroke-width="1.4"/><path d="M7.7 7.7 11 11" stroke="#6b6b6b" stroke-width="1.6" stroke-linecap="round"/></svg>
        <input id="filter" type="search" placeholder="Filter classes" aria-label="Filter classes" autocomplete="off">
      </label>
    </div>
  </div>

  <div class="main">
    <nav class="sidebar" aria-label="Report sections">
      <h2>Build</h2>
      <a href="#overview" data-pane="overview"><span class="label">Overview</span></a>
      <a href="#lint" data-pane="lint"><span class="label">Lint</span>
        {% if s.violations %}<span class="badge red">{{ s.violations }}</span>{% elif s.warnings %}<span class="badge amber">{{ s.warnings }}</span>{% else %}<span class="badge">{{ r.findings | length }}</span>{% endif %}</a>
      <a href="#validation" data-pane="validation"><span class="label">Validation</span>
        {% if s.validation_violations %}<span class="badge red">{{ s.validation_violations }}</span>{% elif r.validation %}<span class="badge amber">{{ r.validation | length }}</span>{% endif %}</a>
      <a href="#changes" data-pane="changes"><span class="label">Changes</span>
        {% if r.changes.count %}<span class="badge amber">{{ r.changes.count }}</span>{% endif %}</a>
      <h2>Ontology</h2>
      <a href="#classes" data-pane="classes"><span class="label">Classes</span><span class="badge">{{ r.classes | length - 1 }}</span></a>
      <a href="#vocabularies" data-pane="vocabularies"><span class="label">Vocabularies</span><span class="badge">{{ r.schemes | length }}</span></a>
      <h2>Targets</h2>
      <a href="#openapi" data-pane="openapi"><span class="label">OpenAPI</span><span class="badge">{{ r.resources | length }}</span></a>
      <a href="#postgres" data-pane="postgres"><span class="label">Postgres</span>{% if r.sql %}<span class="badge">{{ r.sql.tables | length }}</span>{% endif %}</a>
      <a href="#fhir" data-pane="fhir"><span class="label">FHIR</span><span class="badge">{{ r.fhir | length }}</span></a>
      <h2>Output</h2>
      <a href="#artifacts" data-pane="artifacts"><span class="label">Artifacts</span><span class="badge">{{ r.files | length }}</span></a>
    </nav>

    <main class="content">
      {% if r.gate.held %}
      <div class="notice" role="alert">
        <strong>Build failed: {{ r.gate.failed | join("; ") }}.</strong>
        {% if r.gate.last_good %}
        Generated artifacts, the IR and <span class="mono">ucm-build.lock</span> were not updated; they still reflect the last good build (IR root <span class="mono">{{ r.gate.last_good }}</span>), and Changes compares against it.
        {% else %}
        No artifacts were written: there is no previous good build to keep. Fix the findings below and rebuild.
        {% endif %}
      </div>
      {% endif %}
      <!-- ===================== Overview ===================== -->
      <section class="pane" id="overview">
        <div class="group hero">
          <div>
            <h2>{{ r.ontology.label }} <span class="soft">{{ r.ontology.version or "" }}</span></h2>
            <p class="mono">{{ r.ontology.iri }}</p>
            {% if r.ontology.comment %}<p>{{ r.ontology.comment }}</p>{% endif %}
            <div class="lozenges">
              <span class="pill {{ 'red' if s.violations else 'green' }}">{{ s.violations }} lint violations</span>
              <span class="pill {{ 'amber' if s.warnings else 'green' }}">{{ s.warnings }} lint warnings</span>
              <span class="pill graphite">{{ s.infos }} informational</span>
              {% if s.validated %}
              <span class="pill {{ 'green' if s.conforms else ('red' if s.validation_violations else 'amber') }}">Example {{ "conforms" if s.conforms else "has results" }}</span>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="group">
          <h3>Compiled</h3>
          <div class="cols">
            {% for chunk in r.counts | batch(5) %}
            <table class="info">
              {% for label, value in chunk %}
              <tr><th>{{ label }}</th><td>{{ value }}</td></tr>
              {% endfor %}
            </table>
            {% endfor %}
          </div>
        </div>

        <h3>Sources</h3>
        <div class="scroll">
          <table class="list">
            <thead><tr><th>JSON-LD IR</th><th class="num">Triples</th><th>Graph (URDNA2015)</th><th>File bytes</th></tr></thead>
            <tbody>
              {% for src in r.ontology.sources %}
              <tr><td class="nowrap">{{ src.file }}</td><td class="num">{{ src.triples }}</td><td class="mono" title="{{ src.digest }}">{{ src.digest[7:23] }}</td><td class="mono" title="{{ src.content or '' }}">{{ (src.content or "")[7:23] }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <h3>Content addresses</h3>
        <div class="scroll">
          <table class="list">
            <tbody>
              {% if r.provenance.ir_root %}<tr><td class="nowrap">IR root ({{ r.provenance.nodes }} nodes)</td><td class="mono break">{{ r.provenance.ir_root }}</td></tr>{% endif %}
              <tr><td class="nowrap">Toolchain</td><td class="mono break">{{ r.provenance.toolchain }}</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ===================== Changes ===================== -->
      <section class="pane" id="changes">
        <h1>Changes</h1>
        {% set ch = r.changes %}
        {% if ch.state == "untracked" %}
        <p class="lede">This report was generated outside <span class="mono">ucm-codegen build</span>, so there is no lockfile to compare against.</p>
        {% elif ch.state == "first" %}
        <p class="lede">First build: no previous lockfile. The next build is compared against this one.</p>
        {% elif ch.state == "unchanged" %}
        <p class="lede">No changes since the previous build (IR root <span class="mono">{{ ch.previous }}</span>). Every node and output has the same content digest.</p>
        {% else %}
        <p class="lede">Compared with the previous build (IR root <span class="mono">{{ ch.previous }}</span>) by content digest: {{ ch.added }} added, {{ ch.removed }} removed, {{ ch.changed }} changed IR nodes.</p>
        {% if ch.nodes %}
        <div class="scroll">
          <table class="list">
            <thead><tr><th>Change</th><th>Node</th><th>Fields</th></tr></thead>
            <tbody>
              {% for n in ch.nodes %}
              <tr>
                <td><span class="pill {{ {'added': 'green', 'removed': 'red', 'changed': 'amber'}[n.kind] }}">{{ n.kind }}</span></td>
                <td class="nowrap"><span class="muted">{{ n.type }}</span> <b class="mono">{{ n.name }}</b></td>
                <td class="wide">
                  {% for f in n.fields %}
                  <div><span class="mono">{{ f.field }}</span>
                    {% if f.added or f.removed %}
                      {% for a in f.added %}<span class="pill green">+ {{ a }}</span> {% endfor %}
                      {% for d in f.removed %}<span class="pill red">&minus; {{ d }}</span> {% endfor %}
                    {% else %}
                      <span class="mono muted">{{ f.before if f.before is not none else "(none)" }}</span> &rarr; <span class="mono">{{ f.after if f.after is not none else "(none)" }}</span>
                    {% endif %}
                  </div>
                  {% endfor %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
        {% if ch.outputs %}
        <h3>Generated files</h3>
        <div class="scroll">
          <table class="list">
            <thead><tr><th>Change</th><th>File</th></tr></thead>
            <tbody>
              {% for o in ch.outputs %}<tr><td><span class="pill {{ {'added': 'green', 'removed': 'red', 'changed': 'amber'}[o.kind] }}">{{ o.kind }}</span></td><td class="mono">{{ o.path }}</td></tr>{% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
        {% endif %}
      </section>

      <!-- ===================== Lint ===================== -->
      <section class="pane" id="lint">
        <h1>Lint</h1>
        <p class="lede">SHACL-SHACL and ucm-shapes-lint over the shapes graph, plus consistency checks across the ontology, vocabularies and shapes.</p>
        <div class="segmented" role="group" aria-label="Filter by severity">
          <button type="button" class="is-selected" data-severity="all">All {{ r.findings | length }}</button>
          <button type="button" data-severity="Violation">Violations {{ s.violations }}</button>
          <button type="button" data-severity="Warning">Warnings {{ s.warnings }}</button>
          <button type="button" data-severity="Info">Info {{ s.infos }}</button>
        </div>
        {% if r.findings %}
        <div class="scroll">
          <table class="list">
            <thead><tr><th>Severity</th><th>Code</th><th>Subject</th><th>Message</th></tr></thead>
            <tbody>
              {% for f in r.findings %}
              <tr data-level="{{ f.severity }}"><td><span class="pill {{ f.severity }}">{{ f.severity }}</span></td><td class="nowrap mono">{{ f.code }}</td><td class="mono break">{{ f.subject }}</td><td class="wide">{{ f.message }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <div class="group empty">No findings.</div>
        {% endif %}
      </section>

      <!-- ===================== Validation ===================== -->
      <section class="pane" id="validation">
        <h1>Validation</h1>
        <p class="lede">The example data validated against the UCM core shapes with PySHACL, the ontology merged in.</p>
        {% if not s.validated %}
        <div class="group empty">No examples in the build manifest.</div>
        {% elif s.conforms %}
        <div class="group conforms"><span class="pill green">Conforms</span><strong>The example conforms.</strong><span class="soft">Zero results, warnings included.</span></div>
        {% else %}
        <div class="scroll">
          <table class="list">
            <thead><tr><th>Severity</th><th>Tier</th><th>Focus node</th><th>Path</th><th>Message</th></tr></thead>
            <tbody>
              {% for v in r.validation %}
              <tr><td><span class="pill {{ v.severity }}">{{ v.severity }}</span></td><td>{{ v.tier or "" }}</td><td class="mono break">{{ v.focus_node }}</td><td class="mono break">{{ v.result_path or "" }}</td><td class="wide">{{ v.message }}{% if v.value %} <span class="muted mono">{{ v.value }}</span>{% endif %}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
        {% if r.example_warnings %}
        <div class="group">
          <h3>Context compaction</h3>
          <ul class="constraints">
            {% for w in r.example_warnings %}<li><span class="pill Info">Info</span><span>{{ w }}</span></li>{% endfor %}
          </ul>
        </div>
        {% endif %}
      </section>

      <!-- ===================== Classes ===================== -->
      <section class="pane" id="classes">
        <h1>Classes</h1>
        <p class="lede">Each class with the properties it defines and where every property lands: OpenAPI schema type, Postgres column or association table, FHIR element.</p>
        <div class="segmented" role="group" aria-label="Expand or collapse classes">
          <button type="button" data-expand="open">Expand all</button>
          <button type="button" data-expand="close">Collapse all</button>
        </div>
        <div class="classes">
          {% for c in r.classes %}
          <details class="class" data-search="{{ (c.name ~ ' ' ~ c.label ~ ' ' ~ (c.properties | map(attribute='name') | join(' '))) | lower }}">
            <summary style="padding-left: {{ 6 + c.depth * 18 }}px">
              <span class="term">{{ c.name }}</span>
              <span class="mono muted">{{ c.curie }}</span>
              <span class="tags">
                {% if c.resource and c.depth == 1 %}<span class="pill blue">{{ c.resource }}</span>{% endif %}
                {% if c.table and c.depth == 1 %}<span class="pill graphite">{{ c.table }}</span>{% endif %}
                {% if c.fhir %}<span class="pill green">{{ c.fhir.resource }}</span>{% endif %}
                {% if c.properties %}<span class="badge">{{ c.properties | length }}</span>{% endif %}
              </span>
            </summary>
            <div class="class-body">
              {% if c.comment %}<p>{{ c.comment }}</p>{% endif %}
              <div class="meta">
                {% if c.parents %}<span>Extends <b>{{ c.parents | join(", ") }}</b></span>{% endif %}
                {% if c.subclasses %}<span>Subclasses <b>{{ c.subclasses | join(", ") }}</b></span>{% endif %}
                {% if c.table %}<span>Table <b class="mono">{{ c.table }}</b></span>{% endif %}
                {% if c.fhir %}<span>FHIR <b>{{ c.fhir.resource }}</b>{% if c.fhir.via != c.name %} via {{ c.fhir.via }}{% endif %}</span>{% endif %}
                {% if c.examples %}<span>Examples <b>{{ c.examples }}</b></span>{% endif %}
                {% for e in c.equivalents %}<span>≡ <b class="mono">{{ e }}</b></span>{% endfor %}
              </div>
              {% if c.properties %}
              <div class="scroll">
                <table class="list">
                  <thead><tr><th>Property</th><th>Card.</th><th>Range</th><th>OpenAPI</th><th>Postgres</th><th>FHIR</th></tr></thead>
                  <tbody>
                    {% for p in c.properties %}
                    <tr>
                      <td class="nowrap"><b>{{ p.name }}</b>{% if p.recommended %} <span class="pill Info">recommended</span>{% endif %}<br><span class="mono muted">{{ p.curie }}</span></td>
                      <td class="mono nowrap">{{ p.cardinality }}</td>
                      <td class="mono">{% if p.range is string %}{{ p.range }}{% elif p.range %}{{ p.range | join(" · ") }}{% endif %}</td>
                      <td class="mono">{{ p.openapi }}</td>
                      <td class="mono">{% if p.postgres %}{{ p.postgres }}<br><span class="muted">{{ p.postgres_type }}</span>{% else %}<span class="muted">none</span>{% endif %}</td>
                      <td class="mono">{% for f in p.fhir %}{{ f }}{% if not loop.last %}<br>{% endif %}{% else %}<span class="muted">none</span>{% endfor %}</td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              {% endif %}
              {% set constraints = c.constraints + (c.properties | map(attribute="constraints") | sum(start=[])) %}
              {% if constraints %}
              <ul class="constraints">
                {% for k in constraints | unique(attribute="message") %}
                <li><span class="pill {{ k.severity }}">{{ k.tier or k.severity }}</span><span>{{ k.message }}</span></li>
                {% endfor %}
              </ul>
              {% endif %}
            </div>
          </details>
          {% endfor %}
        </div>
        <div class="group empty" id="no-match" hidden>No class matches the filter.</div>
      </section>

      <!-- ===================== Vocabularies ===================== -->
      <section class="pane" id="vocabularies">
        <h1>Vocabularies</h1>
        <p class="lede">SKOS concept schemes. They are open: the API accepts any concept IRI, and the database stores concepts without foreign keys.</p>
        {% for scheme in r.schemes %}
        <div class="group">
          <h3>{{ scheme.name }} <span class="mono muted">{{ scheme.iri }}</span></h3>
          <div class="scroll">
            <table class="list">
              <thead><tr><th>Term</th><th>Label</th><th>Definition</th><th>IRI</th></tr></thead>
              <tbody>
                {% for term, concept in scheme.concepts.items() %}
                <tr><td><b>{{ term }}</b></td><td>{{ concept.label }}</td><td>{{ concept.get("definition", "") }}</td><td class="mono">{{ concept.iri }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
        {% else %}
        <div class="group empty">No concept schemes.</div>
        {% endfor %}
      </section>

      <!-- ===================== OpenAPI ===================== -->
      <section class="pane" id="openapi">
        <h1>OpenAPI</h1>
        <p class="lede">One resource per root class. Writes are validated against the shapes and return a ValidationReport on Definitional violations (422).</p>
        <div class="scroll">
          <table class="list">
            <thead><tr><th>Resource</th><th>Collection</th><th>Item</th><th class="num">Subclasses</th><th>Operations</th></tr></thead>
            <tbody>
              {% for res in r.resources %}
              <tr>
                <td><b>{{ res.name }}</b></td>
                <td class="mono nowrap">{{ res.collection }}</td>
                <td class="mono nowrap">{{ res.item }}</td>
                <td class="num">{{ res.subtypes }}</td>
                <td>{% for method, path, op in res.operations %}<span class="pill method {{ method }}" title="{{ op }} {{ path }}">{{ method }}</span> {% endfor %}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ===================== Postgres ===================== -->
      <section class="pane" id="postgres">
        <h1>Postgres</h1>
        {% if r.sql %}
        <p class="lede">Revision <span class="mono">{{ r.sql.revision }}</span>. One table per root class (single-table inheritance on <span class="mono">type</span>); references are IRIs without foreign keys; only the Definitional tier is enforced.</p>
        <div class="scroll">
          <table class="list">
            <thead><tr><th>Table</th><th>Columns</th><th>Checks</th><th class="num">Classes</th></tr></thead>
            <tbody>
              {% for t in r.sql.tables %}
              <tr>
                <td class="mono"><b>{{ t.name }}</b></td>
                <td class="mono">iri, type{% for col in t.columns %}, {{ col.name }}{% if not col.nullable %} <span class="muted">not null</span>{% endif %}{% endfor %}, extra</td>
                <td class="mono">{% for ck in t.checks %}{{ ck.name }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
                <td class="num">{{ t.type_terms | length }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <h3>Association tables</h3>
        <div class="scroll">
          <table class="list">
            <thead><tr><th>Table</th><th>Property</th><th>Owner</th><th>Value</th></tr></thead>
            <tbody>
              {% for a in r.sql.associations %}
              <tr><td class="mono">{{ a.name }}</td><td>{{ a.term }}</td><td class="mono">{{ a.owner_table or "any node" }}</td><td>{{ a.value }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <div class="group empty">The Postgres target was not built.</div>
        {% endif %}
      </section>

      <!-- ===================== FHIR ===================== -->
      <section class="pane" id="fhir">
        <h1>FHIR</h1>
        <p class="lede">The mapping overlay, validated against the ontology and compiled into the adapter.</p>
        {% for m in r.fhir %}
        <div class="group">
          <h3>{{ m.term }} → {{ m.resource }}{% for role, resource in m.by_role %} <span class="pill graphite">{{ role }} → {{ resource }}</span>{% endfor %}</h3>
          {% if m.fields %}
          <div class="scroll">
            <table class="list">
              <thead><tr><th>FHIR element</th><th>From</th></tr></thead>
              <tbody>
                {% for f in m.fields %}<tr><td class="mono nowrap">{{ m.resource }}.{{ f.path }}</td><td>{{ f.source }}</td></tr>{% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <p class="soft" style="margin:0">Identity only: IRI as identifier, class as meta.tag.</p>
          {% endif %}
        </div>
        {% else %}
        <div class="group empty">No FHIR mapping in the build manifest.</div>
        {% endfor %}
      </section>

      <!-- ===================== Artifacts ===================== -->
      <section class="pane" id="artifacts">
        <h1>Artifacts</h1>
        {% if r.gate.held %}
        <p class="lede">This failed build wrote only this report. The files next to it are the last good build's, with the digests its lockfile recorded.</p>
        {% else %}
        <p class="lede">Files written next to this report, with the content digests recorded in the lockfile.</p>
        {% endif %}
        <div class="scroll">
          <table class="list">
            <thead><tr><th>File</th><th>sha256</th></tr></thead>
            <tbody>
              {% for f, digest in r.files %}<tr><td class="mono"><a href="{{ f }}">{{ f }}</a></td><td class="mono muted" title="{{ digest or '' }}">{{ (digest or "")[7:23] or "(this file)" }}</td></tr>{% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <div class="statusbar">
    <span>{{ r.counts[0][1] }} classes · {{ r.counts[1][1] }} properties · {{ r.counts[5][1] }} resources</span>
    <span class="mono">{{ r.ontology.iri }}</span>
    <span>Generated by ucm-codegen</span>
  </div>
</div>
</div>

<script>
(function () {
  var doc = document;
  doc.documentElement.className += " js";
  var each = function (list, fn) { Array.prototype.forEach.call(list, fn); };
  var links = doc.querySelectorAll("[data-pane]");
  var panes = doc.querySelectorAll(".pane");

  function show(id, remember) {
    if (!doc.getElementById(id) || !doc.getElementById(id).classList.contains("pane")) id = "overview";
    each(panes, function (p) { p.hidden = p.id !== id; });
    each(links, function (a) { a.classList.toggle("is-selected", a.getAttribute("data-pane") === id); });
    // The hash is a bookmark, not the mechanism: sandboxed and data: viewers refuse it
    if (remember) { try { history.replaceState(null, "", "#" + id); } catch (e) { /* not allowed here */ } }
  }
  each(links, function (a) {
    a.addEventListener("click", function (event) {
      event.preventDefault();
      show(a.getAttribute("data-pane"), true);
    });
  });
  window.addEventListener("hashchange", function () { show(location.hash.slice(1)); });
  show(location.hash.slice(1));

  var levels = doc.querySelectorAll("[data-severity]");
  each(levels, function (button) {
    button.addEventListener("click", function () {
      var level = button.getAttribute("data-severity");
      each(levels, function (b) { b.classList.toggle("is-selected", b === button); });
      each(doc.querySelectorAll("#lint tbody tr"), function (row) {
        row.hidden = level !== "all" && row.getAttribute("data-level") !== level;
      });
    });
  });

  each(doc.querySelectorAll("[data-expand]"), function (button) {
    button.addEventListener("click", function () {
      var open = button.getAttribute("data-expand") === "open";
      each(doc.querySelectorAll(".class"), function (d) { if (!d.hidden) d.open = open; });
    });
  });

  var filter = doc.getElementById("filter");
  filter.addEventListener("input", function () {
    var q = filter.value.trim().toLowerCase();
    if (q && doc.getElementById("classes").hidden) show("classes", true);
    var shown = 0;
    each(doc.querySelectorAll(".class"), function (d) {
      d.hidden = q !== "" && d.getAttribute("data-search").indexOf(q) < 0;
      if (!d.hidden) shown++;
    });
    doc.getElementById("no-match").hidden = shown > 0;
  });
})();
</script>
</body>
</html>
