{#- OpenAPI 3.1 reference for the Unified Care Model.
    Scalars go through yaml_str (JSON-quoted); nested values through yaml + indent. -#}
{% macro schema_block(schema) %}
    {{ schema.name | yaml_str }}:
      type: object
      {% if schema.description %}
      description: {{ schema.description | yaml_str }}
      {% endif %}
      {% if schema.curie %}
      x-jsonld-type: {{ schema.curie | yaml_str }}
      {% endif %}
      x-semantic-uri: {{ schema.iri | yaml_str }}
      {% if schema.parents %}
      allOf:
        {% for parent in schema.parents %}
        - $ref: '#/components/schemas/{{ parent }}'
        {% endfor %}
      {% endif %}
      properties:
        {% for prop in schema.properties %}
        {{ prop.name | yaml_str }}:
{{ prop.value_schema | yaml | indent(10, true) }}
          {% if prop.description %}
          description: {{ prop.description | yaml_str }}
          {% endif %}
          {% if prop.extensions %}
{{ prop.extensions | yaml | indent(10, true) }}
          {% endif %}
        {% endfor %}
      {% if schema.required %}
      required: {{ schema.required | yaml_flow }}
      {% endif %}
      {% if schema.extensions %}
{{ schema.extensions | yaml | indent(6, true) }}
      {% endif %}
      {% if schema.examples %}
      examples:
{{ schema.examples | yaml | indent(8, true) }}
      {% endif %}
{% endmacro %}
{% macro operation_block(op, resource) %}
    {{ op.method }}:
      operationId: {{ op.operation_id | yaml_str }}
      tags: [{{ op.tag | yaml_str }}]
      summary: {{ op.summary | yaml_str }}
      description: {{ op.description | yaml_str }}
      {% if op.path == resource.item_path %}
      parameters:
        - $ref: '#/components/parameters/id'
      {% elif op.is_collection and resource.type_terms | length > 1 %}
      parameters:
        - name: type
          in: query
          required: false
          description: Restrict results to one class of the hierarchy.
          schema:
            type: string
            enum: {{ resource.type_terms | yaml_flow }}
      {% endif %}
      {% if op.request_schema %}
      requestBody:
        required: true
        content:
          application/ld+json:
            schema:
              $ref: '#/components/schemas/{{ op.request_schema }}'
      {% endif %}
      responses:
        '{{ op.success_status }}':
          description: {{ ("No content" if op.success_status == 204 else "JSON-LD " + resource.name + (" collection" if op.is_collection else " node")) | yaml_str }}
          {% if op.response_schema %}
          content:
            application/ld+json:
              schema:
                {% if op.is_collection %}
                type: object
                properties:
                  '@context':
                    $ref: '#/components/schemas/JsonLdContext'
                  '@graph':
                    type: array
                    items:
                      $ref: '#/components/schemas/{{ op.response_schema }}'
                required: ['@graph']
                {% else %}
                $ref: '#/components/schemas/{{ op.response_schema }}'
                {% endif %}
          {% endif %}
        {% if op.request_schema %}
        '400':
          $ref: '#/components/responses/BadRequest'
        {% endif %}
        {% if op.path == resource.item_path %}
        '404':
          $ref: '#/components/responses/NotFound'
        {% endif %}
        {% if op.validates %}
        '422':
          $ref: '#/components/responses/ShapeViolation'
        {% endif %}
{% endmacro %}
# Generated by ucm-codegen from {{ spec.ontology_iri }}{{ (" " + spec.ontology_version) if spec.ontology_version else "" }}. DO NOT EDIT.
openapi: 3.1.1
info:
  title: {{ spec.title | yaml_str }}
  version: {{ spec.version | yaml_str }}
  description: {{ spec.description | yaml_str }}

  # ===== SEMANTIC WEB INTEGRATION =====
  # The JSON-LD context maps every schema and property name to its UCM IRI
  x-jsonld-context: {{ spec.context_url | yaml_str }}

  # Provenance: the exact ontology this reference was compiled from
  x-ucm-ontology:
    iri: {{ spec.ontology_iri | yaml_str }}
    {% if spec.ontology_version %}
    version: {{ spec.ontology_version | yaml_str }}
    {% endif %}
    sources:
      {% for source in spec.sources %}
      - file: {{ source.file | yaml_str }}
        digest: {{ source.digest | yaml_str }}
        triples: {{ source.triples }}
      {% endfor %}
  {% if spec.references %}
  x-ucm-references:
    {% for ref in spec.references %}
    - name: {{ ref.name | yaml_str }}
      url: {{ ref.url | yaml_str }}
      {% if ref.note %}
      note: {{ ref.note | yaml_str }}
      {% endif %}
    {% endfor %}
  {% endif %}

servers:
  {% for server in spec.servers %}
  - url: {{ server.url | yaml_str }}
    description: {{ server.description | yaml_str }}
  {% endfor %}

tags:
  {% for resource in spec.resources %}
  - name: {{ resource.name | yaml_str }}
    description: {{ resource.description | yaml_str }}
  {% endfor %}

paths:
  {% for resource in spec.resources %}
  {{ resource.collection_path | yaml_str }}:
    {% for op in resource.operations if op.path == resource.collection_path %}
{{ operation_block(op, resource) }}
    {%- endfor %}
  {{ resource.item_path | yaml_str }}:
    {% for op in resource.operations if op.path == resource.item_path %}
{{ operation_block(op, resource) }}
    {%- endfor %}
  {% endfor %}

components:
  parameters:
    id:
      name: id
      in: path
      required: true
      description: Local identifier of the node. Responses carry its full IRI as @id.
      schema:
        type: string

  responses:
    BadRequest:
      description: The body is not a JSON-LD node object of the expected class.
      content:
        application/problem+json:
          schema:
            $ref: '#/components/schemas/Problem'
    NotFound:
      description: No node with this identifier.
      content:
        application/problem+json:
          schema:
            $ref: '#/components/schemas/Problem'
    ShapeViolation:
      description: The request graph has Definitional (sh:Violation) results against the UCM core shapes.
      content:
        application/ld+json:
          schema:
            $ref: '#/components/schemas/ValidationReport'

  schemas:
    # ===== Support schemas =====
    {% for name, body in spec.support_schemas.items() %}
    {{ name | yaml_str }}:
{{ body | yaml | indent(6, true) }}
    {% endfor %}

    # ===== Concept schemes (open vocabularies) =====
    {% for scheme in spec.concept_schemes %}
    {{ scheme.name | yaml_str }}:
      description: {{ scheme.description | yaml_str }}
      x-semantic-uri: {{ scheme.iri | yaml_str }}
      x-ucm-open-vocabulary: true
      x-ucm-concepts:
{{ scheme.concepts | yaml | indent(8, true) }}
      anyOf:
        - type: string
          enum: {{ scheme.terms | yaml_flow }}
        - $ref: '#/components/schemas/IRI'
    {% endfor %}

    # ===== Ontology classes =====
{{ schema_block(spec.base_schema) }}
{% for schema in spec.schemas %}
{{ schema_block(schema) }}
{% endfor %}
