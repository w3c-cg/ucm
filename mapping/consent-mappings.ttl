@prefix ucm:     <https://www.w3.org/ns/ucm#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix act:     <http://terminology.hl7.org/CodeSystem/v3-ActCode#> .
@prefix conf:    <http://terminology.hl7.org/CodeSystem/v3-Confidentiality#> .
@prefix reason:  <http://terminology.hl7.org/CodeSystem/v3-ActReason#> .
@prefix cact:    <http://terminology.hl7.org/CodeSystem/consentaction#> .
@prefix ccat:    <http://terminology.hl7.org/CodeSystem/consentcategorycodes#> .
@prefix cpol:    <http://terminology.hl7.org/CodeSystem/consentpolicycodes#> .
@prefix cstate:  <http://hl7.org/fhir/consent-state-codes#> .
@prefix cprov:   <http://hl7.org/fhir/consent-provision-type#> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix pd:      <https://w3id.org/dpv/pd#> .
@prefix health:  <https://w3id.org/dpv/sector/health#> .
@prefix legal-eu: <https://w3id.org/dpv/legal/eu#> .

# SKOS links from the UCM consent vocabularies to HL7 code systems and to the
# W3C Data Privacy Vocabulary (DPV 2.3). External matches live here (plan Q12).
# The one exception: where UCM adds nothing to a DPV term, the core uses the
# DPV IRI itself (dpv:hasPurpose, dpv:Collect, pd:Identifying and so on), and
# the HL7 links below attach to that DPV IRI.
#
# Code IRIs are written as <code system URL>#<code>. FHIR identifies a code by
# (system, code) and defines no IRI for it; this is the common convention.
# Codes were checked on 2026-11-27 against HL7/UTG input/sourceOfTruth and
# HL7/fhir source/consent (see doc/design/consent-concepts-plan.md, Appendix A).
#
# UCM-defined concepts with no HL7 code use only closeMatch, broadMatch or
# related (plan section 6.1). Not linked here:
#   - Abortion: SHIFT's SLS value sets use a local placeholder,
#     ExtraSensitiveCodes#ABORTION, marked TODO in its source. Add a closeMatch
#     once SHIFT publishes a stable code.
#   - HMISDataStandards, FERPA, legal-eu:law-GDPR, VAWA, StateLaw:
#     consentpolicycodes has no code for them.
#
# DPV links (second part of this file) follow the DPV reuse audit, 2026-11-28.
# DPV classifies entities (dpv:DataController) where UCM assigns roles in a
# participation, so roles link with closeMatch rather than reuse.

<https://www.w3.org/ns/ucm#consent-mappings> a owl:Ontology ;
    rdfs:label "UCM consent vocabulary mappings to HL7 and DPV" ;
    dcterms:created "2026-11-27" ;
    rdfs:comment "Non-normative SKOS mapping links. Load alongside the core to let HL7-coded data validate against the -anchored shapes." .

# ---------------------------------------------------------------- HL7

ucm:ConsentDraft skos:exactMatch cstate:draft .
ucm:ConsentActive skos:exactMatch cstate:active .
ucm:ConsentInactive skos:exactMatch cstate:inactive .
dpv:ConsentWithdrawn skos:broadMatch cstate:inactive .
dpv:ConsentRevoked skos:broadMatch cstate:inactive .
dpv:ConsentExpired skos:broadMatch cstate:inactive .
ucm:ConsentSuperseded skos:broadMatch cstate:inactive .
dpv:ConsentRefused skos:closeMatch cstate:not-done .
ucm:ConsentEnteredInError skos:exactMatch cstate:entered-in-error .
dpv:ConsentUnknown skos:exactMatch cstate:unknown .
ucm:Permit skos:exactMatch cprov:permit .
ucm:Deny skos:exactMatch cprov:deny .
ucm:ResearchConsent skos:closeMatch ccat:research .
ucm:AdvanceDirective skos:closeMatch ccat:acd .
ucm:TreatmentConsent skos:closeMatch ccat:hcd .
dpv:Collect skos:exactMatch cact:collect .
dpv:Access skos:exactMatch cact:access .
dpv:Use skos:exactMatch cact:use .
dpv:Disclose skos:exactMatch cact:disclose .
ucm:CorrectAction skos:exactMatch cact:correct .
ucm:Treatment skos:exactMatch reason:TREAT .
ucm:EmergencyTreatment skos:exactMatch reason:ETREAT .
ucm:CareCoordination skos:exactMatch reason:COC .
ucm:CareManagement skos:exactMatch reason:CAREMGT .
ucm:Payment skos:exactMatch reason:HPAYMT .
ucm:HealthcareOperations skos:exactMatch reason:HOPERAT .
ucm:EligibilityPurpose skos:exactMatch reason:ELIGDTRM .
dpv:ScientificResearch skos:exactMatch reason:HRESCH .
ucm:PublicHealthPurpose skos:exactMatch reason:PUBHLTH .
ucm:FamilyRequested skos:exactMatch reason:FAMRQT .
ucm:PatientRequested skos:exactMatch reason:PATRQT .
ucm:SocialCareCoordination skos:broadMatch reason:COC .
ucm:SocialCaseManagement skos:closeMatch reason:CAREMGT .
ucm:BenefitsEnrollment skos:broadMatch reason:ELIGDTRM .
ucm:ProgramReporting skos:broadMatch reason:HOPERAT .
pd:Identifying skos:closeMatch act:IDS ;
    skos:closeMatch act:DEMO .
ucm:SubstanceUseDisorder skos:exactMatch act:SUD ;
    skos:closeMatch act:ETH .
ucm:AlcoholUseDisorder skos:exactMatch act:ETHUD .
ucm:OpioidUseDisorder skos:exactMatch act:OPIOIDUD .
ucm:BehavioralHealth skos:exactMatch act:BH .
ucm:MentalHealth skos:exactMatch act:MH .
ucm:PsychiatricDisorder skos:exactMatch act:PSY .
ucm:PsychotherapyNote skos:exactMatch act:PSYTHPN .
ucm:HIV skos:exactMatch act:HIV .
ucm:SexuallyTransmittedDisease skos:exactMatch act:STD .
ucm:SexualAndReproductiveHealth skos:exactMatch act:SEX .
ucm:GenderAndSexualOrientation skos:exactMatch act:GENDER .
ucm:GeneticDisease skos:exactMatch act:GDIS .
ucm:SexualAssaultAbuseDomesticViolence skos:exactMatch act:SDV .
ucm:Adolescent skos:exactMatch act:ADOL .
ucm:Part2Protected skos:exactMatch act:42CFRPart2 .
ucm:Abortion skos:broadMatch act:SEX .
ucm:HumanTrafficking skos:related act:SDV .
ucm:UnaccompaniedYouth skos:related act:ADOL .
ucm:ConfidentialityUnrestricted skos:exactMatch conf:U .
ucm:ConfidentialityLow skos:exactMatch conf:L .
ucm:ConfidentialityModerate skos:exactMatch conf:M .
ucm:ConfidentialityNormal skos:exactMatch conf:N .
ucm:ConfidentialityRestricted skos:exactMatch conf:R .
ucm:ConfidentialityVeryRestricted skos:exactMatch conf:V .
ucm:HIPAAAuthorization skos:exactMatch cpol:hipaa-auth .
ucm:HIPAANoticeOfPrivacyPractices skos:exactMatch cpol:hipaa-npp .
ucm:HIPAAResearch skos:exactMatch cpol:hipaa-research .
ucm:CommonRule skos:closeMatch cpol:cric .
ucm:CFR42Part2 skos:closeMatch act:42CFRPart2 .
ucm:ServiceSpecificMinorConsent skos:closeMatch cpol:illinois-minor-procedure .

# ---------------------------------------------------------------- DPV 2.3

ucm:consentOnBehalfOf rdfs:subPropertyOf dpv:isRepresentativeFor .
ucm:processingLocation rdfs:subPropertyOf dpv:hasLocation .
ucm:acknowledgesNotice rdfs:subPropertyOf dpv:hasNotice .
ucm:governsAction rdfs:subPropertyOf dpv:hasProcessing .
ucm:coversDataCategory rdfs:subPropertyOf dpv:hasPersonalData .
ucm:JurisdictionContext rdfs:subClassOf dpv:Jurisdiction .
ucm:ConsentDirective skos:closeMatch dpv:ConsentRecord .
ucm:ConsentProvision skos:relatedMatch dpv:Permission, dpv:Prohibition .
ucm:ConsentSubjectRole skos:closeMatch dpv:DataSubject .
ucm:ConsentProxyRole skos:closeMatch dpv:GuardianOfDataSubject, dpv:Representative .
ucm:DataControllerRole skos:closeMatch dpv:DataController .
ucm:InformationRecipientRole skos:closeMatch dpv:Recipient .
ucm:ConsentActive skos:closeMatch dpv:ConsentGiven, dpv:RenewedConsentGiven .
ucm:RediscloseAction skos:broadMatch dpv:Disclose .
ucm:CorrectAction skos:broadMatch dpv:Modify .
ucm:EligibilityPurpose skos:narrowMatch health:EligibilityAssessment .
ucm:SocialServicesReferral skos:narrowMatch health:ReferralManagement .
ucm:SocialCaseManagement skos:narrowMatch health:SocialServicesProvision .
ucm:EmergencyTreatment skos:closeMatch health:EmergencyCareManagement .
ucm:PublicHealthPurpose skos:narrowMatch health:PublicHealthMonitoring, health:PublicHealthSurveillance .
ucm:Payment skos:closeMatch dpv:PaymentManagement .
ucm:PatientRequested skos:closeMatch dpv:RequestedServiceProvision .
ucm:ClinicalInformation skos:closeMatch pd:MedicalHealth .
ucm:BehavioralHealthInformation skos:narrowMatch pd:MentalHealth .
ucm:IncomeAndBenefitsInformation skos:narrowMatch pd:Income .
ucm:JusticeInformation skos:closeMatch pd:Criminal .
ucm:RetentionDelete skos:closeMatch dpv:Erase, dpv:Delete .
ucm:RetentionDeidentify skos:broadMatch dpv:Anonymise, dpv:Pseudonymise .
ucm:RetentionArchive skos:relatedMatch dpv:Store, dpv:Restrict .
ucm:InferredConsent skos:closeMatch dpv:ImpliedConsent .
ucm:WrittenConsent skos:broadMatch dpv:ExpressedConsent .
ucm:ElectronicConsent skos:broadMatch dpv:ExpressedConsent .
ucm:VerbalConsent skos:broadMatch dpv:ExpressedConsent .
ucm:ConsentGrant skos:relatedMatch dpv:ProvideConsent .
ucm:ConsentRefusal skos:relatedMatch dpv:RefuseConsent .
ucm:ConsentRenewal skos:relatedMatch dpv:ReaffirmConsent .
ucm:ConsentRevocation skos:relatedMatch dpv:WithdrawConsent .
ucm:Permit skos:relatedMatch dpv:Permission .
ucm:Deny skos:relatedMatch dpv:Prohibition .
ucm:MentalHealth skos:closeMatch pd:MentalHealth .
ucm:GeneticDisease skos:closeMatch pd:Genetic .
