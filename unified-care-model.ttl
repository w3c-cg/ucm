<urn:w3c:cg:ucm#> rdf:type owl:Ontology ;
                   owl:versionIRI <urn:w3c:cg:ucm#0.0.1> ;
                   rdfs:comment "Complete UCM model including Core, Participation, and Domain semantic layers." ;
                   rdfs:label "Unified Care Model" ;
                   owl:versionInfo "v0.0.1" .

#################################################################
#    Object Properties
#################################################################

###  http://mdix.org/ucm#affiliatedWith
mdix:affiliatedWith rdf:type owl:ObjectProperty ;
                    rdfs:domain mdix:Person ;
                    rdfs:range mdix:Organization ;
                    rdfs:label "affiliated with" .


###  http://mdix.org/ucm#assumesRole
mdix:assumesRole rdf:type owl:ObjectProperty ;
                 rdfs:domain mdix:Participation ;
                 rdfs:range mdix:Role ;
                 rdfs:label "assumes role" .


###  http://mdix.org/ucm#definedByArtifact
mdix:definedByArtifact rdf:type owl:ObjectProperty ;
                       rdfs:domain mdix:SemanticContext ;
                       rdfs:range mdix:DefinitionArtifact ;
                       rdfs:label "defined by artifact" .


###  http://mdix.org/ucm#definedByCriteria
mdix:definedByCriteria rdf:type owl:ObjectProperty ;
                       rdfs:domain mdix:SocialGroupEntity ;
                       rdfs:range mdix:MembershipCriteria ;
                       rdfs:label "defined by criteria" .


###  http://mdix.org/ucm#generatedByProcess
mdix:generatedByProcess rdf:type owl:ObjectProperty ;
