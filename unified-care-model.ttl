mdix:hasClient rdf:type owl:ObjectProperty ;
               rdfs:domain mdix:SocialCareInteraction ;
               rdfs:range mdix:Person ;
               rdfs:comment "Convenience projection derived from participation semantics." ;
               rdfs:label "has client" .


###  http://mdix.org/ucm#hasMember
mdix:hasMember rdf:type owl:ObjectProperty ;
               rdfs:domain mdix:SocialGroupEntity ;
               rdfs:range mdix:Entity ;
