@prefix : <https://w3.org/ns/ucm#> .
@prefix cco: <https://www.commoncoreontologies.org/AgentOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ucm: <https://w3.org/ns/ucm#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix snomedct: <http://purl.bioontology.org/ontology/SNOMEDCT#> .
@prefix ncbitaxon: <http://purl.obolibrary.org/obo/NCBITaxon#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@base <https://w3.org/ns/ucm#> .

<https://w3.org/ns/ucm#> rdf:type owl:Ontology ;
                   owl:versionIRI <https://w3.org/ns/ucm#0.0.1> ;
                   rdfs:comment "Complete UCM model including Core, Participation, and Domain semantic layers." ;
                   rdfs:label "Unified Care Model" ;
                   owl:versionInfo "v0.0.1" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3.org/ns/ucm#affiliatedWith
ucm:affiliatedWith rdf:type owl:ObjectProperty ;
                   rdfs:domain ucm:Person ;
                   rdfs:range ucm:Organization ;
                   rdfs:label "affiliated with" .


###  https://w3.org/ns/ucm#assumesRole
ucm:assumesRole rdf:type owl:ObjectProperty ;
                rdfs:domain ucm:Participation ;
                rdfs:range ucm:Role ;
                rdfs:label "assumes role" .


###  https://w3.org/ns/ucm#definedByArtifact
ucm:definedByArtifact rdf:type owl:ObjectProperty ;
                      rdfs:domain ucm:SemanticContext ;
                      rdfs:range ucm:DefinitionArtifact ;
                      rdfs:label "defined by artifact" .


###  https://w3.org/ns/ucm#definedByCriteria
ucm:definedByCriteria rdf:type owl:ObjectProperty ;
                      rdfs:domain ucm:SocialGroupEntity ;
                      rdfs:range ucm:MembershipCriteria ;
                      rdfs:label "defined by criteria" .


###  https://w3.org/ns/ucm#generatedByProcess
ucm:generatedByProcess rdf:type owl:ObjectProperty ;
                       rdfs:domain ucm:Statement ;
                       rdfs:range ucm:Process ;
                       rdfs:label "generated by process" .


###  https://w3.org/ns/ucm#hasClient
ucm:hasClient rdf:type owl:ObjectProperty ;
              rdfs:domain ucm:SocialCareInteraction ;
              rdfs:range ucm:Person ;
              rdfs:comment "Convenience projection derived from participation semantics." ;
              rdfs:label "has client" .


###  https://w3.org/ns/ucm#hasMember
ucm:hasMember rdf:type owl:ObjectProperty ;
              rdfs:domain ucm:SocialGroupEntity ;
              rdfs:range ucm:Entity ;
              rdfs:label "has member" .


###  https://w3.org/ns/ucm#hasMembership
ucm:hasMembership rdf:type owl:ObjectProperty ;
                  rdfs:domain ucm:Entity ;
                  rdfs:range ucm:Membership ;
                  rdfs:label "has membership" .


###  https://w3.org/ns/ucm#hasParticipant
ucm:hasParticipant rdf:type owl:ObjectProperty ;
                   rdfs:domain ucm:Process ;
                   rdfs:range ucm:Participation ;
                   rdfs:label "has participant" .


###  https://w3.org/ns/ucm#hasPatient
ucm:hasPatient rdf:type owl:ObjectProperty ;
               rdfs:domain ucm:ClinicalEncounter ;
               rdfs:range ucm:Person ;
               rdfs:comment "Convenience projection derived from participation semantics." ;
               rdfs:label "has patient" .


###  https://w3.org/ns/ucm#hasResident
ucm:hasResident rdf:type owl:ObjectProperty ;
                rdfs:domain ucm:HousingAssessment ;
                rdfs:range ucm:Person ;
                rdfs:comment "Convenience projection derived from participation semantics." ;
                rdfs:label "has resident" .


###  https://w3.org/ns/ucm#locatedAt
ucm:locatedAt rdf:type owl:ObjectProperty ;
              rdfs:domain ucm:Entity ;
              rdfs:range ucm:Location ;
              rdfs:label "located at" .


###  https://w3.org/ns/ucm#madeWithinContext
ucm:madeWithinContext rdf:type owl:ObjectProperty ;
                      rdfs:domain ucm:Statement ;
                      rdfs:range ucm:SemanticContext ;
                      rdfs:label "made within context" .


###  https://w3.org/ns/ucm#memberOf
ucm:memberOf rdf:type owl:ObjectProperty ;
             rdfs:domain ucm:Entity ;
             rdfs:range ucm:SocialGroupEntity ;
             rdfs:label "member of" .


###  https://w3.org/ns/ucm#membershipIn
ucm:membershipIn rdf:type owl:ObjectProperty ;
                 rdfs:domain ucm:Membership ;
                 rdfs:range ucm:SocialGroupEntity ;
                 rdfs:label "membership in" .


###  https://w3.org/ns/ucm#occursWithin
ucm:occursWithin rdf:type owl:ObjectProperty ;
                 rdfs:domain ucm:Participation ;
                 rdfs:range ucm:Process ;
                 rdfs:label "occurs within" .


###  https://w3.org/ns/ucm#participatesThrough
ucm:participatesThrough rdf:type owl:ObjectProperty ;
                        rdfs:domain ucm:Entity ;
                        rdfs:range ucm:Participation ;
                        rdfs:label "participates through" .


###  https://w3.org/ns/ucm#participatingEntity
ucm:participatingEntity rdf:type owl:ObjectProperty ;
                        rdfs:domain ucm:Participation ;
                        rdfs:range ucm:Entity ;
                        rdfs:label "participating entity" .


###  https://w3.org/ns/ucm#participationContext
ucm:participationContext rdf:type owl:ObjectProperty ;
                         rdfs:domain ucm:Participation ;
                         rdfs:range ucm:SemanticContext ;
                         rdfs:label "participation context" .


###  https://w3.org/ns/ucm#qualifiesForMembership
ucm:qualifiesForMembership rdf:type owl:ObjectProperty ;
                           rdfs:domain ucm:Entity ;
                           rdfs:range ucm:MembershipCriteria ;
                           rdfs:label "qualifies for membership" .


###  https://w3.org/ns/ucm#scopedBy
ucm:scopedBy rdf:type owl:ObjectProperty ;
             rdfs:domain ucm:Participation ;
             rdfs:range ucm:SemanticContext ;
             rdfs:label "scoped by" .


###  https://w3.org/ns/ucm#statementSubject
ucm:statementSubject rdf:type owl:ObjectProperty ;
                     rdfs:domain ucm:Statement ;
                     rdfs:range ucm:Participation ;
                     rdfs:comment "Relates a statement to the contextual participation it is about." ;
                     rdfs:label "statement subject" .

###  https://w3.org/ns/ucm#hasLifecycleState
ucm:hasLifecycleState rdf:type owl:ObjectProperty ;
                    rdfs:domain ucm:Process ;
                    rdfs:range skos:Concept ;
                    rdfs:label "has lifecycle state" ;
                    rdfs:comment "Relates a process to a lifecycle state." .

###  https://w3.org/ns/ucm#hasActivityFocus
ucm:hasActivityFocus rdf:type owl:ObjectProperty ;
                    rdfs:domain ucm:Process ; 
                    rdfs:range ucm:ActivityFocus ; 
                    rdfs:label "has activity focus" ; 
                    rdfs:comment "Situates a process within an activity focus." .
# An example: patient discharge has the activity focus of safely discharging a patient. 

###  https://w3.org/ns/ucm#negotiates
ucm:negotiates rdf:type owl:ObjectProperty ;
                    rdfs:domain ucm:Handshake ;
                    rdfs:range ucm:Process ;
                    rdfs:label "negotiates" ;
                    rdfs:comment "Relates a handshake to the care coordination process whose participation relationship it negotiates." .

###  https://w3.org/ns/ucm#acceptsRequest
ucm:acceptsRequest rdf:type owl:ObjectProperty ;
                    rdfs:domain ucm:Entity ;
                    rdfs:range ucm:ParticipationContext ;
                    rdfs:label "accepts request" ;
                    rdfs:comment "A participating entity accepts a care coordination request." .

###  https://w3.org/ns/ucm#hasTemporalContext
ucm:hasTemporalContext rdf:type owl:ObjectProperty ;
                    rdfs:range time:TemporalEntity ;
                    rdfs:label "has temporal context" ;
                    rdfs:comment "Relates a UCM semantic subject to a temporal entity that qualifies when that subject occurs, obtains, applies, participates, or is otherwise temporally situated." .

###  https://w3.org/ns/ucm#hasCareTrajectoryContext
ucm:hasCareTrajectoryContext rdf:type owl:ObjectProperty ;
                    rdfs:label "has care trajectory context" ;
                    rdfs:comment "Relates a UCM semantic subject to a temporal position or extent defined relative to the internal progression of a process, state trajectory, or coordinated activity rather than directly relative to an external clock or calendar." .
# This property separates clock time and state-relative time along the trajectory or progression of someone's care. 
# That grants discernment in scenarios like "the patient referral was accepted after the assessment but before discharge, but 
# we may not have all of the exact timestamps across each event." 

###  https://w3.org/ns/ucm#validDuring
ucm:validDuring rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf ucm:hasTemporalContext ;
                    rdfs:range time:TemporalEntity ;
                    rdfs:label "valid during" ;
                    rdfs:comment "Relates a semantic subject or statement to the temporal extent during which its described condition, state, relationship, participation, or other semantics apply." .

###  https://w3.org/ns/ucm#enactiveDuring
ucm:enactiveDuring rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf ucm:hasTemporalContext ;
                    rdfs:domain ucm:Participation ;
                    rdfs:range time:TemporalEntity ;
                    rdfs:label "enactive during" ;
                    rdfs:comment "Relates a participation to the temporal extent during which that participation is enactive." .

###  https://w3.org/ns/ucm#occursDuring
ucm:occursDuring rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf ucm:hasTemporalContext ;
                    rdfs:domain ucm:Process ;
                    rdfs:range time:TemporalEntity ;
                    rdfs:label "occurs during" ;
                    rdfs:comment "Relates a process to the temporal extent during which the process occurs." .

#################################################################
#    Data properties
#################################################################

###  https://w3.org/ns/ucm#statementDate
ucm:statementDate rdf:type owl:DatatypeProperty ;
                  rdfs:domain ucm:Statement ;
                  rdfs:range xsd:dateTime ;
                  rdfs:label "statement date" .


###  https://w3.org/ns/ucm#validFrom
ucm:validFrom rdf:type owl:DatatypeProperty ;
              rdfs:domain ucm:Participation ;
              rdfs:range xsd:dateTime ;
              rdfs:label "valid from" .


###  https://w3.org/ns/ucm#validTo
ucm:validTo rdf:type owl:DatatypeProperty ;
            rdfs:domain ucm:Participation ;
            rdfs:range xsd:dateTime ;
            rdfs:label "valid to" .


#################################################################
#    Classes
#################################################################

###  http://purl.bioontology.org/ontology/SNOMEDCT#337915000
<http://purl.bioontology.org/ontology/SNOMEDCT#337915000> rdf:type owl:Class ;
                                                          owl:equivalentClass ucm:Person ;
                                                          rdfs:label "Homo sapiens" .


###  http://purl.obolibrary.org/obo/NCBITaxon#9606
<http://purl.obolibrary.org/obo/NCBITaxon#9606> rdf:type owl:Class ;
                                                owl:equivalentClass ucm:Person ;
                                                rdfs:label "Homo sapiens" .


###  https://www.commoncoreontologies.org/AgentOntology#ont00001262
cco:ont00001262 rdf:type owl:Class ;
                owl:equivalentClass ucm:Person ;
                rdfs:label "Person" ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "Human" .


###  https://w3.org/ns/ucm#BehavioralHealthContext
ucm:BehavioralHealthContext rdf:type owl:Class ;
                            rdfs:subClassOf ucm:SemanticContext ;
                            rdfs:label "Behavioral Health Context" .


###  https://w3.org/ns/ucm#BehavioralHealthDomain
ucm:BehavioralHealthDomain rdf:type owl:Class ;
                           rdfs:label "Behavioral Health Domain" .


###  https://w3.org/ns/ucm#BeneficiaryRole
ucm:BeneficiaryRole rdf:type owl:Class ;
                    rdfs:subClassOf ucm:SubjectRole ;
                    rdfs:label "Beneficiary Role" .


###  https://w3.org/ns/ucm#CareCoordinationInteraction
ucm:CareCoordinationInteraction rdf:type owl:Class ;
                                rdfs:subClassOf ucm:Process ;
                                rdfs:label "Care Coordination Interaction" .


###  https://w3.org/ns/ucm#CareCoordinationStatement
ucm:CareCoordinationStatement rdf:type owl:Class ;
                              rdfs:subClassOf ucm:Statement ;
                              rdfs:label "Care Coordination Statement" .


###  https://w3.org/ns/ucm#CareTeam
ucm:CareTeam rdf:type owl:Class ;
             rdfs:subClassOf ucm:SocialGroupEntity ;
             rdfs:label "Care Team" .


###  https://w3.org/ns/ucm#CaregiverRole
ucm:CaregiverRole rdf:type owl:Class ;
                  rdfs:subClassOf ucm:Role ;
                  rdfs:label "Caregiver Role" .


###  https://w3.org/ns/ucm#ClientRole
ucm:ClientRole rdf:type owl:Class ;
               rdfs:subClassOf ucm:SubjectRole ;
               rdfs:label "Client Role" .


###  https://w3.org/ns/ucm#ClinicalCareContext
ucm:ClinicalCareContext rdf:type owl:Class ;
                        rdfs:subClassOf ucm:SemanticContext ;
                        rdfs:label "Clinical Care Context" .


###  https://w3.org/ns/ucm#ClinicalDomain
ucm:ClinicalDomain rdf:type owl:Class ;
                   rdfs:label "Clinical Domain" .


###  https://w3.org/ns/ucm#ClinicalEncounter
ucm:ClinicalEncounter rdf:type owl:Class ;
                      rdfs:subClassOf ucm:Encounter ;
                      rdfs:label "Clinical Encounter" .


###  https://w3.org/ns/ucm#ClinicalStatement
ucm:ClinicalStatement rdf:type owl:Class ;
                      rdfs:subClassOf ucm:Statement ;
                      rdfs:label "Clinical Statement" .


###  https://w3.org/ns/ucm#CommunityGroup
ucm:CommunityGroup rdf:type owl:Class ;
                   rdfs:subClassOf ucm:SocialGroupEntity ;
                   rdfs:label "Community Group" .


###  https://w3.org/ns/ucm#CoordinatorRole
ucm:CoordinatorRole rdf:type owl:Class ;
                    rdfs:subClassOf ucm:Role ;
                    rdfs:label "Coordinator Role" .


###  https://w3.org/ns/ucm#DefinitionArtifact
ucm:DefinitionArtifact rdf:type owl:Class ;
                       rdfs:comment "A ruleset, policy definition, constraint, or governance artifact." ;
                       rdfs:label "Definition Artifact" .


###  https://w3.org/ns/ucm#Device
ucm:Device rdf:type owl:Class ;
           rdfs:subClassOf ucm:Entity ;
           rdfs:label "Device" .


###  https://w3.org/ns/ucm#DiagnosisStatement
ucm:DiagnosisStatement rdf:type owl:Class ;
                       rdfs:subClassOf ucm:ClinicalStatement ;
                       rdfs:label "Diagnosis Statement" .


###  https://w3.org/ns/ucm#EligibilityDetermination
ucm:EligibilityDetermination rdf:type owl:Class ;
                             rdfs:subClassOf ucm:Process ;
                             rdfs:label "Eligibility Determination" .


###  https://w3.org/ns/ucm#EligibilityRuleset
ucm:EligibilityRuleset rdf:type owl:Class ;
                       rdfs:subClassOf ucm:DefinitionArtifact ;
                       rdfs:label "Eligibility Ruleset" .


###  https://w3.org/ns/ucm#Encounter
ucm:Encounter rdf:type owl:Class ;
              rdfs:subClassOf ucm:Process ;
              rdfs:comment "A bounded contextual interaction process." ;
              rdfs:label "Encounter" .


###  https://w3.org/ns/ucm#Entity
ucm:Entity rdf:type owl:Class ;
           rdfs:comment "A stable independently identifiable semantic thing." ;
           rdfs:label "Entity" .


###  https://w3.org/ns/ucm#Household
ucm:Household rdf:type owl:Class ;
              rdfs:subClassOf ucm:SocialGroupEntity ;
              rdfs:label "Household" .


###  https://w3.org/ns/ucm#HousingAssessment
ucm:HousingAssessment rdf:type owl:Class ;
                      rdfs:subClassOf ucm:Process ;
                      rdfs:label "Housing Assessment" .


###  https://w3.org/ns/ucm#HousingContext
ucm:HousingContext rdf:type owl:Class ;
                   rdfs:subClassOf ucm:SemanticContext ;
                   rdfs:label "Housing Context" .


###  https://w3.org/ns/ucm#HousingDomain
ucm:HousingDomain rdf:type owl:Class ;
                  rdfs:label "Housing Domain" .


###  https://w3.org/ns/ucm#HousingEligibilityContext
ucm:HousingEligibilityContext rdf:type owl:Class ;
                              rdfs:subClassOf ucm:HousingContext ;
                              rdfs:label "Housing Eligibility Context" .


###  https://w3.org/ns/ucm#HousingEligibilityStatement
ucm:HousingEligibilityStatement rdf:type owl:Class ;
                                rdfs:subClassOf ucm:HousingStatement ;
                                rdfs:label "Housing Eligibility Statement" .


###  https://w3.org/ns/ucm#HousingStatement
ucm:HousingStatement rdf:type owl:Class ;
                     rdfs:subClassOf ucm:Statement ;
                     rdfs:label "Housing Statement" .


###  https://w3.org/ns/ucm#InformationArtifact
ucm:InformationArtifact rdf:type owl:Class ;
                        rdfs:subClassOf ucm:Entity ;
                        rdfs:comment "A logical information abstraction or computable information object." ;
                        rdfs:label "Information Artifact" .


###  https://w3.org/ns/ucm#Location
ucm:Location rdf:type owl:Class ;
             rdfs:subClassOf ucm:Entity ;
             rdfs:label "Location" .


###  https://w3.org/ns/ucm#Membership
ucm:Membership rdf:type owl:Class ;
               rdfs:comment "Contextual membership relationship between an Entity and a SocialGroupEntity." ;
               rdfs:label "Membership" .


###  https://w3.org/ns/ucm#MembershipCriteria
ucm:MembershipCriteria rdf:type owl:Class ;
                       rdfs:comment "Rules or conditions defining membership within a SocialGroupEntity." ;
                       rdfs:label "Membership Criteria" .


###  https://w3.org/ns/ucm#ObservationStatement
ucm:ObservationStatement rdf:type owl:Class ;
                         rdfs:subClassOf ucm:ClinicalStatement ;
                         rdfs:label "Observation Statement" .


###  https://w3.org/ns/ucm#Organization
ucm:Organization rdf:type owl:Class ;
                 rdfs:subClassOf ucm:Entity ;
                 rdfs:comment "Operational or governance-oriented social entity maintaining continuity independent of membership changes." ;
                 rdfs:label "Organization" .


###  https://w3.org/ns/ucm#Participation
ucm:Participation rdf:type owl:Class ;
                  rdfs:comment "Contextual involvement of an Entity within a Process and Semantic Context." ;
                  rdfs:label "Participation" .


###  https://w3.org/ns/ucm#PatientRole
ucm:PatientRole rdf:type owl:Class ;
                rdfs:subClassOf ucm:SubjectRole ;
                rdfs:label "Patient Role" .


###  https://w3.org/ns/ucm#Person
ucm:Person rdf:type owl:Class ;
           rdfs:subClassOf ucm:Entity ;
           rdfs:comment "A homo sapiens (NCBI) with the social context of a Person.  Looking for an object property of cco:PersonRole to have a \"similar to\" skos: relationship." ;
           rdfs:label "Person" .


###  https://w3.org/ns/ucm#PolicyDefinition
ucm:PolicyDefinition rdf:type owl:Class ;
                     rdfs:subClassOf ucm:DefinitionArtifact ;
                     rdfs:label "Policy Definition" .


###  https://w3.org/ns/ucm#Process
ucm:Process rdf:type owl:Class ;
            rdfs:comment "A bounded interaction or activity occurring over time." ;
            rdfs:label "Process" .


###  https://w3.org/ns/ucm#ProgramDefinition
ucm:ProgramDefinition rdf:type owl:Class ;
                      rdfs:subClassOf ucm:DefinitionArtifact ;
                      rdfs:label "Program Definition" .


###  https://w3.org/ns/ucm#ProviderRole
ucm:ProviderRole rdf:type owl:Class ;
                 rdfs:subClassOf ucm:Role ;
                 rdfs:label "Provider Role" .


###  https://w3.org/ns/ucm#PublicHealthContext
ucm:PublicHealthContext rdf:type owl:Class ;
                        rdfs:subClassOf ucm:SemanticContext ;
                        rdfs:label "Public Health Context" .


###  https://w3.org/ns/ucm#PublicHealthDomain
ucm:PublicHealthDomain rdf:type owl:Class ;
                       rdfs:label "Public Health Domain" .


###  https://w3.org/ns/ucm#ResidentRole
ucm:ResidentRole rdf:type owl:Class ;
                 rdfs:subClassOf ucm:SubjectRole ;
                 rdfs:label "Resident Role" .


###  https://w3.org/ns/ucm#Role
ucm:Role rdf:type owl:Class ;
         rdfs:comment "A contextual, anti-rigid classification assumed through participation." ;
         rdfs:label "Role" .


###  https://w3.org/ns/ucm#SemanticConstraint
ucm:SemanticConstraint rdf:type owl:Class ;
                       rdfs:subClassOf ucm:DefinitionArtifact ;
                       rdfs:label "Semantic Constraint" .


###  https://w3.org/ns/ucm#SemanticContext
ucm:SemanticContext rdf:type owl:Class ;
                    rdfs:comment "An interpretive environment, governance scope, or applicability boundary." ;
                    rdfs:label "Semantic Context" .


###  https://w3.org/ns/ucm#SocialCareContext
ucm:SocialCareContext rdf:type owl:Class ;
                      rdfs:subClassOf ucm:SemanticContext ;
                      rdfs:label "Social Care Context" .


###  https://w3.org/ns/ucm#SocialCareDomain
ucm:SocialCareDomain rdf:type owl:Class ;
                     rdfs:label "Social Care Domain" .


###  https://w3.org/ns/ucm#SocialCareInteraction
ucm:SocialCareInteraction rdf:type owl:Class ;
                          rdfs:subClassOf ucm:Process ;
                          rdfs:label "Social Care Interaction" .


###  https://w3.org/ns/ucm#SocialCareStatement
ucm:SocialCareStatement rdf:type owl:Class ;
                        rdfs:subClassOf ucm:Statement ;
                        rdfs:label "Social Care Statement" .


###  https://w3.org/ns/ucm#SocialGroupEntity
ucm:SocialGroupEntity rdf:type owl:Class ;
                      rdfs:subClassOf ucm:Entity ;
                      rdfs:comment "A collective grouping of participating entities." ;
                      rdfs:label "Social Group Entity" .


###  https://w3.org/ns/ucm#Statement
ucm:Statement rdf:type owl:Class ;
              rdfs:comment "An informational assertion, finding, determination, or conclusion." ;
              rdfs:label "Statement" .


###  https://w3.org/ns/ucm#SubjectRole
ucm:SubjectRole rdf:type owl:Class ;
                rdfs:subClassOf ucm:Role ;
                rdfs:label "Subject Role" .

###  https://w3.org/ns/ucm#CoordinationRequest
ucm:CoordinationRequest rdf:type owl:Class ;
    rdfs:subClassOf ucm:Process ;
                rdfs:label "Care Coordination Request" ; 
                rdfs:comment "A process in which coordination is requested between participating entities." .

###  https://w3.org/ns/ucm#CoordinativeActivity
ucm:CoordinativeActivity rdf:type owl:Class ;
    rdfs:subClassOf ucm:Process ;
                rdfs:label "Coordinative Care Activity" ;
                rdfs:comment "A situated activity whose process is shared by participating entities in its care coordination lifecycle." .

###  https://w3.org/ns/ucm#Handshake
ucm:Handshake rdf:type owl:Class ; 
    rdfs:subClassOf ucm:CoordinativeActivity ; 
                rdfs:label "Handshake" ; 
                rdfs:comment "A coordinative process through which participating entities negotiate mutual participation in a shared activity." .

###  https://w3.org/ns/ucm#ActivityFocus
ucm:ActivityFocus rdf:type owl:Class ;
                rdfs:label "Activity Focus" ;
                rdfs:comment "The matter, condition, or situation toward which a coordinated activity is orchestrated and which the activity seeks to jointly maintain, update, resolve, or bring about." . 
# Examples for this may include: housing stability, food security, shelter connection, patient discharge. This is semantically separate from a motive or goal-directed outcome, since it's more specifically defining what is being worked on as a shared process. 

###  https://w3.org/ns/ucm#MatchClaim
ucm:MatchClaim rdf:type owl:Class ; 
    rdfs:subClassOf ucm:Statement ; 
                rdfs:label "Match Claim" ;
                rdfs:comment "An assertion that two or more entity references co-refer to the same identifiable entity." . 
# Examples for this may include scenarios where healthcare and human services organizations are establishing an identity resolution claim for a shared patient.

###  https://w3.org/ns/ucm#CareTrajectoryContext
ucm:CareTrajectoryContext rdf:type owl:Class ;
                rdfs:label "Care Trajectory Context" ;
                rdfs:comment "A position or extent defined relative to the progression of a care process, state trajectory, or coordinated activity, which does not require anchoring to clock or calendar time." .

###  urn:w3c:cg:ucm#CareCommitment
ucm:CareCommitment rdf:type owl:Class ;
                rdfs:label "Care Commitment" ;
                rdfs:comment "A continuing agreement among participants to coordinate care toward a joint purpose, according to terms or conditions that may evolve." .

###  urn:w3c:cg:ucm#CareCoverageRequirement
ucm:CareCoverageRequirement rdf:type owl:Class ;
                rdfs:label "Care Coverage Requirement" ;
                rdfs:comment "A requirement that some participation in care coordination concerns an activity focus, in a given role, over a defined context or interval." .

###  urn:w3c:cg:ucm#CareCoverageGap
ucm:CareCoverageGap rdf:type owl:Class ;
                rdfs:label "Care Coverage Gap" ;
                rdfs:comment "A condition in which a care coverage requirement is in force but is not satisfied by any applicable in-force care commitment during a specified interval." .










