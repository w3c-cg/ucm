@prefix : <https://www.w3.org/ns/ucm#> .
@prefix cco: <https://www.commoncoreontologies.org/AgentOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ucm: <https://www.w3.org/ns/ucm#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix snomedct: <http://purl.bioontology.org/ontology/SNOMEDCT#> .
@prefix ncbitaxon: <http://purl.obolibrary.org/obo/NCBITaxon#> .
@prefix ucm-shapes: <https://www.w3.org/ns/ucm#shapes> .
@prefix ucm-lifecycle: <https://www.w3.org/ns/ucm#lifecycle> .
@prefix ucm-shapes-lint: <https://www.w3.org/ns/ucm#shapes-lint> .
@prefix ucm-participation-membership: <https://www.w3.org/ns/ucm#participation-membership> .
@base <https://www.w3.org/ns/ucm#> .

<https://www.w3.org/ns/ucm#> rdf:type owl:Ontology ;
                              owl:versionIRI <https://www.w3.org/ns/ucm#0.0.1> ;
                              owl:imports ucm:lifecycle ,
                                          ucm:shapes ,
                                          <https://www.w3.org/ns/ucm#participation-membership/0.0.1> ,
                                          <https://www.w3.org/ns/ucm#shapes-lint/1.0.0> ;
                              rdfs:comment "Complete UCM model including Core, Participation, and Domain semantic layers." ;
                              rdfs:label "Unified Care Model" ;
                              owl:versionInfo "v0.0.1" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://www.w3.org/ns/ucm#acceptsRequest
ucm:acceptsRequest rdf:type owl:ObjectProperty ;
                   rdfs:domain ucm:Entity ;
                   rdfs:range ucm:Participation ;
                   rdfs:comment "A participating entity accepts a care coordination request." ;
                   rdfs:label "accepts request" .


###  https://www.w3.org/ns/ucm#affiliatedWith
ucm:affiliatedWith rdf:type owl:ObjectProperty ;
                   rdfs:domain ucm:Person ;
                   rdfs:range ucm:Organization ;
                   rdfs:label "affiliated with" .


###  https://www.w3.org/ns/ucm#assumesRole
ucm:assumesRole rdf:type owl:ObjectProperty ;
                rdfs:domain ucm:Participation ;
                rdfs:range ucm:Role ;
                rdfs:label "assumes role" .


###  https://www.w3.org/ns/ucm#definedByArtifact
ucm:definedByArtifact rdf:type owl:ObjectProperty ;
                      rdfs:domain ucm:SemanticContext ;
                      rdfs:range ucm:DefinitionArtifact ;
                      rdfs:label "defined by artifact" .


###  https://www.w3.org/ns/ucm#definedByCriteria
ucm:definedByCriteria rdf:type owl:ObjectProperty ;
                      rdfs:domain ucm:SocialGroupEntity ;
                      rdfs:range ucm:MembershipCriteria ;
                      rdfs:label "defined by criteria" .


###  https://www.w3.org/ns/ucm#enactiveDuring
ucm:enactiveDuring rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf ucm:hasTemporalContext ;
                   rdfs:domain ucm:Participation ;
                   rdfs:range time:TemporalEntity ;
                   rdfs:comment "Relates a participation to the temporal extent during which that participation is enactive." ;
                   rdfs:label "enactive during" .


###  https://www.w3.org/ns/ucm#generatedByProcess
ucm:generatedByProcess rdf:type owl:ObjectProperty ;
                       rdfs:domain ucm:Statement ;
                       rdfs:range ucm:Process ;
                       rdfs:label "generated by process" .


###  https://www.w3.org/ns/ucm#hasActivityFocus
ucm:hasActivityFocus rdf:type owl:ObjectProperty ;
                     rdfs:domain ucm:Process ;
                     rdfs:range ucm:ActivityFocus ;
                     rdfs:comment "Situates a process within an activity focus." ;
                     rdfs:label "has activity focus" .


###  https://www.w3.org/ns/ucm#hasCareTrajectoryContext
ucm:hasCareTrajectoryContext rdf:type owl:ObjectProperty ;
                             rdfs:comment "Relates a UCM semantic subject to a temporal position or extent defined relative to the internal progression of a process, state trajectory, or coordinated activity rather than directly relative to an external clock or calendar." ;
                             rdfs:label "has care trajectory context" .


###  https://www.w3.org/ns/ucm#hasClient
ucm:hasClient rdf:type owl:ObjectProperty ;
              rdfs:domain ucm:SocialCareInteraction ;
              rdfs:range ucm:Person ;
              rdfs:comment "Convenience projection derived from participation semantics." ;
              rdfs:label "has client" .


###  https://www.w3.org/ns/ucm#hasClosureReason
ucm:hasClosureReason rdf:type owl:ObjectProperty ;
                     rdfs:domain ucm:CoordinationRequest ;
                     rdfs:range skos:Concept ;
                     rdfs:comment "Relates a closed care coordination request to the reason it was closed." ;
                     rdfs:label "has closure reason" .


###  https://www.w3.org/ns/ucm#hasCommitmentStatus
ucm:hasCommitmentStatus rdf:type owl:ObjectProperty ;
                        rdfs:domain ucm:CareCommitment ;
                        rdfs:range skos:Concept ;
                        rdfs:comment "Relates a care commitment to whether it is binding on its participants." ;
                        rdfs:label "has commitment status" .


###  https://www.w3.org/ns/ucm#hasHandoffStatus
ucm:hasHandoffStatus rdf:type owl:ObjectProperty ;
                     rdfs:domain ucm:Handshake ;
                     rdfs:range skos:Concept ;
                     rdfs:comment "Relates a handshake to where responsibility for its agreed services stands between the sending and receiving parties." ;
                     rdfs:label "has handoff status" .


###  https://www.w3.org/ns/ucm#hasHandshakeFulfillment
ucm:hasHandshakeFulfillment rdf:type owl:ObjectProperty ;
                            rdfs:domain ucm:Handshake ;
                            rdfs:range skos:Concept ;
                            rdfs:comment "Relates a handshake to how much of its negotiated service has been delivered." ;
                            rdfs:label "has handshake fulfillment" .


###  https://www.w3.org/ns/ucm#hasLifecycleState
ucm:hasLifecycleState rdf:type owl:ObjectProperty ;
                      rdfs:domain ucm:Process ;
                      rdfs:range skos:Concept ;
                      rdfs:comment "Relates a process to a lifecycle state." ;
                      rdfs:label "has lifecycle state" .


###  https://www.w3.org/ns/ucm#hasMember
ucm:hasMember rdf:type owl:ObjectProperty ;
              rdfs:domain ucm:SocialGroupEntity ;
              rdfs:range ucm:Entity ;
              rdfs:label "has member" .


###  https://www.w3.org/ns/ucm#hasMembership
ucm:hasMembership rdf:type owl:ObjectProperty ;
                  rdfs:domain ucm:Entity ;
                  rdfs:range ucm:Membership ;
                  rdfs:label "has membership" .


###  https://www.w3.org/ns/ucm#hasParticipant
ucm:hasParticipant rdf:type owl:ObjectProperty ;
                   rdfs:domain ucm:Process ;
                   rdfs:range ucm:Participation ;
                   rdfs:label "has participant" .


###  https://www.w3.org/ns/ucm#hasPatient
ucm:hasPatient rdf:type owl:ObjectProperty ;
               rdfs:domain ucm:ClinicalEncounter ;
               rdfs:range ucm:Person ;
               rdfs:comment "Convenience projection derived from participation semantics." ;
               rdfs:label "has patient" .


###  https://www.w3.org/ns/ucm#hasReferralDisposition
ucm:hasReferralDisposition rdf:type owl:ObjectProperty ;
                           rdfs:domain ucm:CoordinationRequest ;
                           rdfs:range skos:Concept ;
                           rdfs:comment "Relates a care coordination request to the receiving party's decision on it." ;
                           rdfs:label "has referral disposition" .


###  https://www.w3.org/ns/ucm#hasResident
ucm:hasResident rdf:type owl:ObjectProperty ;
                rdfs:domain ucm:HousingAssessment ;
                rdfs:range ucm:Person ;
                rdfs:comment "Convenience projection derived from participation semantics." ;
                rdfs:label "has resident" .


###  https://www.w3.org/ns/ucm#hasTemporalContext
ucm:hasTemporalContext rdf:type owl:ObjectProperty ;
                       rdfs:range time:TemporalEntity ;
                       rdfs:comment "Relates a UCM semantic subject to a temporal entity that qualifies when that subject occurs, obtains, applies, participates, or is otherwise temporally situated." ;
                       rdfs:label "has temporal context" .


###  https://www.w3.org/ns/ucm#locatedAt
ucm:locatedAt rdf:type owl:ObjectProperty ;
              rdfs:domain ucm:Entity ;
              rdfs:range ucm:Location ;
              rdfs:label "located at" .


###  https://www.w3.org/ns/ucm#madeWithinContext
ucm:madeWithinContext rdf:type owl:ObjectProperty ;
                      rdfs:domain ucm:Statement ;
                      rdfs:range ucm:SemanticContext ;
                      rdfs:label "made within context" .


###  https://www.w3.org/ns/ucm#memberOf
ucm:memberOf rdf:type owl:ObjectProperty ;
             rdfs:domain ucm:Entity ;
             rdfs:range ucm:SocialGroupEntity ;
             rdfs:label "member of" .


###  https://www.w3.org/ns/ucm#membershipIn
ucm:membershipIn rdf:type owl:ObjectProperty ;
                 rdfs:domain ucm:Membership ;
                 rdfs:range ucm:SocialGroupEntity ;
                 rdfs:label "membership in" .


###  https://www.w3.org/ns/ucm#negotiates
ucm:negotiates rdf:type owl:ObjectProperty ;
               rdfs:domain ucm:Handshake ;
               rdfs:range ucm:Process ;
               rdfs:comment "Relates a handshake to the care coordination process whose participation relationship it negotiates." ;
               rdfs:label "negotiates" .


###  https://www.w3.org/ns/ucm#occursDuring
ucm:occursDuring rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf ucm:hasTemporalContext ;
                 rdfs:domain ucm:Process ;
                 rdfs:range time:TemporalEntity ;
                 rdfs:comment "Relates a process to the temporal extent during which the process occurs." ;
                 rdfs:label "occurs during" .


###  https://www.w3.org/ns/ucm#occursWithin
ucm:occursWithin rdf:type owl:ObjectProperty ;
                 rdfs:domain ucm:Participation ;
                 rdfs:range ucm:Process ;
                 rdfs:label "occurs within" .


###  https://www.w3.org/ns/ucm#participatesThrough
ucm:participatesThrough rdf:type owl:ObjectProperty ;
                        rdfs:domain ucm:Entity ;
                        rdfs:range ucm:Participation ;
                        rdfs:label "participates through" .


###  https://www.w3.org/ns/ucm#participatingEntity
ucm:participatingEntity rdf:type owl:ObjectProperty ;
                        rdfs:domain ucm:Participation ;
                        rdfs:range ucm:Entity ;
                        rdfs:label "participating entity" .


###  https://www.w3.org/ns/ucm#participationContext
ucm:participationContext rdf:type owl:ObjectProperty ;
                         rdfs:domain ucm:Participation ;
                         rdfs:range ucm:SemanticContext ;
                         rdfs:label "participation context" .


###  https://www.w3.org/ns/ucm#qualifiesForMembership
ucm:qualifiesForMembership rdf:type owl:ObjectProperty ;
                           rdfs:domain ucm:Entity ;
                           rdfs:range ucm:MembershipCriteria ;
                           rdfs:label "qualifies for membership" .


###  https://www.w3.org/ns/ucm#scopedBy
ucm:scopedBy rdf:type owl:ObjectProperty ;
             rdfs:domain ucm:Participation ;
             rdfs:range ucm:SemanticContext ;
             rdfs:label "scoped by" .


###  https://www.w3.org/ns/ucm#statementSubject
ucm:statementSubject rdf:type owl:ObjectProperty ;
                     rdfs:domain ucm:Statement ;
                     rdfs:range ucm:Participation ;
                     rdfs:comment "Relates a statement to the contextual participation it is about." ;
                     rdfs:label "statement subject" .


###  https://www.w3.org/ns/ucm#validDuring
ucm:validDuring rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf ucm:hasTemporalContext ;
                rdfs:range time:TemporalEntity ;
                rdfs:comment "Relates a semantic subject or statement to the temporal extent during which its described condition, state, relationship, participation, or other semantics apply." ;
                rdfs:label "valid during" .


#################################################################
#    Data properties
#################################################################

###  https://www.w3.org/ns/ucm#statementDate
ucm:statementDate rdf:type owl:DatatypeProperty ;
                  rdfs:domain ucm:Statement ;
                  rdfs:range xsd:dateTime ;
                  rdfs:label "statement date" .


###  https://www.w3.org/ns/ucm#validFrom
ucm:validFrom rdf:type owl:DatatypeProperty ;
              rdfs:domain ucm:Participation ;
              rdfs:range xsd:dateTime ;
              rdfs:label "valid from" .


###  https://www.w3.org/ns/ucm#validTo
ucm:validTo rdf:type owl:DatatypeProperty ;
            rdfs:domain ucm:Participation ;
            rdfs:range xsd:dateTime ;
            rdfs:label "valid to" .


#################################################################
#    Classes
#################################################################

###  http://purl.bioontology.org/ontology/SNOMEDCT#337915000
<http://purl.bioontology.org/ontology/SNOMEDCT#337915000> rdf:type owl:Class ;
                                                          owl:equivalentClass ucm:Person ;
                                                          rdfs:label "Homo sapiens" .


###  http://purl.obolibrary.org/obo/NCBITaxon#9606
<http://purl.obolibrary.org/obo/NCBITaxon#9606> rdf:type owl:Class ;
                                                owl:equivalentClass ucm:Person ;
                                                rdfs:label "Homo sapiens" .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


###  http://www.w3.org/2006/time#TemporalEntity
time:TemporalEntity rdf:type owl:Class .


###  https://www.commoncoreontologies.org/AgentOntology#ont00001262
cco:ont00001262 rdf:type owl:Class ;
                owl:equivalentClass ucm:Person ;
                rdfs:label "Person" ;
                skos:altLabel "Human" .


###  https://www.w3.org/ns/ucm#ActivityFocus
ucm:ActivityFocus rdf:type owl:Class ;
                  rdfs:comment "The matter, condition, or situation toward which a coordinated activity is orchestrated and which the activity seeks to jointly maintain, update, resolve, or bring about." ;
                  rdfs:label "Activity Focus" .


###  https://www.w3.org/ns/ucm#BehavioralHealthContext
ucm:BehavioralHealthContext rdf:type owl:Class ;
                            rdfs:subClassOf ucm:SemanticContext ;
                            rdfs:label "Behavioral Health Context" .


###  https://www.w3.org/ns/ucm#BehavioralHealthDomain
ucm:BehavioralHealthDomain rdf:type owl:Class ;
                           rdfs:label "Behavioral Health Domain" .


###  https://www.w3.org/ns/ucm#BeneficiaryRole
ucm:BeneficiaryRole rdf:type owl:Class ;
                    rdfs:subClassOf ucm:SubjectRole ;
                    rdfs:label "Beneficiary Role" .


###  https://www.w3.org/ns/ucm#CareCommitment
ucm:CareCommitment rdf:type owl:Class ;
                   rdfs:comment "A continuing agreement among participants to coordinate care toward a joint purpose, according to terms or conditions that may evolve." ;
                   rdfs:label "Care Commitment" .


###  https://www.w3.org/ns/ucm#CareCoordinationInteraction
ucm:CareCoordinationInteraction rdf:type owl:Class ;
                                rdfs:subClassOf ucm:Process ;
                                rdfs:label "Care Coordination Interaction" .


###  https://www.w3.org/ns/ucm#CareCoordinationStatement
ucm:CareCoordinationStatement rdf:type owl:Class ;
                              rdfs:subClassOf ucm:Statement ;
                              rdfs:label "Care Coordination Statement" .


###  https://www.w3.org/ns/ucm#CareCoverageGap
ucm:CareCoverageGap rdf:type owl:Class ;
                    rdfs:comment "A condition in which a care coverage requirement is in force but is not satisfied by any applicable in-force care commitment during a specified interval." ;
                    rdfs:label "Care Coverage Gap" .


###  https://www.w3.org/ns/ucm#CareCoverageRequirement
ucm:CareCoverageRequirement rdf:type owl:Class ;
                            rdfs:comment "A requirement that some participation in care coordination concerns an activity focus, in a given role, over a defined context or interval." ;
                            rdfs:label "Care Coverage Requirement" .


###  https://www.w3.org/ns/ucm#CareTeam
ucm:CareTeam rdf:type owl:Class ;
             rdfs:subClassOf ucm:SocialGroupEntity ;
             rdfs:label "Care Team" .


###  https://www.w3.org/ns/ucm#CareTrajectoryContext
ucm:CareTrajectoryContext rdf:type owl:Class ;
                          rdfs:comment "A position or extent defined relative to the progression of a care process, state trajectory, or coordinated activity, which does not require anchoring to clock or calendar time." ;
                          rdfs:label "Care Trajectory Context" .


###  https://www.w3.org/ns/ucm#CaregiverRole
ucm:CaregiverRole rdf:type owl:Class ;
                  rdfs:subClassOf ucm:Role ;
                  rdfs:label "Caregiver Role" .


###  https://www.w3.org/ns/ucm#ClientRole
ucm:ClientRole rdf:type owl:Class ;
               rdfs:subClassOf ucm:SubjectRole ;
               rdfs:label "Client Role" .


###  https://www.w3.org/ns/ucm#ClinicalCareContext
ucm:ClinicalCareContext rdf:type owl:Class ;
                        rdfs:subClassOf ucm:SemanticContext ;
                        rdfs:label "Clinical Care Context" .


###  https://www.w3.org/ns/ucm#ClinicalDomain
ucm:ClinicalDomain rdf:type owl:Class ;
                   rdfs:label "Clinical Domain" .


###  https://www.w3.org/ns/ucm#ClinicalEncounter
ucm:ClinicalEncounter rdf:type owl:Class ;
                      rdfs:subClassOf ucm:Encounter ;
                      rdfs:label "Clinical Encounter" .


###  https://www.w3.org/ns/ucm#ClinicalStatement
ucm:ClinicalStatement rdf:type owl:Class ;
                      rdfs:subClassOf ucm:Statement ;
                      rdfs:label "Clinical Statement" .


###  https://www.w3.org/ns/ucm#CommunityGroup
ucm:CommunityGroup rdf:type owl:Class ;
                   rdfs:subClassOf ucm:SocialGroupEntity ;
                   rdfs:label "Community Group" .


###  https://www.w3.org/ns/ucm#CoordinationRequest
ucm:CoordinationRequest rdf:type owl:Class ;
                        rdfs:subClassOf ucm:Process ;
                        rdfs:comment "A process in which coordination is requested between participating entities." ;
                        rdfs:label "Care Coordination Request" .


###  https://www.w3.org/ns/ucm#CoordinativeActivity
ucm:CoordinativeActivity rdf:type owl:Class ;
                         rdfs:subClassOf ucm:Process ;
                         rdfs:comment "A situated activity whose process is shared by participating entities in its care coordination lifecycle." ;
                         rdfs:label "Coordinative Care Activity" .


###  https://www.w3.org/ns/ucm#CoordinatorRole
ucm:CoordinatorRole rdf:type owl:Class ;
                    rdfs:subClassOf ucm:Role ;
                    rdfs:label "Coordinator Role" .


###  https://www.w3.org/ns/ucm#DefinitionArtifact
ucm:DefinitionArtifact rdf:type owl:Class ;
                       rdfs:comment "A ruleset, policy definition, constraint, or governance artifact." ;
                       rdfs:label "Definition Artifact" .


###  https://www.w3.org/ns/ucm#Device
ucm:Device rdf:type owl:Class ;
           rdfs:subClassOf ucm:Entity ;
           rdfs:label "Device" .


###  https://www.w3.org/ns/ucm#DiagnosisStatement
ucm:DiagnosisStatement rdf:type owl:Class ;
                       rdfs:subClassOf ucm:ClinicalStatement ;
                       rdfs:label "Diagnosis Statement" .


###  https://www.w3.org/ns/ucm#EligibilityDetermination
ucm:EligibilityDetermination rdf:type owl:Class ;
                             rdfs:subClassOf ucm:Process ;
                             rdfs:label "Eligibility Determination" .


###  https://www.w3.org/ns/ucm#EligibilityRuleset
ucm:EligibilityRuleset rdf:type owl:Class ;
                       rdfs:subClassOf ucm:DefinitionArtifact ;
                       rdfs:label "Eligibility Ruleset" .


###  https://www.w3.org/ns/ucm#Encounter
ucm:Encounter rdf:type owl:Class ;
              rdfs:subClassOf ucm:Process ;
              rdfs:comment "A bounded contextual interaction process." ;
              rdfs:label "Encounter" .


###  https://www.w3.org/ns/ucm#Entity
ucm:Entity rdf:type owl:Class ;
           rdfs:comment "A stable independently identifiable semantic thing." ;
           rdfs:label "Entity" .


###  https://www.w3.org/ns/ucm#Handshake
ucm:Handshake rdf:type owl:Class ;
              rdfs:subClassOf ucm:CoordinativeActivity ;
              rdfs:comment "A coordinative process through which participating entities negotiate mutual participation in a shared activity." ;
              rdfs:label "Handshake" .


###  https://www.w3.org/ns/ucm#Household
ucm:Household rdf:type owl:Class ;
              rdfs:subClassOf ucm:SocialGroupEntity ;
              rdfs:label "Household" .


###  https://www.w3.org/ns/ucm#HousingAssessment
ucm:HousingAssessment rdf:type owl:Class ;
                      rdfs:subClassOf ucm:Process ;
                      rdfs:label "Housing Assessment" .


###  https://www.w3.org/ns/ucm#HousingContext
ucm:HousingContext rdf:type owl:Class ;
                   rdfs:subClassOf ucm:SemanticContext ;
                   rdfs:label "Housing Context" .


###  https://www.w3.org/ns/ucm#HousingDomain
ucm:HousingDomain rdf:type owl:Class ;
                  rdfs:label "Housing Domain" .


###  https://www.w3.org/ns/ucm#HousingEligibilityContext
ucm:HousingEligibilityContext rdf:type owl:Class ;
                              rdfs:subClassOf ucm:HousingContext ;
                              rdfs:label "Housing Eligibility Context" .


###  https://www.w3.org/ns/ucm#HousingEligibilityStatement
ucm:HousingEligibilityStatement rdf:type owl:Class ;
                                rdfs:subClassOf ucm:HousingStatement ;
                                rdfs:label "Housing Eligibility Statement" .


###  https://www.w3.org/ns/ucm#HousingStatement
ucm:HousingStatement rdf:type owl:Class ;
                     rdfs:subClassOf ucm:Statement ;
                     rdfs:label "Housing Statement" .


###  https://www.w3.org/ns/ucm#InformationArtifact
ucm:InformationArtifact rdf:type owl:Class ;
                        rdfs:subClassOf ucm:Entity ;
                        rdfs:comment "A logical information abstraction or computable information object." ;
                        rdfs:label "Information Artifact" .


###  https://www.w3.org/ns/ucm#Location
ucm:Location rdf:type owl:Class ;
             rdfs:subClassOf ucm:Entity ;
             rdfs:label "Location" .


###  https://www.w3.org/ns/ucm#MatchClaim
ucm:MatchClaim rdf:type owl:Class ;
               rdfs:subClassOf ucm:Statement ;
               rdfs:comment "An assertion that two or more entity references co-refer to the same identifiable entity." ;
               rdfs:label "Match Claim" .


###  https://www.w3.org/ns/ucm#Membership
ucm:Membership rdf:type owl:Class ;
               rdfs:comment "Contextual membership relationship between an Entity and a SocialGroupEntity." ;
               rdfs:label "Membership" .


###  https://www.w3.org/ns/ucm#MembershipCriteria
ucm:MembershipCriteria rdf:type owl:Class ;
                       rdfs:comment "Rules or conditions defining membership within a SocialGroupEntity." ;
                       rdfs:label "Membership Criteria" .


###  https://www.w3.org/ns/ucm#ObservationStatement
ucm:ObservationStatement rdf:type owl:Class ;
                         rdfs:subClassOf ucm:ClinicalStatement ;
                         rdfs:label "Observation Statement" .


###  https://www.w3.org/ns/ucm#Organization
ucm:Organization rdf:type owl:Class ;
                 rdfs:subClassOf ucm:Entity ;
                 rdfs:comment "Operational or governance-oriented social entity maintaining continuity independent of membership changes." ;
                 rdfs:label "Organization" .


###  https://www.w3.org/ns/ucm#Participation
ucm:Participation rdf:type owl:Class ;
                  rdfs:comment "Contextual involvement of an Entity within a Process and Semantic Context." ;
                  rdfs:label "Participation" .


###  https://www.w3.org/ns/ucm#PatientRole
ucm:PatientRole rdf:type owl:Class ;
                rdfs:subClassOf ucm:SubjectRole ;
                rdfs:label "Patient Role" .


###  https://www.w3.org/ns/ucm#Person
ucm:Person rdf:type owl:Class ;
           rdfs:subClassOf ucm:Entity ;
           rdfs:comment "A homo sapiens (NCBI) with the social context of a Person.  Looking for an object property of cco:PersonRole to have a \"similar to\" skos: relationship." ;
           rdfs:label "Person" .


###  https://www.w3.org/ns/ucm#PolicyDefinition
ucm:PolicyDefinition rdf:type owl:Class ;
                     rdfs:subClassOf ucm:DefinitionArtifact ;
                     rdfs:label "Policy Definition" .


###  https://www.w3.org/ns/ucm#Process
ucm:Process rdf:type owl:Class ;
            rdfs:comment "A bounded interaction or activity occurring over time." ;
            rdfs:label "Process" .


###  https://www.w3.org/ns/ucm#ProgramDefinition
ucm:ProgramDefinition rdf:type owl:Class ;
                      rdfs:subClassOf ucm:DefinitionArtifact ;
                      rdfs:label "Program Definition" .


###  https://www.w3.org/ns/ucm#ProviderRole
ucm:ProviderRole rdf:type owl:Class ;
                 rdfs:subClassOf ucm:Role ;
                 rdfs:label "Provider Role" .


###  https://www.w3.org/ns/ucm#PublicHealthContext
ucm:PublicHealthContext rdf:type owl:Class ;
                        rdfs:subClassOf ucm:SemanticContext ;
                        rdfs:label "Public Health Context" .


###  https://www.w3.org/ns/ucm#PublicHealthDomain
ucm:PublicHealthDomain rdf:type owl:Class ;
                       rdfs:label "Public Health Domain" .


###  https://www.w3.org/ns/ucm#ResidentRole
ucm:ResidentRole rdf:type owl:Class ;
                 rdfs:subClassOf ucm:SubjectRole ;
                 rdfs:label "Resident Role" .


###  https://www.w3.org/ns/ucm#Role
ucm:Role rdf:type owl:Class ;
         rdfs:comment "A contextual, anti-rigid classification assumed through participation." ;
         rdfs:label "Role" .


###  https://www.w3.org/ns/ucm#SemanticConstraint
ucm:SemanticConstraint rdf:type owl:Class ;
                       rdfs:subClassOf ucm:DefinitionArtifact ;
                       rdfs:label "Semantic Constraint" .


###  https://www.w3.org/ns/ucm#SemanticContext
ucm:SemanticContext rdf:type owl:Class ;
                    rdfs:comment "An interpretive environment, governance scope, or applicability boundary." ;
                    rdfs:label "Semantic Context" .


###  https://www.w3.org/ns/ucm#SocialCareContext
ucm:SocialCareContext rdf:type owl:Class ;
                      rdfs:subClassOf ucm:SemanticContext ;
                      rdfs:label "Social Care Context" .


###  https://www.w3.org/ns/ucm#SocialCareDomain
ucm:SocialCareDomain rdf:type owl:Class ;
                     rdfs:label "Social Care Domain" .


###  https://www.w3.org/ns/ucm#SocialCareInteraction
ucm:SocialCareInteraction rdf:type owl:Class ;
                          rdfs:subClassOf ucm:Process ;
                          rdfs:label "Social Care Interaction" .


###  https://www.w3.org/ns/ucm#SocialCareStatement
ucm:SocialCareStatement rdf:type owl:Class ;
                        rdfs:subClassOf ucm:Statement ;
                        rdfs:label "Social Care Statement" .


###  https://www.w3.org/ns/ucm#SocialGroupEntity
ucm:SocialGroupEntity rdf:type owl:Class ;
                      rdfs:subClassOf ucm:Entity ;
                      rdfs:comment "A collective grouping of participating entities." ;
                      rdfs:label "Social Group Entity" .


###  https://www.w3.org/ns/ucm#Statement
ucm:Statement rdf:type owl:Class ;
              rdfs:comment "An informational assertion, finding, determination, or conclusion." ;
              rdfs:label "Statement" .


###  https://www.w3.org/ns/ucm#SubjectRole
ucm:SubjectRole rdf:type owl:Class ;
                rdfs:subClassOf ucm:Role ;
                rdfs:label "Subject Role" .


#################################################################
#    Consent and identity (consent-concepts-plan, 2026-11-27)
#################################################################

#    Object properties

###  https://www.w3.org/ns/ucm#recordsConsentFrom
ucm:recordsConsentFrom rdf:type owl:ObjectProperty ;
                       rdfs:domain ucm:ConsentDirective ;
                       rdfs:range ucm:ConsentInteraction ;
                       rdfs:comment "Relates a consent directive to the consent interaction that produced, amended or revoked it." ;
                       rdfs:label "records consent from" .


###  https://www.w3.org/ns/ucm#consentSubject
ucm:consentSubject rdf:type owl:ObjectProperty ;
                   rdfs:domain ucm:ConsentDirective ;
                   rdfs:range ucm:Participation ;
                   rdfs:comment "Relates a consent directive to the participation of the person or group the consent concerns (FHIR Consent.subject)." ;
                   rdfs:label "consent subject" .


###  https://www.w3.org/ns/ucm#hasConsentDecision
ucm:hasConsentDecision rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentDirective ucm:ConsentProvision ) ] ;
                       rdfs:range skos:Concept ;
                       rdfs:comment "Relates a consent directive or provision to its permit or deny decision. Every provision states its own decision, the opposite of its parent's." ;
                       rdfs:label "has consent decision" .


###  https://www.w3.org/ns/ucm#hasConsentStatus
ucm:hasConsentStatus rdf:type owl:ObjectProperty ;
                     rdfs:domain ucm:ConsentDirective ;
                     rdfs:range skos:Concept ;
                     rdfs:comment "Relates a consent directive to whether it applies now (FHIR Consent.status)." ;
                     rdfs:label "has consent status" .


###  https://www.w3.org/ns/ucm#hasConsentCategory
ucm:hasConsentCategory rdf:type owl:ObjectProperty ;
                       rdfs:domain ucm:ConsentDirective ;
                       rdfs:range skos:Concept ;
                       rdfs:comment "Relates a consent directive to its kind, such as a privacy consent or release of information, a treatment consent or a research consent." ;
                       rdfs:label "has consent category" .


###  https://www.w3.org/ns/ucm#hasConsentModality
ucm:hasConsentModality rdf:type owl:ObjectProperty ;
                       rdfs:domain ucm:ConsentInteraction ;
                       rdfs:range skos:Concept ;
                       rdfs:comment "Relates a consent interaction to how consent was expressed: written, electronic, verbal or inferred." ;
                       rdfs:label "has consent modality" .


###  https://www.w3.org/ns/ucm#hasConsentInteractionType
ucm:hasConsentInteractionType rdf:type owl:ObjectProperty ;
                              rdfs:domain ucm:ConsentInteraction ;
                              rdfs:range skos:Concept ;
                              rdfs:comment "Relates a consent interaction to what it did: grant, refuse, amend, renew, revoke or verify." ;
                              rdfs:label "has consent interaction type" .


###  https://www.w3.org/ns/ucm#hasProvision
ucm:hasProvision rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentDirective ucm:ConsentProvision ) ] ;
                 rdfs:range ucm:ConsentProvision ;
                 rdfs:comment "Relates a consent directive, or an enclosing provision, to a provision within it (FHIR Consent.provision)." ;
                 rdfs:label "has provision" .


###  https://www.w3.org/ns/ucm#provisionActor
ucm:provisionActor rdf:type owl:ObjectProperty ;
                   rdfs:domain ucm:ConsentProvision ;
                   rdfs:range ucm:Participation ;
                   rdfs:comment "Relates a provision to the participation of a party it permits or denies (FHIR Consent.provision.actor)." ;
                   rdfs:label "provision actor" .


###  https://www.w3.org/ns/ucm#governsAction
ucm:governsAction rdf:type owl:ObjectProperty ;
                  rdfs:domain ucm:ConsentProvision ;
                  rdfs:range skos:Concept ;
                  rdfs:comment "Relates a provision to an action it permits or denies, such as collect, access, use or disclose." ;
                  rdfs:label "governs action" .


###  https://www.w3.org/ns/ucm#forPurpose
ucm:forPurpose rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentProvision ucm:PrivacyNotice ) ] ;
               rdfs:range skos:Concept ;
               rdfs:comment "Relates a provision or privacy notice to a purpose of use it covers." ;
               rdfs:label "for purpose" .


###  https://www.w3.org/ns/ucm#coversDataCategory
ucm:coversDataCategory rdf:type owl:ObjectProperty ;
                       rdfs:domain ucm:ConsentProvision ;
                       rdfs:range skos:Concept ;
                       rdfs:comment "Relates a provision to a category of information it covers." ;
                       rdfs:label "covers data category" .


###  https://www.w3.org/ns/ucm#coversSensitivity
ucm:coversSensitivity rdf:type owl:ObjectProperty ;
                      rdfs:domain ucm:ConsentProvision ;
                      rdfs:range skos:Concept ;
                      rdfs:comment "Relates a provision to a sensitivity category of the information it covers (FHIR Consent.provision.securityLabel)." ;
                      rdfs:label "covers sensitivity" .


###  https://www.w3.org/ns/ucm#coversInformation
ucm:coversInformation rdf:type owl:ObjectProperty ;
                      rdfs:domain ucm:ConsentProvision ;
                      rdfs:comment "Relates a provision to specific information it covers, an information artifact or a statement (FHIR Consent.provision.data)." ;
                      rdfs:label "covers information" .


###  https://www.w3.org/ns/ucm#coversInstance
ucm:coversInstance rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf ucm:coversInformation ;
                   rdfs:domain ucm:ConsentProvision ;
                   rdfs:comment "The provision covers exactly the referenced information (FHIR data.meaning instance)." ;
                   rdfs:label "covers instance" .


###  https://www.w3.org/ns/ucm#coversRelated
ucm:coversRelated rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf ucm:coversInformation ;
                  rdfs:domain ucm:ConsentProvision ;
                  rdfs:comment "The provision covers the referenced information and information directly related to it (FHIR data.meaning related)." ;
                  rdfs:label "covers related" .


###  https://www.w3.org/ns/ucm#coversDependents
ucm:coversDependents rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ucm:coversInformation ;
                     rdfs:domain ucm:ConsentProvision ;
                     rdfs:comment "The provision covers the referenced information and information that depends on it (FHIR data.meaning dependents)." ;
                     rdfs:label "covers dependents" .


###  https://www.w3.org/ns/ucm#coversAuthoredBy
ucm:coversAuthoredBy rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ucm:coversInformation ;
                     rdfs:domain ucm:ConsentProvision ;
                     rdfs:comment "The provision covers information authored by the referenced party (FHIR data.meaning authoredby)." ;
                     rdfs:label "covers authored by" .


###  https://www.w3.org/ns/ucm#dataPeriod
ucm:dataPeriod rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf ucm:hasTemporalContext ;
               rdfs:domain ucm:ConsentProvision ;
               rdfs:range time:TemporalEntity ;
               rdfs:comment "Relates a provision to the time span of the data it covers, as distinct from the period the consent applies (FHIR Consent.provision.dataPeriod)." ;
               rdfs:label "data period" .


###  https://www.w3.org/ns/ucm#hasSensitivityLabel
ucm:hasSensitivityLabel rdf:type owl:ObjectProperty ;
                        rdfs:range skos:Concept ;
                        rdfs:comment "Relates an information artifact or statement to a sensitivity category, so provisions can match data without listing records (FHIR meta.security)." ;
                        rdfs:label "has sensitivity label" .


###  https://www.w3.org/ns/ucm#hasConfidentialityLevel
ucm:hasConfidentialityLevel rdf:type owl:ObjectProperty ;
                            rdfs:range skos:Concept ;
                            rdfs:comment "Relates an information artifact or statement to its confidentiality level (HL7 v3 Confidentiality)." ;
                            rdfs:label "has confidentiality level" .


###  https://www.w3.org/ns/ucm#coversConfidentiality
ucm:coversConfidentiality rdf:type owl:ObjectProperty ;
                          rdfs:domain ucm:ConsentProvision ;
                          rdfs:range skos:Concept ;
                          rdfs:comment "Relates a provision to a confidentiality level of the information it covers (FHIR Consent.provision.securityLabel with a confidentiality code)." ;
                          rdfs:label "covers confidentiality" .


###  https://www.w3.org/ns/ucm#governedByPolicy
ucm:governedByPolicy rdf:type owl:ObjectProperty ;
                     rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentDirective ucm:ConsentProvision ucm:ProgramDefinition ) ] ;
                     rdfs:range ucm:ConsentPolicy ;
                     rdfs:comment "Relates a consent directive, provision or program to the consent policy it relies on (FHIR Consent.policyBasis)." ;
                     rdfs:label "governed by policy" .


###  https://www.w3.org/ns/ucm#hasRegulatoryBasis
ucm:hasRegulatoryBasis rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentDirective ucm:ConsentPolicy ) ] ;
                       rdfs:range skos:Concept ;
                       rdfs:comment "Relates a consent directive or policy to the law or regulation it rests on (FHIR Consent.regulatoryBasis)." ;
                       rdfs:label "has regulatory basis" .


###  https://www.w3.org/ns/ucm#inJurisdiction
ucm:inJurisdiction rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentDirective ucm:ConsentInteraction ucm:ConsentPolicy ucm:Identifier ) ] ;
                   rdfs:range ucm:JurisdictionContext ;
                   rdfs:comment "Relates a consent, consent interaction, policy or identifier to the jurisdiction where it was given, is in force or was issued." ;
                   rdfs:label "in jurisdiction" .


###  https://www.w3.org/ns/ucm#withinJurisdiction
ucm:withinJurisdiction rdf:type owl:ObjectProperty ,
                                owl:TransitiveProperty ;
                       rdfs:domain ucm:JurisdictionContext ;
                       rdfs:range ucm:JurisdictionContext ;
                       rdfs:comment "Relates a jurisdiction to a larger jurisdiction that contains it, such as a county within a state or a Continuum of Care within a state." ;
                       rdfs:label "within jurisdiction" .


###  https://www.w3.org/ns/ucm#selfConsentScope
ucm:selfConsentScope rdf:type owl:ObjectProperty ;
                     rdfs:domain ucm:SelfConsentRule ;
                     rdfs:range skos:Concept ;
                     rdfs:comment "Relates a self-consent rule to a purpose, consent category, information category or sensitivity it covers. No value means all consents." ;
                     rdfs:label "self-consent scope" .


###  https://www.w3.org/ns/ucm#selfConsentCondition
ucm:selfConsentCondition rdf:type owl:ObjectProperty ;
                         rdfs:domain ucm:SelfConsentRule ;
                         rdfs:range skos:Concept ;
                         rdfs:comment "Relates a self-consent rule to a condition that unlocks self-consent. Several values mean any one suffices." ;
                         rdfs:label "self-consent condition" .


###  https://www.w3.org/ns/ucm#hasConsentModel
ucm:hasConsentModel rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentPolicy ucm:ProgramDefinition ucm:PrivacyNotice ) ] ;
                    rdfs:range skos:Concept ;
                    rdfs:comment "Relates a policy, program or notice to its consent model, such as opt-in or opt-out." ;
                    rdfs:label "has consent model" .


###  https://www.w3.org/ns/ucm#acknowledgesNotice
ucm:acknowledgesNotice rdf:type owl:ObjectProperty ;
                       rdfs:domain ucm:ConsentInteraction ;
                       rdfs:range ucm:PrivacyNotice ;
                       rdfs:comment "Relates a consent interaction to a privacy notice the subject or grantor was given or shown." ;
                       rdfs:label "acknowledges notice" .


###  https://www.w3.org/ns/ucm#postedAt
ucm:postedAt rdf:type owl:ObjectProperty ;
             rdfs:domain ucm:PrivacyNotice ;
             rdfs:range ucm:Location ;
             rdfs:comment "Relates a privacy notice to a location where it is posted, such as an intake desk." ;
             rdfs:label "posted at" .


###  https://www.w3.org/ns/ucm#supersedes
ucm:supersedes rdf:type owl:ObjectProperty ;
               rdfs:domain ucm:ConsentDirective ;
               rdfs:range ucm:ConsentDirective ;
               rdfs:comment "Relates a consent directive to an earlier directive it amends or renews." ;
               rdfs:label "supersedes" .


###  https://www.w3.org/ns/ucm#revokedBy
ucm:revokedBy rdf:type owl:ObjectProperty ;
              rdfs:domain ucm:ConsentDirective ;
              rdfs:range ucm:ConsentInteraction ;
              rdfs:comment "Relates a consent directive to the consent interaction that revoked it." ;
              rdfs:label "revoked by" .


###  https://www.w3.org/ns/ucm#sourceDocument
ucm:sourceDocument rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentDirective ucm:PrivacyNotice ) ] ;
                   rdfs:range ucm:InformationArtifact ;
                   rdfs:comment "Relates a consent directive or privacy notice to its source, such as a scanned signed form or the policy text." ;
                   rdfs:label "source document" .


###  https://www.w3.org/ns/ucm#authorizedByConsent
ucm:authorizedByConsent rdf:type owl:ObjectProperty ;
                        rdfs:domain ucm:Process ;
                        rdfs:range ucm:ConsentDirective ;
                        rdfs:comment "Relates a process, such as a coordination request, handshake or disclosure, to the consent directive that permits it." ;
                        rdfs:label "authorized by consent" .


###  https://www.w3.org/ns/ucm#birthDateQuality
ucm:birthDateQuality rdf:type owl:ObjectProperty ;
                     rdfs:domain ucm:Person ;
                     rdfs:range skos:Concept ;
                     rdfs:comment "Relates a person to how reliable their recorded birth date is." ;
                     rdfs:label "birth date quality" .


###  https://www.w3.org/ns/ucm#hasRetentionDisposition
ucm:hasRetentionDisposition rdf:type owl:ObjectProperty ;
                            rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentDirective ucm:ConsentProvision ) ] ;
                            rdfs:range skos:Concept ;
                            rdfs:comment "Relates a consent directive or provision to what happens to the data when its retention period ends." ;
                            rdfs:label "has retention disposition" .


###  https://www.w3.org/ns/ucm#processingLocation
ucm:processingLocation rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentDirective ucm:ConsentProvision ) ] ;
                       rdfs:range ucm:JurisdictionContext ;
                       rdfs:comment "Relates a consent directive or provision to a jurisdiction where the data may be stored or processed. Several values mean any of them is allowed (ISO/IEC TS 27560 storage and processing locations)." ;
                       rdfs:label "processing location" .


###  https://www.w3.org/ns/ucm#hasIdentity
ucm:hasIdentity rdf:type owl:ObjectProperty ;
                rdfs:domain ucm:Entity ;
                rdfs:range ucm:Identity ;
                rdfs:comment "Relates any entity to an identity by which it is recognized. An entity can have many identities." ;
                rdfs:label "has identity" .


###  https://www.w3.org/ns/ucm#identityOf
ucm:identityOf rdf:type owl:ObjectProperty ;
               owl:inverseOf ucm:hasIdentity ;
               rdfs:domain ucm:Identity ;
               rdfs:range ucm:Entity ;
               rdfs:comment "Relates an identity to the entity it identifies." ;
               rdfs:label "identity of" .


###  https://www.w3.org/ns/ucm#hasIdentifier
ucm:hasIdentifier rdf:type owl:ObjectProperty ;
                  rdfs:domain ucm:Identity ;
                  rdfs:range ucm:Identifier ;
                  rdfs:comment "Relates an identity to an identifier that designates it." ;
                  rdfs:label "has identifier" .


###  https://www.w3.org/ns/ucm#hasIdentifierType
ucm:hasIdentifierType rdf:type owl:ObjectProperty ;
                      rdfs:domain ucm:Identifier ;
                      rdfs:range skos:Concept ;
                      rdfs:comment "Relates an identifier to its kind, such as a medical record number or HMIS Personal ID." ;
                      rdfs:label "has identifier type" .


###  https://www.w3.org/ns/ucm#issuedBy
ucm:issuedBy rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:Identifier ucm:Credential ucm:AssuranceCertification ) ] ;
             rdfs:range ucm:Entity ;
             rdfs:comment "Relates an identifier, credential or certification to the entity that issued it." ;
             rdfs:label "issued by" .


###  https://www.w3.org/ns/ucm#identifiedAs
ucm:identifiedAs rdf:type owl:ObjectProperty ;
                 rdfs:domain ucm:Participation ;
                 rdfs:range ucm:Identity ;
                 rdfs:comment "Relates a participation to the identity under which the participant acted. This ties a consent's grantor and subject to identities." ;
                 rdfs:label "identified as" .


###  https://www.w3.org/ns/ucm#establishesIdentity
ucm:establishesIdentity rdf:type owl:ObjectProperty ;
                        rdfs:domain ucm:IdentityProofing ;
                        rdfs:range ucm:Identity ;
                        rdfs:comment "Relates an identity proofing process to the identity it establishes." ;
                        rdfs:label "establishes identity" .


###  https://www.w3.org/ns/ucm#usedEvidence
ucm:usedEvidence rdf:type owl:ObjectProperty ;
                 rdfs:domain ucm:IdentityProofing ;
                 rdfs:range ucm:IdentityEvidence ;
                 rdfs:comment "Relates an identity proofing process to evidence it used." ;
                 rdfs:label "used evidence" .


###  https://www.w3.org/ns/ucm#hasEvidenceType
ucm:hasEvidenceType rdf:type owl:ObjectProperty ;
                    rdfs:domain ucm:IdentityEvidence ;
                    rdfs:range skos:Concept ;
                    rdfs:comment "Relates identity evidence to its kind: document, electronic record, vouch or electronic signature." ;
                    rdfs:label "has evidence type" .


###  https://www.w3.org/ns/ucm#hasEvidenceStrength
ucm:hasEvidenceStrength rdf:type owl:ObjectProperty ;
                        rdfs:domain ucm:IdentityEvidence ;
                        rdfs:range skos:Concept ;
                        rdfs:comment "Relates identity evidence to its NIST strength: fair, strong or superior." ;
                        rdfs:label "has evidence strength" .


###  https://www.w3.org/ns/ucm#hasProofingType
ucm:hasProofingType rdf:type owl:ObjectProperty ;
                    rdfs:domain ucm:IdentityProofing ;
                    rdfs:range skos:Concept ;
                    rdfs:comment "Relates an identity proofing process to how it was conducted: remote or on-site, attended or unattended." ;
                    rdfs:label "has proofing type" .


###  https://www.w3.org/ns/ucm#achievedIAL
ucm:achievedIAL rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:IdentityProofing ucm:Identity ) ] ;
                rdfs:range skos:Concept ;
                rdfs:comment "Relates an identity proofing process or identity to the identity assurance level it reached." ;
                rdfs:label "achieved IAL" .


###  https://www.w3.org/ns/ucm#achievedAAL
ucm:achievedAAL rdf:type owl:ObjectProperty ;
                rdfs:domain ucm:Authentication ;
                rdfs:range skos:Concept ;
                rdfs:comment "Relates an authentication to the authenticator assurance level it reached." ;
                rdfs:label "achieved AAL" .


###  https://www.w3.org/ns/ucm#achievedFAL
ucm:achievedFAL rdf:type owl:ObjectProperty ;
                rdfs:domain ucm:IdentityAssertion ;
                rdfs:range skos:Concept ;
                rdfs:comment "Relates an identity assertion to the federation assurance level it reached." ;
                rdfs:label "achieved FAL" .


###  https://www.w3.org/ns/ucm#assertsIdentity
ucm:assertsIdentity rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:IdentityAssertion ucm:Credential ) ] ;
                    rdfs:range ucm:Identity ;
                    rdfs:comment "Relates an identity assertion or credential to the identity it makes claims about." ;
                    rdfs:label "asserts identity" .


###  https://www.w3.org/ns/ucm#authenticatedBy
ucm:authenticatedBy rdf:type owl:ObjectProperty ;
                    rdfs:domain ucm:ConsentInteraction ;
                    rdfs:range ucm:Authentication ;
                    rdfs:comment "Relates a consent interaction to the authentication of the grantor, when consent is given electronically." ;
                    rdfs:label "authenticated by" .


###  https://www.w3.org/ns/ucm#underTrustFramework
ucm:underTrustFramework rdf:type owl:ObjectProperty ;
                        rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:IdentityProofing ucm:IdentityAssertion ucm:Credential ucm:AssuranceCertification ) ] ;
                        rdfs:range ucm:TrustFramework ;
                        rdfs:comment "Relates an identity proofing, assertion, credential or certification to the trust framework whose rules it follows." ;
                        rdfs:label "under trust framework" .


###  https://www.w3.org/ns/ucm#certifies
ucm:certifies rdf:type owl:ObjectProperty ;
              rdfs:domain ucm:AssuranceCertification ;
              rdfs:range ucm:Organization ;
              rdfs:comment "Relates an assurance certification to the provider it certifies." ;
              rdfs:label "certifies" .


###  https://www.w3.org/ns/ucm#requiresIAL
ucm:requiresIAL rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentPolicy ucm:TrustFramework ) ] ;
                rdfs:range skos:Concept ;
                rdfs:comment "Relates a consent policy or trust framework to the minimum identity assurance level it requires." ;
                rdfs:label "requires IAL" .


###  https://www.w3.org/ns/ucm#requiresAAL
ucm:requiresAAL rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentPolicy ucm:TrustFramework ) ] ;
                rdfs:range skos:Concept ;
                rdfs:comment "Relates a consent policy or trust framework to the minimum authenticator assurance level it requires." ;
                rdfs:label "requires AAL" .


###  https://www.w3.org/ns/ucm#credentialTermsOfUse
ucm:credentialTermsOfUse rdf:type owl:ObjectProperty ;
                         rdfs:domain ucm:Credential ;
                         rdfs:range ucm:PolicyDefinition ;
                         rdfs:comment "Relates a credential to a policy that governs its use (W3C VC termsOfUse)." ;
                         rdfs:label "credential terms of use" .


###  https://www.w3.org/ns/ucm#matchesIdentity
ucm:matchesIdentity rdf:type owl:ObjectProperty ;
                    rdfs:domain ucm:MatchClaim ;
                    rdfs:range ucm:Identity ;
                    rdfs:comment "Relates a match claim to an identity it says co-refers with the others it names." ;
                    rdfs:label "matches identity" .


#    Data properties

###  https://www.w3.org/ns/ucm#assuranceRank
ucm:assuranceRank rdf:type owl:DatatypeProperty ;
                  rdfs:domain skos:Concept ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "An integer rank on an assurance or strength level, so levels in one scheme can be compared with >=." ;
                  rdfs:label "assurance rank" .


###  https://www.w3.org/ns/ucm#amendmentAppliesRetroactively
ucm:amendmentAppliesRetroactively rdf:type owl:DatatypeProperty ;
                                  rdfs:domain ucm:PrivacyNotice ;
                                  rdfs:range xsd:boolean ;
                                  rdfs:comment "Whether an amendment to the privacy notice applies to information collected before the amendment." ;
                                  rdfs:label "amendment applies retroactively" .


###  https://www.w3.org/ns/ucm#minimumSelfConsentAge
ucm:minimumSelfConsentAge rdf:type owl:DatatypeProperty ;
                          rdfs:domain ucm:SelfConsentRule ;
                          rdfs:range xsd:nonNegativeInteger ;
                          rdfs:comment "The age in years from which a self-consent rule allows self-consent. Omitted when only a condition applies." ;
                          rdfs:label "minimum self-consent age" .


###  https://www.w3.org/ns/ucm#birthDate
ucm:birthDate rdf:type owl:DatatypeProperty ;
              rdfs:domain ucm:Person ;
              rdfs:range [ rdf:type rdfs:Datatype ; owl:unionOf ( xsd:date xsd:gYearMonth xsd:gYear ) ] ;
              rdfs:comment "A person's date of birth, full (xsd:date) or partial (xsd:gYearMonth or xsd:gYear). Age is computed as of a given date and never stored." ;
              rdfs:label "birth date" .


###  https://www.w3.org/ns/ucm#recordLocked
ucm:recordLocked rdf:type owl:DatatypeProperty ;
                 rdfs:domain ucm:ConsentDirective ;
                 rdfs:range xsd:boolean ;
                 rdfs:comment "Convenience flag that the subject's record is locked to other agencies. Prefer a sensitivity label plus a deny provision." ;
                 rdfs:label "record locked" .


###  https://www.w3.org/ns/ucm#identifierValue
ucm:identifierValue rdf:type owl:DatatypeProperty ;
                    rdfs:domain ucm:Identifier ;
                    rdfs:range xsd:string ;
                    rdfs:comment "The value of an identifier." ;
                    rdfs:label "identifier value" .


###  https://www.w3.org/ns/ucm#identifierSystem
ucm:identifierSystem rdf:type owl:DatatypeProperty ;
                     rdfs:domain ucm:Identifier ;
                     rdfs:range xsd:anyURI ;
                     rdfs:comment "The namespace in which an identifier value is unique. For an OpenID Connect subject, the issuer." ;
                     rdfs:label "identifier system" .


###  https://www.w3.org/ns/ucm#trustFrameworkIdentifier
ucm:trustFrameworkIdentifier rdf:type owl:DatatypeProperty ;
                             rdfs:domain ucm:TrustFramework ;
                             rdfs:range xsd:string ;
                             rdfs:comment "The string that names a trust framework in identity claims, such as the OpenID Connect for Identity Assurance trust_framework value." ;
                             rdfs:label "trust framework identifier" .


###  https://www.w3.org/ns/ucm#withdrawalMethod
ucm:withdrawalMethod rdf:type owl:DatatypeProperty ;
                     rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentDirective ucm:PrivacyNotice ucm:ConsentPolicy ) ] ;
                     rdfs:range xsd:string ;
                     rdfs:comment "How the person can revoke the consent: a URL, phone number, form or written instructions, as text (ISO/IEC TS 27560 withdrawal method)." ;
                     rdfs:label "withdrawal method" .


###  https://www.w3.org/ns/ucm#retentionPeriod
ucm:retentionPeriod rdf:type owl:DatatypeProperty ;
                    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( ucm:ConsentDirective ucm:ConsentProvision ) ] ;
                    rdfs:range xsd:duration ;
                    rdfs:comment "How long data covered by the consent may be kept, as a duration such as P7Y (ISO/IEC TS 27560 retention period)." ;
                    rdfs:label "retention period" .


#    Classes

###  https://www.w3.org/ns/ucm#ConsentInteraction
ucm:ConsentInteraction rdf:type owl:Class ;
                       rdfs:subClassOf ucm:Process ;
                       rdfs:comment "A process in which a person, or someone authorized to act for them, grants, refuses, amends, renews, verifies or revokes permission for the collection, use or disclosure of information, or for an action concerning them." ;
                       rdfs:label "Consent Interaction" .


###  https://www.w3.org/ns/ucm#ConsentDirective
ucm:ConsentDirective rdf:type owl:Class ;
                     rdfs:subClassOf ucm:InformationArtifact ;
                     rdfs:comment "A record of the choices a person, or a party acting for them, has made to permit or deny identified actions by identified parties, for given purposes, over given information, for a period. Corresponds to an FHIR Consent and an HMIS release of information. It is an information artifact, not a statement." ;
                     rdfs:label "Consent Directive" .


###  https://www.w3.org/ns/ucm#ConsentProvision
ucm:ConsentProvision rdf:type owl:Class ;
                     rdfs:comment "A rule within a consent directive that permits or denies specific actions by specific actors, for specific purposes, on specific information, within a period. Provisions nest as exceptions: each provision's decision is the opposite of its parent's." ;
                     rdfs:label "Consent Provision" .


###  https://www.w3.org/ns/ucm#PrivacyNotice
ucm:PrivacyNotice rdf:type owl:Class ;
                  rdfs:subClassOf ucm:PolicyDefinition ;
                  rdfs:comment "A published statement of an organization's or program's purposes for collecting information and its permitted uses and disclosures, which applies without an individual consent act." ;
                  rdfs:label "Privacy Notice" .


###  https://www.w3.org/ns/ucm#ConsentPolicy
ucm:ConsentPolicy rdf:type owl:Class ;
                  rdfs:subClassOf ucm:PolicyDefinition ;
                  rdfs:comment "A policy, regulation or program rule that sets the consent model, the default decision and the conditions under which consent is required, allowed or not needed." ;
                  rdfs:label "Consent Policy" .


###  https://www.w3.org/ns/ucm#SelfConsentRule
ucm:SelfConsentRule rdf:type owl:Class ;
                    rdfs:subClassOf ucm:ConsentPolicy ;
                    rdfs:comment "A rule, in force in a jurisdiction, that sets when a minor or youth may consent for themselves: from what age, for which purposes, categories or sensitivities, and under what conditions." ;
                    rdfs:label "Self-Consent Rule" .


###  https://www.w3.org/ns/ucm#JurisdictionContext
ucm:JurisdictionContext rdf:type owl:Class ;
                        rdfs:subClassOf ucm:SemanticContext ;
                        rdfs:comment "A legal or administrative region whose rules govern consent or identity, such as a country, state, county, tribal nation or HUD Continuum of Care. Jurisdictions can nest." ;
                        rdfs:label "Jurisdiction Context" .


###  https://www.w3.org/ns/ucm#Identity
ucm:Identity rdf:type owl:Class ;
             rdfs:subClassOf ucm:InformationArtifact ;
             rdfs:comment "A set of identifiers, attributes and characteristics by which one entity is recognized within a context, such as a system, program, jurisdiction or trust framework. An entity can have many identities." ;
             rdfs:label "Identity" .


###  https://www.w3.org/ns/ucm#Identifier
ucm:Identifier rdf:type owl:Class ;
               rdfs:subClassOf ucm:InformationArtifact ;
               rdfs:comment "A value, unique within a stated system or issuer, that designates an identity, such as a medical record number, HMIS Personal ID, Medicaid ID, state ID number, OpenID Connect subject or decentralized identifier." ;
               rdfs:label "Identifier" .


###  https://www.w3.org/ns/ucm#IdentityProofing
ucm:IdentityProofing rdf:type owl:Class ;
                     rdfs:subClassOf ucm:Process ;
                     rdfs:comment "A process that establishes, to a stated assurance level, that an identity corresponds to a specific real-life entity (NIST SP 800-63A)." ;
                     rdfs:label "Identity Proofing" .


###  https://www.w3.org/ns/ucm#IdentityEvidence
ucm:IdentityEvidence rdf:type owl:Class ;
                     rdfs:subClassOf ucm:InformationArtifact ;
                     rdfs:comment "Evidence used in identity proofing: a document, an electronic record, a vouch by another party, or an electronic signature." ;
                     rdfs:label "Identity Evidence" .


###  https://www.w3.org/ns/ucm#Authentication
ucm:Authentication rdf:type owl:Class ;
                   rdfs:subClassOf ucm:Process ;
                   rdfs:comment "A process in which a claimant proves control of one or more authenticators bound to an identity (NIST SP 800-63B)." ;
                   rdfs:label "Authentication" .


###  https://www.w3.org/ns/ucm#IdentityAssertion
ucm:IdentityAssertion rdf:type owl:Class ;
                      rdfs:subClassOf ucm:InformationArtifact ;
                      rdfs:comment "A statement from an identity provider to a relying party about an authenticated identity, at a stated federation assurance level, such as an OpenID Connect ID Token or a SAML assertion (NIST SP 800-63C)." ;
                      rdfs:label "Identity Assertion" .


###  https://www.w3.org/ns/ucm#Credential
ucm:Credential rdf:type owl:Class ;
               rdfs:subClassOf ucm:InformationArtifact ;
               rdfs:comment "A set of claims about an identity, issued and signed by an issuer, and held by the subject or a holder, such as a W3C Verifiable Credential." ;
               rdfs:label "Credential" .


###  https://www.w3.org/ns/ucm#TrustFramework
ucm:TrustFramework rdf:type owl:Class ;
                   rdfs:subClassOf ucm:PolicyDefinition ;
                   rdfs:comment "A set of rules, under a governing body, for identity proofing, authentication, federation and certification that participants agree to rely on, such as NIST SP 800-63-4, a Kantara assurance program, or the TEFCA Individual Access Services rules." ;
                   rdfs:label "Trust Framework" .


###  https://www.w3.org/ns/ucm#AssuranceCertification
ucm:AssuranceCertification rdf:type owl:Class ;
                           rdfs:subClassOf ucm:InformationArtifact ;
                           rdfs:comment "A record that an assessor has found a provider conformant to a trust framework at stated assurance levels, for a period." ;
                           rdfs:label "Assurance Certification" .


###  https://www.w3.org/ns/ucm#ConsentSubjectRole
ucm:ConsentSubjectRole rdf:type owl:Class ;
                       rdfs:subClassOf ucm:SubjectRole ;
                       rdfs:comment "The role of the person or group whose information or care a consent concerns." ;
                       rdfs:label "Consent Subject Role" .


###  https://www.w3.org/ns/ucm#ConsentGrantorRole
ucm:ConsentGrantorRole rdf:type owl:Class ;
                       rdfs:subClassOf ucm:Role ;
                       rdfs:comment "The role of the party who makes a consent choice. Often the same entity as the subject." ;
                       rdfs:label "Consent Grantor Role" .


###  https://www.w3.org/ns/ucm#ConsentProxyRole
ucm:ConsentProxyRole rdf:type owl:Class ;
                     rdfs:subClassOf ucm:ConsentGrantorRole ;
                     rdfs:comment "The role of a grantor acting for the subject, such as a parent, guardian, legal representative or authorized caregiver." ;
                     rdfs:label "Consent Proxy Role" .


###  https://www.w3.org/ns/ucm#InformationRecipientRole
ucm:InformationRecipientRole rdf:type owl:Class ;
                             rdfs:subClassOf ucm:Role ;
                             rdfs:comment "The role of a party that a consent provision permits or denies to collect, access, use or disclose information." ;
                             rdfs:label "Information Recipient Role" .


###  https://www.w3.org/ns/ucm#InformationCustodianRole
ucm:InformationCustodianRole rdf:type owl:Class ;
                             rdfs:subClassOf ucm:Role ;
                             rdfs:comment "The role of a party responsible for holding, managing or enforcing a consent or the data it covers." ;
                             rdfs:label "Information Custodian Role" .


###  https://www.w3.org/ns/ucm#ConsentManagerRole
ucm:ConsentManagerRole rdf:type owl:Class ;
                       rdfs:subClassOf ucm:InformationCustodianRole ;
                       rdfs:comment "The role of a custodian that maintains the consent record (FHIR Consent.manager)." ;
                       rdfs:label "Consent Manager Role" .


###  https://www.w3.org/ns/ucm#DataControllerRole
ucm:DataControllerRole rdf:type owl:Class ;
                       rdfs:subClassOf ucm:InformationCustodianRole ;
                       rdfs:comment "The role of a custodian that determines the purposes and means of processing and enforces the consent (FHIR Consent.controller; GDPR controller)." ;
                       rdfs:label "Data Controller Role" .


###  https://www.w3.org/ns/ucm#ConsentWitnessRole
ucm:ConsentWitnessRole rdf:type owl:Class ;
                       rdfs:subClassOf ucm:Role ;
                       rdfs:comment "The role of a party who witnessed a consent interaction." ;
                       rdfs:label "Consent Witness Role" .


###  https://www.w3.org/ns/ucm#ConsentVerifierRole
ucm:ConsentVerifierRole rdf:type owl:Class ;
                        rdfs:subClassOf ucm:Role ;
                        rdfs:comment "The role of a party who verified a consent with the subject or grantor." ;
                        rdfs:label "Consent Verifier Role" .


###  https://www.w3.org/ns/ucm#IdentityApplicantRole
ucm:IdentityApplicantRole rdf:type owl:Class ;
                          rdfs:subClassOf ucm:SubjectRole ;
                          rdfs:comment "The role of the entity whose identity is being proofed." ;
                          rdfs:label "Identity Applicant Role" .


###  https://www.w3.org/ns/ucm#CredentialServiceProviderRole
ucm:CredentialServiceProviderRole rdf:type owl:Class ;
                                  rdfs:subClassOf ucm:Role ;
                                  rdfs:comment "The role of a party that proofs identities and issues or binds authenticators (NIST CSP)." ;
                                  rdfs:label "Credential Service Provider Role" .


###  https://www.w3.org/ns/ucm#IdentityProviderRole
ucm:IdentityProviderRole rdf:type owl:Class ;
                         rdfs:subClassOf ucm:Role ;
                         rdfs:comment "The role of a party that authenticates a subscriber and issues identity assertions to relying parties." ;
                         rdfs:label "Identity Provider Role" .


###  https://www.w3.org/ns/ucm#RelyingPartyRole
ucm:RelyingPartyRole rdf:type owl:Class ;
                     rdfs:subClassOf ucm:Role ;
                     rdfs:comment "The role of a party that relies on an identity assertion or credential." ;
                     rdfs:label "Relying Party Role" .


###  https://www.w3.org/ns/ucm#ProofingAgentRole
ucm:ProofingAgentRole rdf:type owl:Class ;
                      rdfs:subClassOf ucm:Role ;
                      rdfs:comment "The role of a person who conducts attended identity proofing for a credential service provider." ;
                      rdfs:label "Proofing Agent Role" .


###  https://www.w3.org/ns/ucm#TrustedRefereeRole
ucm:TrustedRefereeRole rdf:type owl:Class ;
                       rdfs:subClassOf ucm:Role ;
                       rdfs:comment "The role of a person authorized by a credential service provider to make risk-based identity decisions for applicants who cannot meet the normal evidence requirements (NIST SP 800-63A)." ;
                       rdfs:label "Trusted Referee Role" .


###  https://www.w3.org/ns/ucm#ApplicantReferenceRole
ucm:ApplicantReferenceRole rdf:type owl:Class ;
                           rdfs:subClassOf ucm:Role ;
                           rdfs:comment "The role of a person who vouches for an applicant's identity or circumstances, such as homelessness, without acting on the applicant's behalf (NIST SP 800-63A)." ;
                           rdfs:label "Applicant Reference Role" .


