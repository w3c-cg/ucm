<http://purl.bioontology.org/ontology/SNOMEDCT#337915000> rdf:type owl:Class ;
                                                          owl:equivalentClass ucm:Person ;
                                                          rdfs:label "Homo sapiens" .


###  http://purl.obolibrary.org/obo/NCBITaxon#9606
<http://purl.obolibrary.org/obo/NCBITaxon#9606> rdf:type owl:Class ;
                                                owl:equivalentClass ucm:Person ;
                                                rdfs:label "Homo sapiens" .


###  https://www.commoncoreontologies.org/AgentOntology#ont00001262
cco:ont00001262 rdf:type owl:Class ;
                owl:equivalentClass ucm:Person ;
                rdfs:label "Person" ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "Human" .


###  urn:w3c:cg:ucm#BehavioralHealthContext
ucm:BehavioralHealthContext rdf:type owl:Class ;
