@prefix ucm: <http://mdixinc.com/ucm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://mdixinc.com/ucm/views/operations> rdf:type owl:Ontology ;
    rdfs:label "UCM Operational Semantics" ;
    rdfs:comment "A simplified WebVOWL-friendly view of the UCM Coordination Semantics and Lifecycle Model designed for computable lifecycle semantics on shared operational care workflows." .

# Core Classes 

ucm:CoordinationRequest rdf:type owl:Class ;
    rdfs:subClassOf ucm:Process ;
    rdfs:label "Care Coordination Request" ; 
    rdfs:comment "A process in which coordination is requested between participating entities." .

ucm:CoordinativeActivity rdf:type owl:Class ;
    rdfs:subClassOf ucm:Process ;
    rdfs:label "Coordinative Care Activity" ;
    rdfs:comment "A situated activity whose process is shared by participating entities in its care coordination lifecycle." .

ucm:ActivityFocus rdf:type owl:Class ;
    rdfs:label "Activity Focus" ;
    rdfs:comment "The matter, condition, or situation toward which a coordinated activity is orchestrated and which the activity seeks to jointly maintain, update, resolve, or bring about." . 
# Examples for this may include: housing stability, food security, shelter connection, patient discharge. This is semantically separate from a motive or goal-directed outcome, since it's more specifically defining what is being worked on as a shared process. The state of the care coordination can be distinctly captured under LifecycleState or a local data dictionary. 

# Object Properties 

ucm:hasLifecycleState rdf:type owl:ObjectProperty ;
    rdfs:domain ucm:Process ;
    rdfs:range skos:Concept ;
    rdfs:label "has lifecycle state" ;
    rdfs:comment "Relates a process to a lifecycle state." .

ucm:hasActivityFocus rdf:type owl:ObjectProperty ;
    rdfs:domain ucm:Process ; 
    rdfs:range ucm:ActivityFocus ; 
    rdfs:label "has activity focus" ; 
    rdfs:comment "Situates a process within an activity focus." .
# An example: patient discharge has the activity focus of safely discharging a patient. 

ucm:acceptsRequest rdf:type owl:ObjectProperty ;
    rdfs:domain ucm:Entity ;
    rdfs:range ucm:ParticipationContext ;
    rdfs:label "accepts request" ;
    rdfs:comment "A participating entity accepts a care coordination request." .