    {
      "@id": "ucm:shapes",
      "@type": "owl:Ontology",
      "rdfs:comment": "Validation shapes for the Unified Care Model core.\n\nCONVENTION\n  Open by default. No shape uses sh:closed: adopters' own predicates and\n  types (FHIR, HMIS, local data dictionaries, provenance) never produce results.\n\n  Two tiers, tagged with ucmsh:tier and enforced by ucm-shapes-lint.ttl:\n    ucmsh:Definitional  sh:Violation. The data is not a well-formed instance\n                        of the UCM concept: identity-forming edges missing or\n                        duplicated, literals where entities are required,\n                        intervals that end before they begin, cycles with no\n                        base case.\n    ucmsh:Recommended   sh:Warning. Good practice the spec encourages but a\n                        conformant adopter may not yet follow.\n\n  sh:severity is set on every property shape individually. SHACL does not\n  carry a node shape's severity down to its nested property shapes; an\n  untagged property shape reports sh:Violation.\n\n  Type constraints that mirror an rdfs:range (sh:class) are Recommended only.\n  Under RDFS/OWL inference they are vacuous; without inference they reject\n  data typed in a partner ontology. Structural kind (sh:nodeKind) is\n  Definitional, because it is decidable from the data alone.\n\n  Date and time values accept xsd:dateTime or xsd:dateTimeStamp. sh:datatype\n  xsd:dateTime alone rejects xsd:dateTimeStamp, the form OWL-Time recommends.\n  Ordering checks use SPARQL with explicit casts; sh:lessThanOrEquals crashes\n  pySHACL on misordered xsd:dateTimeStamp values.",
      "rdfs:label": "UCM Core Shapes (draft)",
      "owl:imports": {
        "@id": "https://www.w3.org/ns/ucm#"
      }
    },
    {
      "@id": "ucm:tier",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "_:c14n0",
      "sh:class": {
        "@id": "ucm:CareTrajectoryContext"
      },
      "sh:message": "Care trajectory context is not typed as ucm:CareTrajectoryContext.",
      "sh:path": {
        "@id": "ucm:hasCareTrajectoryContext"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n1",
      "sh:class": {
        "@id": "ucm:ActivityFocus"
      },
      "sh:message": "Activity focus is not typed as ucm:ActivityFocus.",
      "sh:path": {
        "@id": "ucm:hasActivityFocus"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n10",
      "sh:message": "Identifier type is neither in ucm:IdentifierType nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasIdentifierType ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:IdentifierType)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:IdentifierType))\n                }\n            }"
    },
    {
      "@id": "_:c14n100",
      "sh:datatype": {
        "@id": "xsd:dateTime"
      }
    },
    {
      "@id": "_:c14n103",
      "sh:datatype": {
        "@id": "xsd:dateTimeStamp"
      }
    },
    {
      "@id": "_:c14n105",
      "sh:datatype": {
        "@id": "xsd:dateTimeStamp"
      }
    },
    {
      "@id": "_:c14n107",
      "sh:datatype": {
        "@id": "xsd:dateTimeStamp"
      }
    },
    {
      "@id": "_:c14n11",
      "sh:message": "A minor (under 18 on the consent date, from ucm:birthDate) is their own grantor, but the directive is not governedByPolicy a ucm:SelfConsentRule in force in its jurisdiction whose minimum age the subject had reached.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n            PREFIX time: <http://www.w3.org/2006/time#>\n            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>\n            PREFIX dpv:  <https://w3id.org/dpv#>\n            SELECT $this ?subject WHERE {\n                $this ucm:consentSubject/ucm:participatingEntity ?subject .\n                $this ucm:recordsConsentFrom ?ci .\n                ?gp ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentGrantorRole .\n                { ?gp ucm:occursWithin ?ci } UNION { ?ci ucm:hasParticipant ?gp }\n                ?gp ucm:participatingEntity ?subject .\n                ?subject ucm:birthDate ?bd .\n                ?ci ucm:occursDuring ?when .\n                ?when (time:hasBeginning/(time:inXSDDateTimeStamp|time:inXSDDateTime))|time:inXSDDateTimeStamp|time:inXSDDateTime ?at .\n                # Latest possible birth date for a partial date: the conservative reading.\n                BIND (STR(?bd) AS ?b)\n                BIND (IF(STRLEN(?b) = 4, CONCAT(?b, \"-12-31\"), IF(STRLEN(?b) = 7, CONCAT(?b, \"-31\"), SUBSTR(?b, 1, 10))) AS ?latest)\n                BIND (SUBSTR(STR(?at), 1, 10) AS ?on)\n                BIND (xsd:integer(SUBSTR(?on, 1, 4)) - xsd:integer(SUBSTR(?latest, 1, 4))\n                      - IF(SUBSTR(?on, 6, 5) < SUBSTR(?latest, 6, 5), 1, 0) AS ?age)\n                FILTER (?age < 18)\n                FILTER NOT EXISTS {\n                    $this ucm:governedByPolicy ?rule .\n                    ?rule a/rdfs:subClassOf* ucm:SelfConsentRule ;\n                          dpv:hasJurisdiction ?rj .\n                    { $this dpv:hasJurisdiction/ucm:withinJurisdiction* ?rj }\n                    UNION\n                    { ?ci dpv:hasJurisdiction/ucm:withinJurisdiction* ?rj }\n                    OPTIONAL { ?rule ucm:minimumSelfConsentAge ?min }\n                    FILTER (!BOUND(?min) || ?age >= ?min)\n                }\n            }"
    },
    {
      "@id": "_:c14n12",
      "sh:class": {
        "@id": "ucm:Identity"
      },
      "sh:message": "hasIdentity target is not typed as ucm:Identity.",
      "sh:path": {
        "@id": "ucm:hasIdentity"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n13",
      "sh:message": "Self-consent scope is neither in ucm:PurposeOfUse or ucm:ConsentCategory or ucm:InformationCategory or ucm:SensitivityCategory nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:selfConsentScope ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:PurposeOfUse, ucm:ConsentCategory, ucm:InformationCategory, ucm:SensitivityCategory)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:PurposeOfUse, ucm:ConsentCategory, ucm:InformationCategory, ucm:SensitivityCategory))\n                }\n            }"
    },
    {
      "@id": "_:c14n14",
      "sh:message": "Federation assurance level is neither in ucm:FederationAssuranceLevel nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:achievedFAL ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:FederationAssuranceLevel)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:FederationAssuranceLevel))\n                }\n            }"
    },
    {
      "@id": "_:c14n15",
      "sh:class": {
        "@id": "ucm:ConsentProvision"
      },
      "sh:message": "hasProvision target is not typed as ucm:ConsentProvision.",
      "sh:path": {
        "@id": "ucm:hasProvision"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n16",
      "sh:message": "Handshake negotiates itself, directly or through a chain: the negotiation has no base case.",
      "sh:select": "\n            PREFIX ucm: <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE { $this ucm:negotiates+ $this }"
    },
    {
      "@id": "_:c14n17",
      "sh:datatype": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "_:c14n18",
      "sh:message": "Referral disposition is neither in ucm:ReferralDisposition nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasReferralDisposition ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ucm:ReferralDisposition }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme\n                           ucm:ReferralDisposition\n                }\n            }"
    },
    {
      "@id": "_:c14n19",
      "sh:message": "Convenience projection (hasClient/hasPatient/hasResident) has no backing participation with the matching role.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n            SELECT $this WHERE {\n                # UNION, not VALUES: SHACL forbids VALUES in SPARQL constraints.\n                { $this ucm:hasClient   ?person . BIND (ucm:ClientRole   AS ?roleClass) }\n                UNION\n                { $this ucm:hasPatient  ?person . BIND (ucm:PatientRole  AS ?roleClass) }\n                UNION\n                { $this ucm:hasResident ?person . BIND (ucm:ResidentRole AS ?roleClass) }\n                FILTER NOT EXISTS {\n                    ?p ucm:participatingEntity ?person ;\n                       ucm:assumesRole/a/rdfs:subClassOf* ?roleClass .\n                    { ?p ucm:occursWithin $this } UNION { $this ucm:hasParticipant ?p }\n                }\n            }"
    },
    {
      "@id": "_:c14n2",
      "sh:message": "An applicant reference does not act on the applicant's behalf (NIST SP 800-63A): the same entity is the applicant, or is the applicant's consent proxy.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n            SELECT $this ?ref WHERE {\n                ?rp ucm:assumesRole/a/rdfs:subClassOf* ucm:ApplicantReferenceRole ;\n                    ucm:participatingEntity ?ref .\n                { ?rp ucm:occursWithin $this } UNION { $this ucm:hasParticipant ?rp }\n                ?ap ucm:assumesRole/a/rdfs:subClassOf* ucm:IdentityApplicantRole ;\n                    ucm:participatingEntity ?applicant .\n                { ?ap ucm:occursWithin $this } UNION { $this ucm:hasParticipant ?ap }\n                FILTER (?ref = ?applicant || EXISTS {\n                    ?cd ucm:consentSubject/ucm:participatingEntity ?applicant ;\n                        ucm:recordsConsentFrom ?ci .\n                    ?pp ucm:participatingEntity ?ref ;\n                        ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentProxyRole .\n                    { ?pp ucm:occursWithin ?ci } UNION { ?ci ucm:hasParticipant ?pp }\n                })\n            }"
    },
    {
      "@id": "_:c14n21",
      "sh:message": "Consent modality is neither in ucm:ConsentModality nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasConsentModality ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:ConsentModality)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:ConsentModality))\n                }\n            }"
    },
    {
      "@id": "_:c14n22",
      "sh:message": "Consent decision is neither in ucm:ConsentDecision nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasConsentDecision ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:ConsentDecision)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:ConsentDecision))\n                }\n            }"
    },
    {
      "@id": "_:c14n24",
      "sh:class": {
        "@id": "ucm:Identity"
      },
      "sh:message": "identifiedAs target is not typed as ucm:Identity.",
      "sh:path": {
        "@id": "ucm:identifiedAs"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n25",
      "sh:message": "Regulatory basis is neither in ucm:RegulatoryBasis nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            PREFIX dpv:  <https://w3id.org/dpv#>\n            SELECT $this ?value WHERE {\n                $this dpv:hasApplicableLaw ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:RegulatoryBasis)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:RegulatoryBasis))\n                }\n            }"
    },
    {
      "@id": "_:c14n26",
      "sh:message": "A process lists this participation via hasParticipant, but the participation occurs within a different process.",
      "sh:select": "\n            PREFIX ucm: <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE {\n                ?claimant ucm:hasParticipant $this .\n                $this ucm:occursWithin ?actual .\n                FILTER (?claimant != ?actual)\n            }"
    },
    {
      "@id": "_:c14n27",
      "sh:message": "Participation validTo precedes validFrom.",
      "sh:select": "\n            PREFIX ucm: <https://www.w3.org/ns/ucm#>\n            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n            SELECT $this WHERE {\n                $this ucm:validFrom ?f ; ucm:validTo ?t .\n                FILTER (xsd:dateTime(STR(?t)) < xsd:dateTime(STR(?f)))\n            }"
    },
    {
      "@id": "_:c14n28",
      "sh:message": "Participation uses both validFrom/validTo and enactiveDuring. The two encodings can diverge; prefer enactiveDuring.",
      "sh:select": "\n            PREFIX ucm: <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE {\n                $this ucm:enactiveDuring ?iv .\n                FILTER EXISTS { $this ucm:validFrom|ucm:validTo ?x }\n            }"
    },
    {
      "@id": "_:c14n29",
      "sh:message": "Process cites a consent directive whose status is not active.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            PREFIX dpv:  <https://w3id.org/dpv#>\n            SELECT $this ?value WHERE {\n                $this ucm:authorizedByConsent ?value .\n                ?value dpv:hasConsentStatus ?s .\n                FILTER NOT EXISTS { ?s (skos:exactMatch|^skos:exactMatch)* ucm:ConsentActive }\n            }"
    },
    {
      "@id": "_:c14n3",
      "sh:message": "Confidentiality level is neither in ucm:ConfidentialityLevel nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:coversConfidentiality|ucm:hasConfidentialityLevel ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:ConfidentialityLevel)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:ConfidentialityLevel))\n                }\n            }"
    },
    {
      "@id": "_:c14n30",
      "sh:class": {
        "@id": "ucm:Participation"
      },
      "sh:message": "provisionActor target is not typed as ucm:Participation.",
      "sh:path": {
        "@id": "ucm:provisionActor"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n31",
      "sh:class": {
        "@id": "ucm:ConsentPolicy"
      },
      "sh:message": "governedByPolicy target is not typed as ucm:ConsentPolicy.",
      "sh:path": {
        "@id": "ucm:governedByPolicy"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n32",
      "sh:class": {
        "@id": "ucm:Entity"
      },
      "sh:message": "consentOnBehalfOf target is not typed as ucm:Entity.",
      "sh:path": {
        "@id": "ucm:consentOnBehalfOf"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n33",
      "sh:message": "Consent interaction type is neither in ucm:ConsentInteractionType nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasConsentInteractionType ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:ConsentInteractionType)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:ConsentInteractionType))\n                }\n            }"
    },
    {
      "@id": "_:c14n34",
      "sh:class": {
        "@id": "ucm:TrustFramework"
      },
      "sh:message": "underTrustFramework target is not typed as ucm:TrustFramework.",
      "sh:path": {
        "@id": "ucm:underTrustFramework"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n35",
      "sh:message": "Authenticator assurance level is neither in ucm:AuthenticatorAssuranceLevel nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:achievedAAL|ucm:requiresAAL ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:AuthenticatorAssuranceLevel)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:AuthenticatorAssuranceLevel))\n                }\n            }"
    },
    {
      "@id": "_:c14n36",
      "sh:message": "Grantor is neither the subject nor a member of the subject group, so the grantor's role should be ucm:ConsentProxyRole (or a subclass).",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n            SELECT $this ?grantor WHERE {\n                $this ucm:recordsConsentFrom ?ci .\n                ?gp ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentGrantorRole .\n                { ?gp ucm:occursWithin ?ci } UNION { ?ci ucm:hasParticipant ?gp }\n                ?gp ucm:participatingEntity ?grantor .\n                $this ucm:consentSubject/ucm:participatingEntity ?subject .\n                FILTER (?grantor != ?subject)\n                FILTER NOT EXISTS { ?gp ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentProxyRole }\n                # A member of a group subject (such as a household) may grant for themselves.\n                FILTER NOT EXISTS { ?subject ucm:hasMember ?grantor }\n                FILTER NOT EXISTS { ?grantor ucm:memberOf ?subject }\n                FILTER NOT EXISTS { ?grantor ucm:hasMembership/ucm:membershipIn ?subject }\n            }"
    },
    {
      "@id": "_:c14n37",
      "sh:class": {
        "@id": "ucm:InformationArtifact"
      },
      "sh:message": "sourceDocument target is not typed as ucm:InformationArtifact.",
      "sh:path": {
        "@id": "ucm:sourceDocument"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n38",
      "sh:message": "Withdrawal or revocation is half-recorded: status is withdrawn or revoked with no revokedBy, or revokedBy is set while the status is still active.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            PREFIX dpv:  <https://w3id.org/dpv#>\n            SELECT $this WHERE {\n                {\n                    $this dpv:hasConsentStatus/(skos:exactMatch|^skos:exactMatch)* ?ended .\n                    FILTER (?ended IN (dpv:ConsentWithdrawn, dpv:ConsentRevoked))\n                    FILTER NOT EXISTS { $this ucm:revokedBy ?r }\n                } UNION {\n                    $this ucm:revokedBy ?r ;\n                          dpv:hasConsentStatus/(skos:exactMatch|^skos:exactMatch)* ucm:ConsentActive .\n                }\n            }"
    },
    {
      "@id": "_:c14n39",
      "sh:message": "Handshake fulfillment is neither in ucm:HandshakeFulfillment nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasHandshakeFulfillment ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ucm:HandshakeFulfillment }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme\n                           ucm:HandshakeFulfillment\n                }\n            }"
    },
    {
      "@id": "_:c14n4",
      "sh:class": {
        "@id": "ucm:IdentityEvidence"
      },
      "sh:message": "usedEvidence target is not typed as ucm:IdentityEvidence.",
      "sh:path": {
        "@id": "ucm:usedEvidence"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n41",
      "sh:class": {
        "@id": "ucm:JurisdictionContext"
      },
      "sh:message": "hasJurisdiction target is not typed as ucm:JurisdictionContext.",
      "sh:path": {
        "@id": "dpv:hasJurisdiction"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n42",
      "sh:class": {
        "@id": "ucm:Participation"
      },
      "sh:message": "acceptsRequest target is not typed as ucm:Participation.",
      "sh:path": {
        "@id": "ucm:acceptsRequest"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n43",
      "sh:message": "Interval ends before it begins.",
      "sh:select": "\n            PREFIX time: <http://www.w3.org/2006/time#>\n            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>\n            SELECT $this WHERE {\n                $this time:hasBeginning/(time:inXSDDateTimeStamp|time:inXSDDateTime) ?b ;\n                      time:hasEnd/(time:inXSDDateTimeStamp|time:inXSDDateTime) ?e .\n                FILTER (xsd:dateTime(STR(?e)) < xsd:dateTime(STR(?b)))\n            }"
    },
    {
      "@id": "_:c14n44",
      "sh:message": "Provision contains itself, directly or through nested provisions.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE { $this ucm:hasProvision+ $this }"
    },
    {
      "@id": "_:c14n45",
      "sh:message": "Purpose of use is neither in ucm:PurposeOfUse nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            PREFIX dpv:  <https://w3id.org/dpv#>\n            SELECT $this ?value WHERE {\n                $this dpv:hasPurpose ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:PurposeOfUse)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:PurposeOfUse))\n                }\n            }"
    },
    {
      "@id": "_:c14n46",
      "sh:message": "Sensitivity category is neither in ucm:SensitivityCategory nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:coversSensitivity|ucm:hasSensitivityLabel ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:SensitivityCategory)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:SensitivityCategory))\n                }\n            }"
    },
    {
      "@id": "_:c14n47",
      "sh:class": {
        "@id": "ucm:Identity"
      },
      "sh:message": "assertsIdentity target is not typed as ucm:Identity.",
      "sh:path": {
        "@id": "ucm:assertsIdentity"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n48",
      "sh:class": {
        "@id": "dpv:PrivacyNotice"
      },
      "sh:message": "acknowledgesNotice target is not typed as dpv:PrivacyNotice.",
      "sh:path": {
        "@id": "ucm:acknowledgesNotice"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n49",
      "sh:alternativePath": {
        "@list": [
          {
            "@id": "ucm:participationContext"
          },
          {
            "@id": "ucm:scopedBy"
          }
        ]
      }
    },
    {
      "@id": "_:c14n5",
      "sh:message": "Birth date quality is neither in ucm:BirthDateQuality nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:birthDateQuality ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:BirthDateQuality)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:BirthDateQuality))\n                }\n            }"
    },
    {
      "@id": "_:c14n50",
      "sh:message": "Identity assurance level is neither in ucm:IdentityAssuranceLevel nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:achievedIAL|ucm:requiresIAL ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:IdentityAssuranceLevel)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:IdentityAssuranceLevel))\n                }\n            }"
    },
    {
      "@id": "_:c14n51",
      "sh:message": "Proofing type is neither in ucm:ProofingType nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasProofingType ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:ProofingType)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:ProofingType))\n                }\n            }"
    },
    {
      "@id": "_:c14n52",
      "sh:message": "Commitment status is neither in ucm:CommitmentStatus nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasCommitmentStatus ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ucm:CommitmentStatus }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme\n                           ucm:CommitmentStatus\n                }\n            }"
    },
    {
      "@id": "_:c14n54",
      "sh:message": "Consent category is neither in ucm:ConsentCategory nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasConsentCategory ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:ConsentCategory)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:ConsentCategory))\n                }\n            }"
    },
    {
      "@id": "_:c14n55",
      "sh:message": "The consent subject is a household, and a member who was a minor on the consent date (under 18, from ucm:birthDate) has no ucm:ConsentProxyRole participation acting ucm:consentOnBehalfOf them, and does not self-consent under a ucm:SelfConsentRule whose minimum age they had reached.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n            PREFIX time: <http://www.w3.org/2006/time#>\n            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>\n               SELECT DISTINCT $this ?member WHERE {\n                   $this ucm:consentSubject/ucm:participatingEntity ?hh ;\n                         ucm:recordsConsentFrom ?ci .\n                   ?hh a/rdfs:subClassOf* ucm:Household .\n                   { ?hh ucm:hasMember ?member } UNION { ?member ucm:memberOf ?hh }\n                   UNION { ?member ucm:hasMembership/ucm:membershipIn ?hh }\n            ?member ucm:birthDate ?bd .\n            ?ci ucm:occursDuring ?when .\n            ?when (time:hasBeginning/(time:inXSDDateTimeStamp|time:inXSDDateTime))|time:inXSDDateTimeStamp|time:inXSDDateTime ?at .\n            BIND (STR(?bd) AS ?b)\n            BIND (IF(STRLEN(?b) = 4, CONCAT(?b, \"-12-31\"), IF(STRLEN(?b) = 7, CONCAT(?b, \"-31\"), SUBSTR(?b, 1, 10))) AS ?latest)\n            BIND (SUBSTR(STR(?at), 1, 10) AS ?on)\n            BIND (xsd:integer(SUBSTR(?on, 1, 4)) - xsd:integer(SUBSTR(?latest, 1, 4))\n                  - IF(SUBSTR(?on, 6, 5) < SUBSTR(?latest, 6, 5), 1, 0) AS ?age)\n            FILTER (?age < 18)\n                   FILTER NOT EXISTS {\n                       $this ucm:recordsConsentFrom ?pci .\n                       ?pp ucm:consentOnBehalfOf ?member ;\n                           ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentProxyRole .\n                       { ?pp ucm:occursWithin ?pci } UNION { ?pci ucm:hasParticipant ?pp }\n                   }\n                   FILTER NOT EXISTS {\n                       $this ucm:recordsConsentFrom ?sci ;\n                             ucm:governedByPolicy ?rule .\n                       ?sp ucm:participatingEntity ?member ;\n                           ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentGrantorRole .\n                       { ?sp ucm:occursWithin ?sci } UNION { ?sci ucm:hasParticipant ?sp }\n                       ?rule a/rdfs:subClassOf* ucm:SelfConsentRule .\n                       OPTIONAL { ?rule ucm:minimumSelfConsentAge ?min }\n                       FILTER (!BOUND(?min) || ?age >= ?min)\n                   }\n               }"
    },
    {
      "@id": "_:c14n56",
      "sh:class": {
        "@id": "ucm:Organization"
      },
      "sh:message": "Affiliation target is not typed as ucm:Organization.",
      "sh:path": {
        "@id": "ucm:affiliatedWith"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n57",
      "sh:class": {
        "@id": "ucm:Identifier"
      },
      "sh:message": "hasIdentifier target is not typed as ucm:Identifier.",
      "sh:path": {
        "@id": "ucm:hasIdentifier"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n59",
      "sh:message": "Consent directive supersedes itself, directly or through a chain.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE { $this ucm:supersedes+ $this }"
    },
    {
      "@id": "_:c14n6",
      "sh:message": "Data category is neither in ucm:InformationCategory nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:coversDataCategory ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:InformationCategory)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:InformationCategory))\n                }\n            }"
    },
    {
      "@id": "_:c14n60",
      "sh:datatype": {
        "@id": "xsd:gYearMonth"
      }
    },
    {
      "@id": "_:c14n62",
      "sh:message": "Consent directive is marked active but its period of validity has ended.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            PREFIX time: <http://www.w3.org/2006/time#>\n            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>\n            PREFIX dpv:  <https://w3id.org/dpv#>\n            SELECT $this WHERE {\n                $this dpv:hasConsentStatus/(skos:exactMatch|^skos:exactMatch)* ucm:ConsentActive ;\n                      ucm:validDuring/time:hasEnd/(time:inXSDDateTimeStamp|time:inXSDDateTime) ?end .\n                FILTER (xsd:dateTime(STR(?end)) < NOW())\n            }"
    },
    {
      "@id": "_:c14n63",
      "sh:class": {
        "@id": "ucm:Identity"
      },
      "sh:message": "matchesIdentity target is not typed as ucm:Identity.",
      "sh:path": {
        "@id": "ucm:matchesIdentity"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n64",
      "sh:class": {
        "@id": "ucm:PolicyDefinition"
      },
      "sh:message": "credentialTermsOfUse target is not typed as ucm:PolicyDefinition.",
      "sh:path": {
        "@id": "ucm:credentialTermsOfUse"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n65",
      "sh:class": {
        "@id": "ucm:Entity"
      },
      "sh:message": "identityOf target is not typed as ucm:Entity.",
      "sh:path": {
        "@id": "ucm:identityOf"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n66",
      "sh:message": "Consent directive has no grantor: its recording consent interaction has no participation in a ConsentGrantorRole.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n            SELECT $this WHERE {\n                FILTER NOT EXISTS {\n                    $this ucm:recordsConsentFrom ?ci .\n                    ?gp ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentGrantorRole .\n                    { ?gp ucm:occursWithin ?ci } UNION { ?ci ucm:hasParticipant ?gp }\n                }\n            }"
    },
    {
      "@id": "_:c14n67",
      "sh:message": "Consent status is neither in ucm:ConsentStatus nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            PREFIX dpv:  <https://w3id.org/dpv#>\n            SELECT $this ?value WHERE {\n                $this dpv:hasConsentStatus ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:ConsentStatus)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:ConsentStatus))\n                }\n            }"
    },
    {
      "@id": "_:c14n68",
      "sh:class": {
        "@id": "ucm:ConsentInteraction"
      },
      "sh:message": "recordsConsentFrom target is not typed as ucm:ConsentInteraction.",
      "sh:path": {
        "@id": "ucm:recordsConsentFrom"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n69",
      "sh:message": "Closure reason is neither in ucm:ClosureReason nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasClosureReason ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ucm:ClosureReason }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme\n                           ucm:ClosureReason\n                }\n            }"
    },
    {
      "@id": "_:c14n7",
      "sh:class": {
        "@id": "ucm:JurisdictionContext"
      },
      "sh:message": "withinJurisdiction target is not typed as ucm:JurisdictionContext.",
      "sh:path": {
        "@id": "ucm:withinJurisdiction"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n70",
      "sh:message": "Consent model is neither in ucm:ConsentModel nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasConsentModel ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:ConsentModel)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:ConsentModel))\n                }\n            }"
    },
    {
      "@id": "_:c14n71",
      "sh:class": {
        "@id": "ucm:ConsentInteraction"
      },
      "sh:message": "revokedBy target is not typed as ucm:ConsentInteraction.",
      "sh:path": {
        "@id": "ucm:revokedBy"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n72",
      "sh:message": "The governing consent policy requires an identity or authenticator assurance level that the grantor's recorded identity or authentication does not reach.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n            SELECT $this ?value WHERE {\n                $this ucm:recordsConsentFrom ?ci .\n                ?gp ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentGrantorRole .\n                { ?gp ucm:occursWithin ?ci } UNION { ?ci ucm:hasParticipant ?gp }\n                $this ucm:governedByPolicy ?policy .\n                {\n                    ?policy ucm:requiresIAL ?value .\n                    ?value ucm:assuranceRank ?need .\n                    FILTER NOT EXISTS {\n                        ?gp ucm:identifiedAs/ucm:achievedIAL/ucm:assuranceRank ?got .\n                        FILTER (?got >= ?need)\n                    }\n                } UNION {\n                    ?policy ucm:requiresAAL ?value .\n                    ?value ucm:assuranceRank ?need .\n                    FILTER NOT EXISTS {\n                        ?ci ucm:authenticatedBy/ucm:achievedAAL/ucm:assuranceRank ?got .\n                        FILTER (?got >= ?need)\n                    }\n                }\n            }"
    },
    {
      "@id": "_:c14n73",
      "sh:class": {
        "@id": "ucm:DefinitionArtifact"
      },
      "sh:message": "definedByArtifact target is not typed as ucm:DefinitionArtifact.",
      "sh:path": {
        "@id": "ucm:definedByArtifact"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n74",
      "sh:message": "Retention disposition is neither in ucm:RetentionDisposition nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasRetentionDisposition ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:RetentionDisposition)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:RetentionDisposition))\n                }\n            }"
    },
    {
      "@id": "_:c14n75",
      "sh:message": "Governed action is neither in ucm:ConsentAction nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:governsAction ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:ConsentAction)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:ConsentAction))\n                }\n            }"
    },
    {
      "@id": "_:c14n76",
      "sh:message": "Evidence strength is neither in ucm:EvidenceStrength nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasEvidenceStrength ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:EvidenceStrength)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:EvidenceStrength))\n                }\n            }"
    },
    {
      "@id": "_:c14n77",
      "sh:message": "Self-consent condition is neither in ucm:SelfConsentCondition nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:selfConsentCondition ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:SelfConsentCondition)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:SelfConsentCondition))\n                }\n            }"
    },
    {
      "@id": "_:c14n78",
      "sh:message": "Closure reason recorded on a request that is still pending a decision.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasReferralDisposition|ucm:hasLifecycleState ?value .\n                ?value (skos:exactMatch|^skos:exactMatch)* ucm:ReferralPending .\n            }"
    },
    {
      "@id": "_:c14n79",
      "sh:message": "A provision's decision must be the opposite of its parent's (the directive for a top-level provision, or the enclosing provision).",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                ?parent ucm:hasProvision $this ;\n                        ucm:hasConsentDecision ?pd .\n                $this ucm:hasConsentDecision ?value .\n                ?pd    (skos:exactMatch|^skos:exactMatch)* ?pn .\n                ?value (skos:exactMatch|^skos:exactMatch)* ?vn .\n                FILTER (?pn IN (ucm:Permit, ucm:Deny) && ?pn = ?vn)\n            }"
    },
    {
      "@id": "_:c14n8",
      "sh:message": "Handshake reports services delivered for a request that was declined, withdrawn or expired.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasHandshakeFulfillment ?value .\n                FILTER NOT EXISTS { ?value (skos:exactMatch|^skos:exactMatch)* ucm:FulfillmentNotStarted }\n                $this ucm:negotiates+ ?request .\n                ?request ucm:hasReferralDisposition|ucm:hasLifecycleState ?state .\n                ?state (skos:exactMatch|^skos:exactMatch)* ?ended .\n                FILTER (?ended IN (ucm:ReferralDeclined, ucm:ReferralWithdrawn, ucm:ReferralExpired))\n            }"
    },
    {
      "@id": "_:c14n80",
      "sh:message": "Evidence type is neither in ucm:IdentityEvidenceType nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasEvidenceType ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ?s . FILTER (?s IN (ucm:IdentityEvidenceType)) }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme ?m .\n                    FILTER (?m IN (ucm:IdentityEvidenceType))\n                }\n            }"
    },
    {
      "@id": "_:c14n81",
      "sh:class": {
        "@id": "ucm:Participation"
      },
      "sh:message": "consentSubject target is not typed as ucm:Participation.",
      "sh:path": {
        "@id": "ucm:consentSubject"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n82",
      "sh:class": {
        "@id": "ucm:ConsentDirective"
      },
      "sh:message": "supersedes target is not typed as ucm:ConsentDirective.",
      "sh:path": {
        "@id": "ucm:supersedes"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n83",
      "sh:class": {
        "@id": "ucm:ConsentDirective"
      },
      "sh:message": "authorizedByConsent target is not typed as ucm:ConsentDirective.",
      "sh:path": {
        "@id": "ucm:authorizedByConsent"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n84",
      "sh:class": {
        "@id": "ucm:Entity"
      },
      "sh:message": "issuedBy target is not typed as ucm:Entity.",
      "sh:path": {
        "@id": "ucm:issuedBy"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n85",
      "sh:message": "Participation consents on behalf of someone but does not assume a ucm:ConsentProxyRole (or a subclass).",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n            SELECT $this WHERE {\n                $this ucm:consentOnBehalfOf ?someone .\n                FILTER NOT EXISTS { $this ucm:assumesRole/a/rdfs:subClassOf* ucm:ConsentProxyRole }\n            }"
    },
    {
      "@id": "_:c14n86",
      "sh:class": {
        "@id": "ucm:Authentication"
      },
      "sh:message": "authenticatedBy target is not typed as ucm:Authentication.",
      "sh:path": {
        "@id": "ucm:authenticatedBy"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n87",
      "sh:message": "Coordination process declares no activity focus, directly or through a process it negotiates.",
      "sh:select": "\n            PREFIX ucm: <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE {\n                FILTER NOT EXISTS { $this ucm:negotiates*/ucm:hasActivityFocus ?f }\n            }"
    },
    {
      "@id": "_:c14n88",
      "sh:class": {
        "@id": "ucm:JurisdictionContext"
      },
      "sh:message": "processingLocation target is not typed as ucm:JurisdictionContext.",
      "sh:path": {
        "@id": "ucm:processingLocation"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n89",
      "sh:message": "An entity participates through this participation via participatesThrough, but the participation names a different participating entity.",
      "sh:select": "\n            PREFIX ucm: <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE {\n                ?claimant ucm:participatesThrough $this .\n                $this ucm:participatingEntity ?actual .\n                FILTER (?claimant != ?actual)\n            }"
    },
    {
      "@id": "_:c14n9",
      "sh:class": {
        "@id": "ucm:Location"
      },
      "sh:message": "postedAt target is not typed as ucm:Location.",
      "sh:path": {
        "@id": "ucm:postedAt"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n90",
      "sh:datatype": {
        "@id": "xsd:gYear"
      }
    },
    {
      "@id": "_:c14n92",
      "sh:class": {
        "@id": "ucm:Organization"
      },
      "sh:message": "certifies target is not typed as ucm:Organization.",
      "sh:path": {
        "@id": "ucm:certifies"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n93",
      "sh:message": "Handoff status is neither in ucm:HandoffStatus nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasHandoffStatus ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ucm:HandoffStatus }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme\n                           ucm:HandoffStatus\n                }\n            }"
    },
    {
      "@id": "_:c14n94",
      "sh:inversePath": {
        "@id": "ucm:hasMembership"
      }
    },
    {
      "@id": "_:c14n95",
      "sh:message": "Lifecycle state is neither in ucm:LifecycleState nor SKOS-mapped to a concept that is.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n            SELECT $this ?value WHERE {\n                $this ucm:hasLifecycleState ?value .\n                FILTER NOT EXISTS { ?value skos:inScheme ucm:LifecycleState }\n                FILTER NOT EXISTS {\n                    ?value (skos:exactMatch|skos:closeMatch|skos:broadMatch|skos:narrowMatch)/skos:inScheme\n                           ucm:LifecycleState\n                }\n            }"
    },
    {
      "@id": "_:c14n96",
      "sh:class": {
        "@id": "ucm:Identity"
      },
      "sh:message": "establishesIdentity target is not typed as ucm:Identity.",
      "sh:path": {
        "@id": "ucm:establishesIdentity"
      },
      "sh:severity": {
        "@id": "sh:Warning"
      },
      "ucm:tier": {
        "@id": "ucm:Recommended"
      }
    },
    {
      "@id": "_:c14n97",
      "sh:message": "Jurisdiction lies within itself, directly or through a chain.",
      "sh:select": "\n            PREFIX ucm:  <https://www.w3.org/ns/ucm#>\n            SELECT $this WHERE { $this ucm:withinJurisdiction+ $this }"
    },
    {
      "@id": "_:c14n98",
      "sh:datatype": {
        "@id": "xsd:dateTime"
      }
    },
    {
      "@id": "_:c14n99",
      "sh:datatype": {
        "@id": "xsd:dateTime"
      }
    }
  ]
