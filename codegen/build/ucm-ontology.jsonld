        "@language": "en",
        "@value": "MDIX"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "UCM Identity Assurance Level"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "NIST SP 800-63-4 identity assurance levels. Each level carries ucm:assuranceRank so levels can be compared."
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "NIST SP 800-63-4 names no IAL0; NoIdentityProofing covers the case it describes in words."
      },
