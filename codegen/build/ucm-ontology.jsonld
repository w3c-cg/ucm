      }
    },
    {
      "@id": "ucm:HandoffAcknowledged",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "en",
        "@value": "Received"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The receiving party has acknowledged the handoff but has not yet assumed responsibility."
      },
      "skos:inScheme": {
        "@id": "ucm:HandoffStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Acknowledged"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandoffStatus"
      }
    },
    {
      "@id": "ucm:HandoffAssumed",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "The receiving party has assumed responsibility for the agreed services, and the sending party has released it."
      },
      "skos:inScheme": {
        "@id": "ucm:HandoffStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Assumed"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandoffStatus"
      }
    },
    {
      "@id": "ucm:HandoffDropped",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "The sending party released responsibility before the receiving party assumed it, leaving no one responsible for the agreed services."
      },
      "skos:inScheme": {
        "@id": "ucm:HandoffStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Dropped"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandoffStatus"
      }
    },
    {
      "@id": "ucm:HandoffOffered",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "The sending party has offered responsibility for the agreed services; the receiving party has not acknowledged it."
      },
      "skos:inScheme": {
        "@id": "ucm:HandoffStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Offered"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandoffStatus"
      }
    },
    {
      "@id": "ucm:HandoffReturned",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "The receiving party handed responsibility back to the sending party."
      },
      "skos:inScheme": {
        "@id": "ucm:HandoffStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Returned"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandoffStatus"
      }
    },
    {
      "@id": "ucm:HandoffShared",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "The sending and receiving parties hold responsibility for the agreed services jointly."
      },
      "skos:inScheme": {
        "@id": "ucm:HandoffStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Shared"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandoffStatus"
      }
    },
    {
      "@id": "ucm:HandoffStatus",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-11-07"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "Where does responsibility for the agreed services stand between the sending and receiving parties?"
      },
      "dcterms:publisher": {
        "@language": "en",
        "@value": "MDIX"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "UCM Handoff Status"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The state of a care coordination handoff: whether responsibility for jointly agreed services has moved to the receiving party."
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "This axis tracks responsibility rather than the referral decision. "
      },
      "skos:hasTopConcept": [
        {
          "@id": "ucm:HandoffAcknowledged"
        },
        {
          "@id": "ucm:HandoffAssumed"
        },
        {
          "@id": "ucm:HandoffDropped"
        },
        {
          "@id": "ucm:HandoffOffered"
        },
        {
          "@id": "ucm:HandoffReturned"
        },
        {
          "@id": "ucm:HandoffShared"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Handoff Status"
      }
    },
    {
      "@id": "ucm:Handshake",
      "@type": "owl:Class",
      "rdfs:comment": "A coordinative process through which participating entities negotiate mutual participation in a shared activity.",
      "rdfs:label": "Handshake",
      "rdfs:subClassOf": {
        "@id": "ucm:CoordinativeActivity"
      }
    },
    {
