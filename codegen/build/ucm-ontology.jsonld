        "@language": "en",
        "@value": "Consent Decision"
      }
    },
    {
      "@id": "ucm:ConsentDirective",
      "@type": "owl:Class",
      "rdfs:comment": "A record of the choices a person, or a party acting for them, has made to permit or deny identified actions by identified parties, for given purposes, over given information, for a period. Corresponds to an FHIR Consent and an HMIS release of information. It is an information artifact, not a statement.",
      "rdfs:label": "Consent Directive",
      "rdfs:subClassOf": {
        "@id": "ucm:InformationArtifact"
      }
    },
