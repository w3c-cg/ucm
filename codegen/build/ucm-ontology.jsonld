      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Identity proofing with stronger evidence and verification, remote or in person (NIST IAL2)."
      },
      "skos:inScheme": {
        "@id": "ucm:IdentityAssuranceLevel"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "IAL2"
