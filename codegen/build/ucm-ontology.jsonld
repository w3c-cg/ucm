        "@id": "ucm:ConsentInteraction"
      },
      "rdfs:label": "acknowledges notice",
      "rdfs:range": {
        "@id": "ucm:PrivacyNotice"
      }
    },
    {
      "@id": "ucm:affiliatedWith",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "ucm:Person"
      },
      "rdfs:label": "affiliated with",
      "rdfs:range": {
        "@id": "ucm:Organization"
      }
    },
    {
      "@id": "ucm:amendmentAppliesRetroactively",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": "Whether an amendment to the privacy notice applies to information collected before the amendment.",
      "rdfs:domain": {
        "@id": "ucm:PrivacyNotice"
      },
      "rdfs:label": "amendment applies retroactively",
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "ucm:assertsIdentity",
