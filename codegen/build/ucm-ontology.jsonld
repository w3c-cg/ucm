        "@type": "xsd:date",
        "@value": "2026-11-27"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "Does this consent or provision permit or deny?"
      },
      "dcterms:publisher": {
        "@language": "en",
        "@value": "MDIX"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "UCM Consent Decision"
      },
      "skos:definition": {
