      "rdfs:domain": {
        "@id": "ucm:IdentityAssertion"
      },
      "rdfs:label": "achieved FAL",
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "ucm:achievedIAL",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": "Relates an identity proofing process or identity to the identity assurance level it reached.",
