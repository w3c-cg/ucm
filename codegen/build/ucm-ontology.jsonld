        "@value": "The HUD HMIS Data and Technical Standards, including the privacy and security standards, and the current HMIS Data Standards."
      },
      "skos:inScheme": {
        "@id": "ucm:RegulatoryBasis"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "HMIS Data Standards"
      },
      "skos:topConceptOf": {
