    {
      "@id": "ucm:EvidenceStrength",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-11-27"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "How strong is this identity evidence?"
      },
      "dcterms:publisher": {
        "@language": "en",
        "@value": "MDIX"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "UCM Evidence Strength"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "NIST SP 800-63A-4 strengths of identity evidence."
      },
      "skos:hasTopConcept": [
        {
          "@id": "ucm:FairEvidence"
        },
        {
          "@id": "ucm:StrongEvidence"
        },
        {
          "@id": "ucm:SuperiorEvidence"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Evidence Strength"
      }
    },
    {
      "@id": "ucm:FAL1",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Basic protection: the identity provider signs the assertion with approved cryptography and restricts its audience to a specific relying party or set of relying parties (NIST FAL1)."
      },
      "skos:inScheme": {
        "@id": "ucm:FederationAssuranceLevel"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "FAL1"
      },
      "skos:topConceptOf": {
        "@id": "ucm:FederationAssuranceLevel"
      },
      "ucm:assuranceRank": {
        "@type": "xsd:integer",
        "@value": "1"
      }
    },
    {
      "@id": "ucm:FAL2",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "High protection: the assertion is strongly protected from injection attacks and audience-restricted to a single relying party, under a pre-established trust agreement (NIST FAL2)."
      },
      "skos:inScheme": {
        "@id": "ucm:FederationAssuranceLevel"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "FAL2"
      },
      "skos:topConceptOf": {
        "@id": "ucm:FederationAssuranceLevel"
      },
      "ucm:assuranceRank": {
        "@type": "xsd:integer",
        "@value": "2"
      }
    },
    {
      "@id": "ucm:FAL3",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Very high protection: the relying party also verifies that the subscriber controls an authenticator, named in a holder-of-key assertion or bound to the account, which guards against a compromised identity provider (NIST FAL3)."
      },
      "skos:inScheme": {
        "@id": "ucm:FederationAssuranceLevel"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "FAL3"
      },
      "skos:topConceptOf": {
        "@id": "ucm:FederationAssuranceLevel"
      },
      "ucm:assuranceRank": {
        "@type": "xsd:integer",
        "@value": "3"
      }
    },
    {
      "@id": "ucm:FERPA",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "The Family Educational Rights and Privacy Act (20 U.S.C. 1232g; 34 CFR Part 99)."
      },
      "skos:inScheme": {
        "@id": "ucm:RegulatoryBasis"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "FERPA"
      },
      "skos:topConceptOf": {
        "@id": "ucm:RegulatoryBasis"
      }
    },
    {
      "@id": "ucm:FairEvidence",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Evidence of fair strength (NIST FAIR)."
      },
      "skos:inScheme": {
        "@id": "ucm:EvidenceStrength"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Fair"
      },
      "skos:topConceptOf": {
        "@id": "ucm:EvidenceStrength"
      },
      "ucm:assuranceRank": {
        "@type": "xsd:integer",
        "@value": "1"
      }
    },
    {
      "@id": "ucm:FamilyRequested",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Disclosure requested by the person's family."
      },
      "skos:inScheme": {
        "@id": "ucm:PurposeOfUse"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Family requested"
      },
      "skos:topConceptOf": {
        "@id": "ucm:PurposeOfUse"
      }
    },
    {
      "@id": "ucm:FederationAssuranceLevel",
      "@type": [
        "owl:NamedIndividual",
        "skos:ConceptScheme"
      ],
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-11-27"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "How strongly was the identity assertion protected?"
      },
      "dcterms:publisher": {
        "@language": "en",
        "@value": "MDIX"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "UCM Federation Assurance Level"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "NIST SP 800-63C-4 federation assurance levels (section 2)."
      },
      "skos:hasTopConcept": [
        {
          "@id": "ucm:FAL1"
        },
        {
          "@id": "ucm:FAL2"
        },
        {
          "@id": "ucm:FAL3"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Federation Assurance Level"
      }
    },
    {
      "@id": "ucm:FulfillmentConfirmed",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "en",
        "@value": "Completed"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The requesting party has confirmed that the negotiated services were delivered."
      },
      "skos:inScheme": {
        "@id": "ucm:HandshakeFulfillment"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Confirmed delivered"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandshakeFulfillment"
      }
    },
    {
      "@id": "ucm:FulfillmentNotStarted",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "None of the negotiated services has been delivered yet."
      },
      "skos:inScheme": {
        "@id": "ucm:HandshakeFulfillment"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Not started"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandshakeFulfillment"
      }
    },
    {
      "@id": "ucm:FulfillmentPartial",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "en",
        "@value": "Partially executed"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Some, but not all, of the negotiated services have been delivered."
      },
      "skos:inScheme": {
        "@id": "ucm:HandshakeFulfillment"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Partially delivered"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandshakeFulfillment"
      }
    },
    {
      "@id": "ucm:FulfillmentReported",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:altLabel": {
        "@language": "en",
        "@value": "Pending confirmation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The delivering party reports the negotiated services delivered; the requesting party has not confirmed it."
      },
      "skos:inScheme": {
        "@id": "ucm:HandshakeFulfillment"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Reported delivered"
      },
      "skos:topConceptOf": {
        "@id": "ucm:HandshakeFulfillment"
      }
    },
    {
      "@id": "ucm:FullDateReported",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
