        "@id": "_:c14n32"
      },
      "rdfs:label": "achieved IAL",
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "ucm:acknowledgesNotice",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": "Relates a consent interaction to a privacy notice the subject or grantor was given or shown.",
