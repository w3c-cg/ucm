      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "The directive is being prepared and is not yet in force."
      },
      "skos:inScheme": {
        "@id": "ucm:ConsentStatus"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Draft"
      },
      "skos:topConceptOf": {
        "@id": "ucm:ConsentStatus"
      }
    },
