    {
      "@id": "ucm:AAL1",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Basic confidence that the claimant controls an authenticator bound to the subscriber account, using single-factor or multi-factor authentication (NIST AAL1)."
      },
      "skos:inScheme": {
        "@id": "ucm:AuthenticatorAssuranceLevel"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "AAL1"
      },
      "skos:topConceptOf": {
        "@id": "ucm:AuthenticatorAssuranceLevel"
      },
      "ucm:assuranceRank": {
        "@type": "xsd:integer",
        "@value": "1"
      }
    },
    {
      "@id": "ucm:AAL2",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "High confidence from proof of possession and control of two distinct authentication factors. Verifiers must offer at least one phishing-resistant option (NIST AAL2)."
      },
      "skos:inScheme": {
        "@id": "ucm:AuthenticatorAssuranceLevel"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "AAL2"
      },
      "skos:topConceptOf": {
        "@id": "ucm:AuthenticatorAssuranceLevel"
      },
      "ucm:assuranceRank": {
        "@type": "xsd:integer",
        "@value": "2"
      }
    },
    {
      "@id": "ucm:AAL3",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Very high confidence from a phishing-resistant cryptographic authenticator with a non-exportable private key; syncable authenticators are not allowed (NIST AAL3)."
      },
      "skos:inScheme": {
        "@id": "ucm:AuthenticatorAssuranceLevel"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "AAL3"
      },
      "skos:topConceptOf": {
        "@id": "ucm:AuthenticatorAssuranceLevel"
      },
      "ucm:assuranceRank": {
        "@type": "xsd:integer",
        "@value": "3"
      }
    },
    {
      "@id": "ucm:Abortion",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept"
      ],
      "skos:broader": {
        "@id": "ucm:SexualAndReproductiveHealth"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Information about seeking, obtaining, providing or facilitating abortion. Kept separate because its legal sensitivity varies by jurisdiction."
      },
      "skos:inScheme": {
        "@id": "ucm:SensitivityCategory"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Abortion"
      }
    },
