      "rdfs:range": {
        "@id": "ucm:Identity"
      }
    },
    {
      "@id": "ucm:assumesRole",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "ucm:Participation"
      },
      "rdfs:label": "assumes role",
      "rdfs:range": {
        "@id": "ucm:Role"
      }
    },
    {
      "@id": "ucm:assuranceRank",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": "An integer rank on an assurance or strength level, so levels in one scheme can be compared with >=.",
      "rdfs:domain": {
        "@id": "skos:Concept"
      },
      "rdfs:label": "assurance rank",
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "ucm:authenticatedBy",
      "@type": "owl:ObjectProperty",
