"""
UCM ⇄ FHIR R{{ adapter.fhir_version.split(".")[0] }} adapter

Generated by ucm-codegen from {{ adapter.ontology_iri }} {{ adapter.ontology_version or "" }}
and the FHIR mapping overlay. DO NOT EDIT - regenerate with: ucm-codegen generate -f fhir

to_fhir_bundle(nodes)   UCM JSON-LD nodes (compacted with the generated context)
                        → FHIR collection Bundle, plus warnings
from_fhir_bundle(b)     Bundle produced by to_fhir_bundle → UCM JSON-LD nodes

Identity: every resource carries its UCM IRI as identifier (system
urn:ietf:rfc:3986; Provenance, which has no identifier in R4, carries it in the
node-iri extension) and its UCM class as meta.tag; fullUrl and id are
UUIDv5 of the IRI, so output is deterministic. Nodes folded into a resource
(e.g., participations in Encounter.participant) carry their IRI in the
node-iri extension. A two-hop path (statementSubject/participatingEntity)
tags its value with the intermediate node's IRI, so the reverse direction
rebuilds both hops; longer paths, via paths and one-way fields are not
reversed. A code several UCM concepts share (Consent.status inactive) keeps
the exact concept in the primitive's extension (_status). Standard library only.
"""

from __future__ import annotations

import copy
import uuid
from typing import Any, Dict, Iterable, List, Optional, Tuple

FHIR_VERSION = {{ adapter.fhir_version | pyrepr }}
CODE_SYSTEM = {{ adapter.code_system | pyrepr }}
NODE_IRI_EXTENSION = {{ adapter.node_iri_extension | pyrepr }}
LINK_EXTENSION = NODE_IRI_EXTENSION + "Link"
URI_SYSTEM = "urn:ietf:rfc:3986"
# R4 resources with no identifier element; their UCM IRI goes in the node-iri extension instead
NO_IDENTIFIER = {{ adapter.no_identifier | pyrepr }}

# Compiled mapping: UCM class term → resource spec
MAPPINGS: Dict[str, Dict[str, Any]] = {{ adapter.resources | pyrepr }}

# Ontology tables: class ancestry, JSON-LD key aliases, @set terms, concepts
ANCESTORS: Dict[str, List[str]] = {{ adapter.ancestors | pyrepr }}
KEYS: Dict[str, List[str]] = {{ adapter["keys"] | pyrepr }}
SETS: Dict[str, bool] = {{ adapter.sets | pyrepr }}
CONCEPTS: Dict[str, str] = {{ adapter.concepts | pyrepr }}
CONCEPT_TERMS: Dict[str, str] = {{ adapter.concept_terms | pyrepr }}
PREFIXES: Dict[str, str] = {{ adapter.prefixes | pyrepr }}


# ============================================================================
# Helpers
# ============================================================================

def full_url(iri: str) -> str:
    return f"urn:uuid:{uuid.uuid5(uuid.NAMESPACE_URL, iri)}"


def resource_id(iri: str) -> str:
    return str(uuid.uuid5(uuid.NAMESPACE_URL, iri))


def concept_system(iri: str) -> str:
    """Coding system for a concept: UCM's own system, or the namespace of a reused vocabulary such as DPV"""
    for namespace in PREFIXES.values():
        if iri.startswith(namespace) and namespace != PREFIXES.get("ucm"):
            return namespace
    return CODE_SYSTEM


def _unwrap(value: Any) -> Any:
    return value["@value"] if isinstance(value, dict) and "@value" in value else value


def _iri(value: Any) -> Optional[str]:
    if isinstance(value, str):
        return value
    if isinstance(value, dict) and isinstance(value.get("@id"), str):
        return value["@id"]
    return None


def _values(node: Dict[str, Any], key: str) -> List[Any]:
    """Values under a term, its compact IRI or its full IRI"""
    for alias in KEYS.get(key, [key]):
        if alias in node:
            value = node[alias]
            return [_unwrap(v) for v in (value if isinstance(value, list) else [value])]
    return []


def _type_terms(value: Any) -> List[str]:
    """Declared @type value(s) as UCM class terms: every example individual is also typed
    owl:NamedIndividual, which compacts to a full IRI alongside the term (never a scalar
    on its own), so full IRIs are filtered out rather than treated as a class term."""
    types = value if isinstance(value, list) else ([value] if value else [])
    return [t for t in types if isinstance(t, str) and "://" not in t]


def _type_term(value: Any) -> Optional[str]:
    """A single representative class term for @type, for contexts (coding, meta.tag) that need one"""
    terms = _type_terms(value)
    return terms[0] if terms else None


def _is_a(term: Any, ancestor: str) -> bool:
    return any(t == ancestor or ancestor in ANCESTORS.get(t, []) for t in _type_terms(term))


def _expand(value: str) -> str:
    if value in CONCEPTS:
        return CONCEPTS[value]
    prefix, _, local = value.partition(":")
    if local and prefix in PREFIXES and not local.startswith("//"):
        return PREFIXES[prefix] + local
    return value


def _set(target: Dict[str, Any], path: str, value: Any) -> None:
    *parents, last = path.split(".")
    for part in parents:
        target = target.setdefault(part, {})
    target[last] = value


def _base(key: str) -> str:
    """FHIR path of an overlay key: 'securityLabel#confidentiality' fills securityLabel"""
    return key.split("#", 1)[0]


def _put(target: Dict[str, Any], key: str, value: Any) -> None:
    """Set a field's output; fields sharing one repeating element append to it"""
    path = _base(key)
    existing = _get(target, path)
    if isinstance(existing, list) and isinstance(value, list):
        existing.extend(v for v in value if v not in existing)
    else:
        _set(target, path, value)


def _ext_path(key: str) -> str:
    """Where a primitive's extension lives: provision.type → provision._type"""
    *parents, last = _base(key).split(".")
    return ".".join(parents + ["_" + last])


def _get(source: Dict[str, Any], path: str) -> Any:
    for part in path.split("."):
        if not isinstance(source, dict):
            return None
        source = source.get(part)
    return source


def _node_iri_extension(element: Any) -> Optional[str]:
    if isinstance(element, dict):
        for ext in element.get("extension", []):
            if ext.get("url") == NODE_IRI_EXTENSION:
                return ext.get("valueUri")
    return None


class _Graph:
    def __init__(self, nodes: Iterable[Dict[str, Any]]):
        self.nodes = {n["@id"]: n for n in nodes if isinstance(n.get("@id"), str)}

    def node(self, item: Any) -> Optional[Dict[str, Any]]:
        if isinstance(item, dict) and set(item) - {"@id"}:
            return item
        iri = _iri(item)
        return self.nodes.get(iri) if iri else None

    def inverse(self, prop: str, iri: str) -> List[Dict[str, Any]]:
        return [n for _, n in sorted(self.nodes.items()) if iri in (_iri(v) for v in _values(n, prop))]

    def mapping_for(self, node: Dict[str, Any]) -> Optional[Dict[str, Any]]:
        for term in _type_terms(node.get("@type")):
            for candidate in [term] + ANCESTORS.get(term, []):
                if candidate in MAPPINGS:
                    return MAPPINGS[candidate]
        return None

    def role_terms(self, participation: Dict[str, Any]) -> List[str]:
        roles = (self.node(r) for r in _values(participation, "assumesRole"))
        return [t for r in roles if r for t in _type_terms(r.get("@type"))]


# ============================================================================
# UCM → FHIR
# ============================================================================

def _items(g: _Graph, node: Any, field: Dict[str, Any]) -> List[Tuple[Optional[Dict[str, Any]], Any]]:
    """(collected node, value) pairs for a field, relative to node"""
    start = g.node(node)
    if field["inverse"]:
        if start is None:
            return []
        bases = [start]
        for hop in field.get("via") or []:
            bases = [n for b in bases for n in (g.node(v) for v in _values(b, hop)) if n is not None]
        collected, seen = [], set()
        for b in bases:
            for n in g.inverse(field["inverse"], b["@id"]):
                if n["@id"] not in seen:
                    seen.add(n["@id"])
                    collected.append(n)
        if field["class"]:
            collected = [n for n in collected if _is_a(n.get("@type"), field["class"])]
        if field["roles"]:
            collected = [n for n in collected
                         if any(_is_a(r, role) for r in g.role_terms(n) for role in field["roles"])]
        if field["exclude_roles"]:
            collected = [n for n in collected
                         if not any(_is_a(r, role) for r in g.role_terms(n) for role in field["exclude_roles"])]
        pairs: List[Tuple[Optional[Dict[str, Any]], Any]] = [(n, n) for n in collected]
    else:
        pairs = [(None, node)]

    two_hop = not field["inverse"] and len(field["property"]) == 2
    for i, hop in enumerate(field["property"]):
        hopped = []
        for origin, value in pairs:
            current = g.node(value)
            if current is not None:
                if two_hop and i == 1:
                    origin = current  # tag the value with the intermediate node
                hopped.extend((origin, v) for v in _values(current, hop))
        pairs = hopped
    return pairs


def _transform(g: _Graph, value: Any, field: Dict[str, Any]) -> Any:
    kind = field["transform"]
    if kind == "reference":
        iri = _iri(value)
        if iri is None:
            return None
        target = g.node(iri)
        if target is not None and g.mapping_for(target) is not None:
            return {"reference": full_url(iri)}
        return {"identifier": {"system": URI_SYSTEM, "value": iri}}
    if kind == "code":
        code = field["map"].get(_expand(str(_iri(value) or value)))
        if code is not None and field.get("system"):
            return {"coding": [{"system": field["system"], "code": code}]}
        return code
    if kind == "iri":
        return _iri(value)
    if kind == "concept-coding":
        iri = _expand(str(_iri(value) or value))
        if field.get("coding"):  # a bare Coding (Consent.provision.purpose, securityLabel)
            if iri in CONCEPT_TERMS:
                return {"system": concept_system(iri), "code": CONCEPT_TERMS[iri]}
            return {"display": iri, "extension": [{"url": NODE_IRI_EXTENSION, "valueUri": iri}]}
        if iri in CONCEPT_TERMS:
            return {"coding": [{"system": concept_system(iri), "code": CONCEPT_TERMS[iri]}]}
        # an adopter's own concept: keep its IRI so the reverse direction recovers it
        return {"text": iri, "extension": [{"url": NODE_IRI_EXTENSION, "valueUri": iri}]}
    if kind == "class-coding":
        target = g.node(value)
        term = _type_term(target.get("@type")) if target else None
        if term is None:
            return None
        return {"coding": [{"system": CODE_SYSTEM, "code": term}]}
    if kind == "role-coding":
        iri = _iri(value)
        role = g.node(iri)
        role_term = _type_term(role.get("@type")) if role else None
        concept: Dict[str, Any] = (
            {"coding": [{"system": CODE_SYSTEM, "code": role_term}]} if role_term is not None
            else {"text": iri}
        )
        concept["extension"] = [{"url": NODE_IRI_EXTENSION, "valueUri": iri}]
        return concept
    if isinstance(value, dict):
        return None  # a node where a value was expected
    return value


def _tag(element: Any, origin: Optional[Dict[str, Any]], marker: Optional[str] = None) -> Any:
    if isinstance(element, dict):
        if origin is not None:
            element.setdefault("extension", []).append({"url": NODE_IRI_EXTENSION, "valueUri": origin["@id"]})
        if marker is not None:  # tells fields that share one FHIR element which of them wrote this value
            element.setdefault("extension", []).append({"url": LINK_EXTENSION, "valueCode": marker})
    return element


def _fill(g: _Graph, node: Any, fields: Dict[str, Any], target: Dict[str, Any], warnings: List[str], where: str) -> None:
    """Write each field of a resource or backbone element into target"""
    for key, field in fields.items():
        value = _field(g, node, field, warnings, f"{where}.{_base(key)}")
        if value is None:
            continue
        _put(target, key, value)
        ext = _code_extension(g, node, field)
        if ext is not None:
            _set(target, _ext_path(key), ext)
    for key, field in fields.items():  # after the loop, so fields sharing an element count together
        if field.get("required") and _get(target, _base(key)) is None:
            warnings.append(f"{where}.{_base(key)}: FHIR R4 requires a value here and UCM has none")


def _code_extension(g: _Graph, node: Any, field: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    """The exact UCM concept behind a code that several concepts share"""
    if field["transform"] != "code" or not field.get("ambiguous") or field.get("system"):
        return None
    for _, value in _items(g, node, field):
        iri = _expand(str(_iri(value) or value))
        if field["map"].get(iri) in field["ambiguous"]:
            return {"extension": [{"url": NODE_IRI_EXTENSION, "valueUri": iri}]}
    return None


def _field(g: _Graph, node: Any, field: Dict[str, Any], warnings: List[str], where: str) -> Any:
    outputs = []
    for origin, value in _items(g, node, field):
        if "each" in field:
            element: Dict[str, Any] = {}
            _fill(g, value, field["each"], element, warnings, where)
            if element:
                for path, constant in (field.get("when") or {}).items():
                    _set(element, path, constant)
                outputs.append(_tag(element, origin if origin is not None else g.node(value)))
            continue
        if field["transform"] == "reference" and field.get("resource_types"):
            target = g.node(value)
            spec = g.mapping_for(target) if target is not None else None
            kind = _resource_type(g, target, spec) if spec is not None else None
            if kind is not None and kind not in field["resource_types"]:
                warnings.append(f"{where}: {_iri(value)} maps to {kind}; FHIR R4 allows only "
                                f"{', '.join(field['resource_types'])} here")
                continue
        result = _transform(g, value, field)
        if result is None:
            if field["transform"] == "code":
                warnings.append(f"{where}: {value!r} has no FHIR code in the mapping")
            continue
        result = _tag(result, origin, field.get("marker"))
        if result not in outputs:
            outputs.append(result)

    if not outputs and field.get("default") is not None:
        outputs = [field["default"]]
    if not outputs:
        return None
    if field["single"] and len(outputs) > 1:
        warnings.append(f"{where}: FHIR allows one value here; kept the first of {len(outputs)}")
    return outputs[0] if field["single"] else outputs


def _resource_type(g: _Graph, node: Dict[str, Any], spec: Dict[str, Any]) -> str:
    participations = g.inverse("participatingEntity", node["@id"])
    for role, resource in spec["by_role"]:
        if any(_is_a(r, role) for p in participations for r in g.role_terms(p)):
            return resource
    return spec["resource"]


def to_fhir_bundle(nodes: Iterable[Dict[str, Any]]) -> Tuple[Dict[str, Any], List[str]]:
    """UCM nodes → FHIR collection Bundle; nodes of unmapped classes inform but are not emitted"""
    g = _Graph(nodes)
    warnings: List[str] = []
    entries = []
    for iri, node in sorted(g.nodes.items()):
        spec = g.mapping_for(node)
        if spec is None:
            continue
        meta: Dict[str, Any] = {"tag": [{"system": CODE_SYSTEM, "code": _type_term(node.get("@type"))}]}
        if spec["profile"]:
            meta["profile"] = [spec["profile"]]
        resource: Dict[str, Any] = {
            "resourceType": _resource_type(g, node, spec),
            "id": resource_id(iri),
            "meta": meta,
        }
        if resource["resourceType"] in NO_IDENTIFIER:  # no Provenance.identifier in R4: the IRI rides in an extension
            resource["extension"] = [{"url": NODE_IRI_EXTENSION, "valueUri": iri}]
        else:
            resource["identifier"] = [{"system": URI_SYSTEM, "value": iri}]
        resource.update(copy.deepcopy(spec["constants"]))
        _fill(g, node, spec["fields"], resource, warnings, f"{iri} {resource['resourceType']}")
        entries.append({"fullUrl": full_url(iri), "resource": resource})
    return {"resourceType": "Bundle", "type": "collection", "entry": entries}, warnings


# ============================================================================
# FHIR → UCM
# ============================================================================

class _Nodes:
    def __init__(self) -> None:
        self.nodes: Dict[str, Dict[str, Any]] = {}

    def get(self, iri: str, type_: Optional[str] = None) -> Dict[str, Any]:
        node = self.nodes.setdefault(iri, {"@id": iri})
        if type_ and "@type" not in node:
            node["@type"] = type_
        return node

    @staticmethod
    def add(node: Dict[str, Any], term: str, value: Any) -> None:
        if SETS.get(term, True):
            values = node.setdefault(term, [])
            if value not in values:
                values.append(value)
        else:
            node[term] = value


def _reverse_value(field: Dict[str, Any], value: Any, urls: Dict[str, str], out: _Nodes,
                   ext: Any = None) -> Any:
    kind = field["transform"]
    if kind == "reference":
        if not isinstance(value, dict):
            return None
        if value.get("reference") in urls:
            return urls[value["reference"]]
        identifier = value.get("identifier") or {}
        return identifier.get("value") if identifier.get("system") == URI_SYSTEM else None
    if kind == "code":
        if field.get("system"):
            codes = [c.get("code") for c in (value.get("coding") or [])
                     if c.get("system") == field["system"]] if isinstance(value, dict) else []
            value = codes[0] if codes else None
        if value in (field.get("ambiguous") or []):
            iri = _node_iri_extension(ext)
            return CONCEPT_TERMS.get(iri) if iri else None
        return field["reverse"].get(value)
    if kind == "iri":
        return value if isinstance(value, str) else None
    if kind == "concept-coding":
        if not isinstance(value, dict):
            return None
        own = field.get("concepts")
        codings = [value] if field.get("coding") else (value.get("coding") or [])
        for coding in codings:
            code = coding.get("code")
            if code in CONCEPTS and coding.get("system") == concept_system(CONCEPTS[code]) and (own is None or code in own):
                return code
        if field.get("shared"):
            return None  # an adopter concept in a shared element: no way to tell whose it is
        return _node_iri_extension(value)
    if kind == "role-coding":
        iri = _node_iri_extension(value)
        codes = [c.get("code") for c in (value.get("coding") or [])] if isinstance(value, dict) else []
        if iri:
            out.get(iri, codes[0] if codes else None)
        return iri
    if kind == "class-coding":
        return None
    return value


def _marker(element: Any) -> Optional[str]:
    if isinstance(element, dict):
        for ext in element.get("extension", []):
            if ext.get("url") == LINK_EXTENSION:
                return ext.get("valueCode")
    return None


def _matches(field: Dict[str, Any], element: Any) -> bool:
    if _marker(element) != field.get("marker"):
        return False
    return all(_get(element, k) == v for k, v in (field.get("when") or {}).items()) \
        if isinstance(element, dict) else not field.get("when")


def _reverse_fields(fields: Dict[str, Any], container: Dict[str, Any], current: Dict[str, Any],
                    urls: Dict[str, str], out: _Nodes) -> None:
    for key, field in fields.items():
        _reverse(field, _get(container, _base(key)), current, urls, out, _get(container, _ext_path(key)))


def _reverse(field: Dict[str, Any], found: Any, current: Dict[str, Any], urls: Dict[str, str], out: _Nodes,
             ext: Any = None) -> None:
    hops = field["property"]
    if found is None or field.get("one_way") or len(hops) > 2 or (len(hops) == 2 and field["inverse"]):
        return  # absent, one-way, or a path too long to rebuild
    prop = hops[0] if hops else None
    for element in found if isinstance(found, list) else [found]:
        if not _matches(field, element):
            continue
        if "each" in field:
            child_iri = _node_iri_extension(element)
            if field["inverse"]:
                if child_iri is None:
                    continue
                child = out.get(child_iri, field["class"])
                out.add(child, field["inverse"], current["@id"])
                _reverse_fields(field["each"], element, child, urls, out)
            elif prop and child_iri is not None and all(
                    sub["property"] or sub["inverse"] for sub in field["each"].values()):
                # the element stands for a node of its own (Consent.provision, provision.actor)
                child = out.get(child_iri, field["class"])
                out.add(current, prop, child_iri)
                _reverse_fields(field["each"], element, child, urls, out)
            elif prop:
                for path, sub in field["each"].items():
                    if not sub["property"] and not sub["inverse"]:
                        value = _reverse_value(sub, _get(element, _base(path)), urls, out)
                        if value is not None:
                            out.add(current, prop, value)
            continue

        value = _reverse_value(field, element, urls, out, ext)
        if value is None:
            continue
        if len(hops) == 2:
            middle = _node_iri_extension(element)
            if middle is not None:
                out.add(current, hops[0], middle)
                out.add(out.get(middle), hops[1], value)
        elif field["inverse"] and prop:
            child_iri = _node_iri_extension(element)
            if child_iri is not None:
                child = out.get(child_iri, field["class"])
                out.add(child, field["inverse"], current["@id"])
                out.add(child, prop, value)
        elif field["inverse"]:
            out.add(out.get(value), field["inverse"], current["@id"])
        elif prop:
            out.add(current, prop, value)


def from_fhir_bundle(bundle: Dict[str, Any]) -> List[Dict[str, Any]]:
    """FHIR Bundle (as produced by to_fhir_bundle) → UCM JSON-LD nodes"""
    urls: Dict[str, str] = {}
    for entry in bundle.get("entry", []):
        for identifier in entry["resource"].get("identifier", []):
            if identifier.get("system") == URI_SYSTEM:
                urls[entry["fullUrl"]] = identifier["value"]
        if entry["resource"].get("resourceType") in NO_IDENTIFIER:
            node_iri = _node_iri_extension(entry["resource"])
            if node_iri:
                urls[entry["fullUrl"]] = node_iri

    out = _Nodes()
    for entry in bundle.get("entry", []):
        resource = entry["resource"]
        iri = urls.get(entry.get("fullUrl", ""))
        tags = [t["code"] for t in resource.get("meta", {}).get("tag", []) if t.get("system") == CODE_SYSTEM]
        if iri is None or not tags:
            continue
        current = out.get(iri, tags[0])
        spec = next((MAPPINGS[c] for c in [tags[0]] + ANCESTORS.get(tags[0], []) if c in MAPPINGS), None)
        if spec is None:
            continue
        _reverse_fields(spec["fields"], resource, current, urls, out)
    return [out.nodes[k] for k in sorted(out.nodes)]
